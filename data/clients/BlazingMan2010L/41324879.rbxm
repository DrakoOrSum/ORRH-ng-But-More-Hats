					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">function waitForChild(instance, name)
	while not instance:FindFirstChild(name) do
		instance.ChildAdded:wait()
	end
end


--local doorOwnerId = game.CreatorId
local doorOwnerId = 9881199 -- 9881199 old one --7465023 new one
local doorOwnerName = &quot;HotThoth&quot;

--local doorOwnerId = 0
--local doorOwnerName = &quot;&quot;

waitForChild(script.Parent.Parent, &quot;PlayerNameTag&quot;)
waitForChild(script.Parent.Parent, &quot;PlayerIdTag&quot;)

doorOwnerId = script.Parent.Parent.PlayerIdTag.Value
doorOwnerName = script.Parent.Parent.PlayerNameTag.Value

local door = script.Parent
top = door.Parent.Head

local doorHalfWidth = 1.9 --2

local firstDoorPosition = door.Position
local targetEdgePoint = door.Position + door.CFrame:vectorToWorldSpace(Vector3.new(0,0,1)).unit*doorHalfWidth
local upVect = door.CFrame:vectorToWorldSpace(Vector3.new(0,1,0))

waitForChild(door, &quot;DoorPositionEnforcer&quot;)

local doorPos = door.DoorPositionEnforcer
doorPos.position = firstDoorPosition
doorPos.Parent = door

waitForChild(door, &quot;DoorUprightEnforcer&quot;)

local doorGyro = door.DoorUprightEnforcer
local closed = door.CFrame
doorGyro.cframe = closed

local isOpen = false

local doorAnimTime = 1
local doorOpenTime = 1
local doorSpeed = 1.5


-- change name and picture to match doorOwnerId&apos;s name and image
local model = door.Parent
model.Name = doorOwnerName

waitForChild(model, &quot;DoorSign1&quot;)
waitForChild(model.DoorSign1, &quot;Decal&quot;)

local pic = model.DoorSign1.Decal
pic.Texture = &quot;http://www.roblox.com/thumbs/avatar.ashx?userId=&quot;.. doorOwnerId ..&quot;&amp;x=352&amp;y=352&quot;

waitForChild(model, &quot;DoorSign2&quot;)
waitForChild(model.DoorSign2, &quot;Decal&quot;)

local otherSide = model.DoorSign2.Decal
otherSide.Texture = &quot;http://www.roblox.com/thumbs/avatar.ashx?userId=&quot;.. doorOwnerId ..&quot;&amp;x=352&amp;y=352&quot;


function doorOpen()
	top.BrickColor = BrickColor.new(&quot;Camo&quot;)
end

function doorClose()
end

function accessGranted(part)
	if part == nil then return false end
	pChar = part.Parent
	if pChar == nil then return false end
	pPlay = game.Players:GetPlayerFromCharacter(pChar)
	if pPlay == nil then return false end
	-- insert friend code here...  currently, door will open at a humanoid&apos;s touch
	if (pPlay:IsFriendsWith(doorOwnerId)) then return true end
	--	else return false end
	return false
end

function checkHit(part)
	--targetEdgePoint = Vector3.new(firstDoorPosition.X, firstDoorPosition.Y, firstDoorPosition.Z-2)
	print(door.CFrame:vectorToWorldSpace(Vector3.new(0,0,1)))
	if (accessGranted(part)) then
		if not isOpen then
			isOpen = true
			door.Anchored = false
			--doorGyro.maxTorque = Vector3.new(400000, 0, 400000)
			doorOpen()
			for i = 1, 20 do
			-- wait(doorAnimTime)
				--doorPos.position = Vector3.new(firstDoorPosition.X+i/10, firstDoorPosition.Y, firstDoorPosition.Z-i/10)
				vec = i*math.pi/40 * upVect
				doorGyro.cframe = closed*CFrame.Angles(vec.X, vec.Y, vec.Z)
				--doorGyro.cframe = closed*CFrame.Angles(0,i*math.pi/40,0)
				doorPos.position = targetEdgePoint - door.CFrame:vectorToWorldSpace(Vector3.new(0,0,1)).unit*doorHalfWidth
				wait(.1)
			end
			wait(doorOpenTime)
			doorClose()
			for i = 1, 20 do
			-- wait(doorAnimTime)
				--doorPos.position = Vector3.new(firstDoorPosition.X+2-i/10, firstDoorPosition.Y, firstDoorPosition.Z-2+i/10)
				--doorGyro.cframe = closed*CFrame.Angles(0,(20-i)*math.pi/40,0)
				vec = (20-i)*math.pi/40 * upVect
				doorGyro.cframe = closed*CFrame.Angles(vec.X, vec.Y, vec.Z)
				doorPos.position = targetEdgePoint - door.CFrame:vectorToWorldSpace(Vector3.new(0,0,1)).unit*doorHalfWidth
				wait(.1)
			end
			--doorGyro.cframe = closed
			--doorPos.position = firstDoorPosition
			--wait(.1)
			top.BrickColor = BrickColor.new(&quot;Bright red&quot;)
			--doorGyro.maxTorque = Vector3.new(400000, 400000, 400000)
			--wait(doorAnimTime)
			door.Anchored = true
			isOpen = false
		end
	end
end


door.Touched:connect(checkHit)
</ProtectedString>
