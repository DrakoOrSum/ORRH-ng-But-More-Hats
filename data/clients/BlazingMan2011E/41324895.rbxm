			<Item class="Script" referent="RBX3">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Force Script</string>
					<ProtectedString name="Source">function waitForChild(instance, name)
	while not instance:FindFirstChild(name) do
		instance.ChildAdded:wait()
	end
end

local model = script.Parent.Parent
local wedge = script.Parent
waitForChild(model, &quot;Corner&quot;)
waitForChild(model, &quot;Top&quot;)
local top = model.Top

-- NOTES:
-- This script anchors the wedge during ~3 seconds it applies force, and then unanchors itself.
-- This is because I can&apos;t figure out how to get it to work without anchoring it.
-- If you can figure out how to get it to work without being anchored, go for it!

function onTouched(hit)
	-- Off:  http://www.roblox.com/asset?id=40101352
	-- On: http://www.roblox.com/asset?id=40101378
	if wedge.Anchored or wedge.Velocity.magnitude &gt; .2 then return end
	wedge.Anchored = true
	top.Anchored = true
	top.RotVelocity = Vector3.new(0,0,0)
	wedge.RotVelocity = Vector3.new(0,0,0)
	setVelocity()
	wedge.Decal.Texture = &quot;http://www.roblox.com/asset?id=40101378&quot;
	wait(2)
	wedge.Decal.Texture = &quot;http://www.roblox.com/asset?id=40101352&quot;
	top.Velocity = Vector3.new(0,0,0)
	wedge.Velocity = Vector3.new(0,0,0)
	top.RotVelocity = Vector3.new(0,0,0)
	wedge.RotVelocity = Vector3.new(0,0,0)
	wedge.Anchored = false
	top.Anchored = false
end

function setVelocity()
	local v = model.Corner.CFrame.lookVector*5 + Vector3.new(0,5,0)
	wedge.Velocity = v
	top.Velocity = v
end

wedge.Touched:connect(onTouched)
</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
