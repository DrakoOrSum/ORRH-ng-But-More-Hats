				<string name="Name">Force Script</string>
				<ProtectedString name="Source">-- Preload all textures
game:GetService(&quot;ContentProvider&quot;):Preload(&quot;http://www.roblox.com/asset?id=40101378&quot;)
game:GetService(&quot;ContentProvider&quot;):Preload(&quot;http://www.roblox.com/asset?id=40101352&quot;)

function setVelocity()
	script.Parent.Velocity = script.Parent.CFrame.lookVector *10
end

--[[ CODE FOR CONTINUOUS &quot;PUSHING&quot;...  NOT FUNCTIONING
local restartTimer = false

function onTouched(hit)
	--if script.Parent.Velocity.Y &lt; -.2 then return end -- not if it&apos;s falling
	if script.Parent.Velocity.magnitude &gt; .1 then return end -- not if it&apos;s moving!

	if script.Parent.Anchored then -- just reset countdown (only if it&apos;s reaching end of time)
		restartTimer = true
	else
		restartTimer = true
		startConveyor()
		while restartTimer do
			restartTimer = false
			wait(1)
		end
		stopConveyor()
	end
end
]]--

function onTouched(hit)
	if script.Parent.Anchored or script.Parent.Velocity.magnitude &gt; .2 then return end -- not if it&apos;s moving!
	startConveyor()
	wait(1)
	stopConveyor()
end

function startConveyor()
	-- Off:  http://www.roblox.com/asset?id=40101352
	-- On: http://www.roblox.com/asset?id=40101378
	script.Parent.RotVelocity = Vector3.new(0,0,0)
	script.Parent.Anchored = true
	script.Parent.Decal.Texture = &quot;http://www.roblox.com/asset?id=40101378&quot;
	setVelocity()
end

function stopConveyor()
	script.Parent.Decal.Texture = &quot;http://www.roblox.com/asset?id=40101352&quot;
	script.Parent.Velocity = Vector3.new(0,0,0)
	script.Parent.RotVelocity = Vector3.new(0,0,0)
	script.Parent.Anchored = false
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
	</Item>
</roblox>