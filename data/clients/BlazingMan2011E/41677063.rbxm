		<Item class="Script" referent="RBX2">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">PadScript</string>
				<ProtectedString name="Source">function waitForChild(instance, name)
	while not instance:FindFirstChild(name) do
		instance.ChildAdded:wait()
	end
end

local pad = script.Parent
waitForChild(pad, &quot;Base&quot;)
waitForChild(pad, &quot;FakeBase&quot;)
waitForChild(pad, &quot;AnimatePad&quot;)
waitForChild(pad, &quot;FloatScript&quot;)
waitForChild(pad, &quot;Configuration&quot;)
waitForChild(pad.Configuration, &quot;Height&quot;)
waitForChild(pad.Configuration, &quot;Duration&quot;)
local base = pad.Base
local base2 = pad.FakeBase
local animatePad = pad.AnimatePad
local height = pad.Configuration.Height
local duration = pad.Configuration.Duration

function touchHandler(part)
	if(part.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil) then
		-- If part is the arm or leg of a humanoid, then move everything to the torso.
		-- This is so we can&apos;t double up forces on a humanoid (scripts inside each leg, arm, etc)
		waitForChild(part.Parent, &quot;Torso&quot;)
		part = part.Parent.Torso
	end

	-- If there&apos;s already a FloatScript inside this part, then do nothing.
	if(part:FindFirstChild(&quot;FloatScript&quot;) ~= nil) then return end

	-- If Y velocity is too big (it&apos;s bouncing) then do nothing
	if(math.abs(part.Velocity.y) &gt; 10) then return end

	print(&quot;touchHandler:&quot;, part.Name)
	-- Copy FloatScript to part
	local floatScript = pad.FloatScript:Clone()
	waitForChild(floatScript, &quot;Duration&quot;)
	waitForChild(floatScript, &quot;Height&quot;)
	floatScript.Height.Value = height.Value
	floatScript.Duration.Value = duration.Value
	floatScript.Name = &quot;FloatScript&quot;
	floatScript.Parent = part
	floatScript.Disabled = false

	-- Animate the pad
	animatePad.Disabled = true
	animatePad.Disabled = false
end

print(&quot;PadScript: Adding event.&quot;)
base.Touched:connect(touchHandler)
base2.Touched:connect(touchHandler)</ProtectedString>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
