		<Item class="Script" referent="RBX17">
			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">AnimatePad</string>
				<ProtectedString name="Source">function waitForChild(instance, name)
	while not instance:FindFirstChild(name) do
		instance.ChildAdded:wait()
	end
end

-- Animate stuff
waitForChild(script.Parent, &quot;Base&quot;)
local base = script.Parent.Base
waitForChild(base, &quot;Fire&quot;)
waitForChild(base, &quot;Smoke&quot;)

local onColor = BrickColor.new(1,1,1)
local offColor = BrickColor.new(.2,.2,.2)
base.BrickColor = onColor

base.Fire.Enabled = true
base.Smoke.Enabled = true
wait(0.5)
base.Fire.Enabled = false
wait(0.5)
base.Smoke.Enabled = false
base.BrickColor = offColor</ProtectedString>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX18">
			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">FloatScript</string>
				<ProtectedString name="Source">function waitForChild(instance, name)
	while not instance:FindFirstChild(name) do
		instance.ChildAdded:wait()
	end
end

waitForChild(script, &quot;Height&quot;)
waitForChild(script, &quot;Duration&quot;)
waitForChild(script, &quot;FloatPad_BodyForce&quot;)
waitForChild(script, &quot;FloatPad_BodyPosition&quot;)

local height = script.Height.Value
local duration = script.Duration.Value
local bodyForce = script.FloatPad_BodyForce
local bodyPosition = script.FloatPad_BodyPosition

local part = script.Parent
local isHumanoid = false

if(part.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil) then
	isHumanoid = true
end

local mass = 0

print(&quot;About to assign mass. isHumanoid:&quot;, isHumanoid)

if isHumanoid then
	local parts = part.Parent:GetChildren()
	for i=1,#parts do
		if(parts[i]:IsA(&quot;Part&quot;)) then
			mass = mass + parts[i]:GetMass()
--			parts[i].Velocity = Vector3.new(parts[i].Velocity.x, 0, parts[i].Velocity.z)
		elseif(parts[i]:IsA(&quot;Hat&quot;)) then
			mass = mass + parts[i].Handle:GetMass()
--			parts[i].Handle.Velocity = Vector3.new(parts[i].Handle.Velocity.x, 0, parts[i].Handle.Velocity.z)
		end
	end
elseif(part:IsA(&quot;Part&quot;)) then
	mass = part:GetMass()
--	part.Velocity = Vector3.new(part.Velocity.x, 0, part.Velocity.z)
else
	print(&quot;Doesn&apos;t work for non-humanoid models yet.&quot;)
	script.Disabled = true
end

print(&quot;mass:&quot;, mass, &quot;, force:&quot;, mass*196.2)

bodyForce.force = Vector3.new(0, mass*196.2, 0)
bodyPosition.position = Vector3.new(0, part.Position.y+height, 0)
bodyForce.Parent = part
bodyPosition.Parent = part

--[[
-- Lame attempt at preventing bouncing.
if(part:IsA(&quot;Part&quot;)) then
	wait(0.2)
	part.Velocity = Vector3.new(part.Velocity.x, 0, part.Velocity.z)
	print(&quot;Set Y velocity to zero.  New velocity:&quot;, part.Velocity)
end
--]]

wait(duration)

-- Remove everything
bodyForce:Remove()
bodyPosition:Remove()

script:Remove()

--[[
-- Original weightless script

local mass = part:GetMass()

local force = Instance.new(&quot;BodyForce&quot;)
force.Name = &quot;WeightlessForce&quot;
force.force = Vector3.new(0, mass*196.2, 0)
force.Parent = part

local mass = part:GetMass()
--]]
</ProtectedString>
