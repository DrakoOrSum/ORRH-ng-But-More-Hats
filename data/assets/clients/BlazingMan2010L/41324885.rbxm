		<Item class="Script" referent="RBX6">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<ProtectedString name="Source">-- need to add a bodyPosition to prevent xz plane movement!!!

local maxTimer = 20 -- make this a configuration folder parameter?
local offColor = &quot;Earth green&quot;
local onColor  = &quot;Lime green&quot;

local switchBottom = script.Parent.SwitchBottom
local switchTop = script.Parent.SwitchTop
local platform = script.Parent.Platform
--local position_up = Vector3.new(platform.Position.x, switchTop.Position.y, platform.Position.z)
--local position_down = Vector3.new(platform.Position.x, switchBottom.Position.y, platform.Position.z)
local topHeight = switchTop.Position.Y
local bottomHeight = switchBottom.Position.Y

goingUp = false

local weight = script.Parent.invisiweight
weight.CFrame = platform.CFrame
local weightWeld = script.Parent.weightWeld
weightWeld.Part0 = platform
weightWeld.Part1 = weight
weightWeld.C1 = platform.CFrame:inverse()*weight.CFrame


--[[ switch script effects to platform
script.AngleStabilizer.Parent = platform
--script.PositionStabilizer.position = Vector3.new(-132, platform.Position.y, -567)
script.PositionStabilizer.position = Vector3.new(platform.Position.X, platform.Position.y, platform.Position.Z)
script.PositionStabilizer.Parent = platform
script.Force.Parent = platform
local posStabilizer = platform.PositionStabilizer
]]--

-- now we switch those effects to the weight instead
script.AngleStabilizer.cframe = platform.CFrame
script.AngleStabilizer.Parent = weight
script.PositionStabilizer.position = Vector3.new(platform.Position.X, platform.Position.Y, platform.Position.Z)
script.PositionStabilizer.Parent = weight
script.Force.Parent = weight
local posStabilizer = weight.PositionStabilizer

local miniListenerEnabled = true
function switchTopListener(part)
		if part ~= nil and part.Parent == script.Parent then return end
		if miniListenerEnabled then
		miniListenerEnabled = false
		--platform.PositionStabilizer.maxForce = Vector3.new(400000, 0, 400000)
		posStabilizer.maxForce = Vector3.new(400000, 0, 400000)
	-- called when we touch the top switch.
	--platform.Force.position = position_up
	if (platform.Position.Y &lt; topHeight) then
		platform.Anchored = false
		--platform.Force.velocity = Vector3.new(0, 2, 0)
		weight.Force.velocity = Vector3.new(0, 2, 0)

		switchTop.BrickColor = BrickColor.new(onColor)
		switchBottom.BrickColor = BrickColor.new(offColor)
		--print(&quot;switchTop. force: &quot; .. platform.Force.velocity.y)
		--print(&quot;maxForce: &quot; .. platform.Force.maxForce.x)
		goingUp = true
		script.Timer.Value = maxTimer -- if we don&apos;t reach destination in maxTimer seconds, &quot;safety mode&quot; turns on and elevator direction reverses
	end
	miniListenerEnabled = true
	end
end

function switchBottomListener(part)
		if part ~= nil and part.Parent == script.Parent then return end
		if miniListenerEnabled then
		miniListenerEnabled = false
		--platform.PositionStabilizer.maxForce = Vector3.new(400000, 0, 400000)
		posStabilizer.maxForce = Vector3.new(400000, 0, 400000)
	-- called when we touch the bottom switch.
	--platform.Force.position = position_down
	if (platform.Position.Y &gt; bottomHeight) then
		platform.Anchored = false
		--platform.Force.velocity = Vector3.new(0,-2, 0)
		weight.Force.velocity = Vector3.new(0,-2,0)
		switchBottom.BrickColor = BrickColor.new(onColor)
		switchTop.BrickColor = BrickColor.new(offColor)
		--print(&quot;switchBottom. force: &quot; .. platform.Force.velocity.y)
		--print(&quot;maxForce: &quot; .. platform.Force.maxForce.x)
		goingUp = false
		script.Timer.Value = maxTimer -- if we don&apos;t reach destination in maxTimer seconds, &quot;safety mode&quot; turns on and elevator direction reverses
	end
	miniListenerEnabled = true
	end
end

local numTimes = 0
local listenerEnabled = true
function platformListener(part)
	-- when you walk onto the platform, and it&apos;s stopped at either top or bottom, trigger it after a short delay.
	print(&quot;platformListener&quot;)
	if part == nil then return end
	if part.Parent == nil then return end
	if platform.Anchored and part.Parent ~= script.Parent and listenerEnabled then
		listenerEnabled = false	
		print(numTimes)
		numTimes = numTimes+1
		print(part)
		wait(1.5)
		if goingUp then
			switchBottomListener(part)
		else
			switchTopListener(part)
		end
		listenerEnabled = true
	end

	--[[if(platform.Position == position_up) then  -- if goingUp
		print(&quot;platformListener: down&quot;)
		switchBottomListener(part)
	elseif(platform.Position == position_down) then  -- just else
		print(&quot;platformListener: up&quot;)
		switchTopListener(part)
	end]]--
end

--switchBottomListener(platform) -- on init, go to bottom.
--platform.Force.maxForce = Vector3.new(1e+100,1e+100,1e+100)
-- platform.Force.P = 1e+10
switchBottom.Touched:connect(switchBottomListener)
switchTop.Touched:connect(switchTopListener)
platform.Touched:connect(platformListener)

while true do
	if not platform.Anchored then
		if goingUp then
			if platform.Position.Y &gt; topHeight then
				--platform.Force.velocity = Vector3.new(0,0,0)
				--platform.Velocity = Vector3.new(0,0,0)
				weight.Force.velocity = Vector3.new(0,0,0)
				weight.Velocity = Vector3.new(0,0,0)
				platform.CFrame = platform.CFrame + Vector3.new(0, topHeight - platform.Position.Y, 0)
				platform.Anchored = true
				script.Timer.Value = maxTimer
			else
				--platform.Force.velocity = Vector3.new(0,2,0)
				if script.Timer.Value &lt;= 0 then
					switchBottomListener(nil)
				else weight.Force.velocity = Vector3.new(0,2,0) end
			end
		else
			if platform.Position.Y &lt; bottomHeight then
				--platform.Force.velocity = Vector3.new(0,0,0)
				--platform.Velocity = Vector3.new(0,0,0)
				weight.Force.velocity = Vector3.new(0,0,0)
				weight.Velocity = Vector3.new(0,0,0)
				platform.CFrame = platform.CFrame + Vector3.new(0, bottomHeight - platform.Position.Y, 0)
				platform.Anchored = true
				script.Timer.Value = maxTimer
			else
				--platform.Force.velocity = Vector3.new(0,-2,0)
				if script.Timer.Value &lt;= 0 then
					switchTopListener(nil)
				else weight.Force.velocity = Vector3.new(0,-2,0) end
			end
		end
		script.Timer.Value = script.Timer.Value - .1
	end

	wait(.1)
end


</ProtectedString>
