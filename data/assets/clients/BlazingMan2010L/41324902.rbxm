				<Item class="Script" referent="RBX3">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local firePart = script.Parent.Parent

function getLargestSide(size)

	if size then
		local largest = size.x
		if size.y &gt; largest then largest = size.y end
		if size.z &gt; largest then largest = size.z end
		return largest
	else
		return Vector3.new(0,0,0)
	end

end

local coolDown = true
local coolDownTime = 2.5
wait(coolDownTime)
coolDown = false

firePart.Touched:connect(function(part)
	if part == nil then return end
	if part.Parent == nil then return end
	print(part.Material)
	if coolDown then return end

	if part.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
		local otherFire = part:FindFirstChild(&quot;Fire&quot;,true)
		if otherFire and otherFire:IsA(&quot;Fire&quot;) then return end

		part.Parent:FindFirstChild(&quot;Humanoid&quot;):TakeDamage(25)
	else
		if tostring(part.Material) ~= &quot;Enum.Material.Wood&quot; then return end

		local otherFire = part:FindFirstChild(&quot;Fire&quot;,true)
		if otherFire and otherFire:IsA(&quot;Fire&quot;) then return end
	end

	coolDown = true

		local size = getLargestSide(part.Size)
		local fire = firePart.Fire:clone()
		fire.Size = size * 2
		fire.Parent = part
		wait(coolDownTime)

	coolDown = false


end)

-- slowly decrement fire size on new objects (Except our original fire)
local dontKillFire = true
firePart.Fire.Heat = 0
if firePart.Name ~= &quot;z#4fzo0&quot; then
	while dontKillFire do
		wait(4)
		if(firePart:FindFirstChild(&quot;Fire&quot;)) then
			--firePart.Fire.Heat = firePart.Fire.Heat + 1
			firePart.Fire.Size = firePart.Fire.Size - 2
			if(firePart.Fire.Size &lt;= 4) then firePart.Fire.Enabled = false wait(1) if tostring(firePart.Material) == &quot;Enum.Material.Wood&quot; then firePart.Material = &quot;Concrete&quot; firePart.BrickColor = BrickColor.new(&quot;Black&quot;) end wait(.5) dontKillFire = false firePart.Fire.Parent = nil end
		end
	end
end
</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
