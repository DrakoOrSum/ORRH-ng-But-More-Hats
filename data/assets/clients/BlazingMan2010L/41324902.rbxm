			<Item class="Fire" referent="RBX2">
				<Properties>
					<Color3 name="Color">4294940979</Color3>
					<bool name="Enabled">true</bool>
					<string name="Name">Fire</string>
					<Color3 name="SecondaryColor">4288217088</Color3>
