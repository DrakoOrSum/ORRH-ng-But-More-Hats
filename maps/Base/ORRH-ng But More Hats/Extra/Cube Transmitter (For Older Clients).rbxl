					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">function generateRandomNumber()
	return math.random(0,9)
end

function generateRandomName()

	local newName = &quot;&quot;

	for i = 1,8 do
		newName = newName .. generateRandomNumber()
	end

	return newName
end

local object = script.Parent

while true do

	object.Name = generateRandomName()

	wait(0.1)

end</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
			<Item class="Script" referent="RBX124">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">local model = script.Parent

math.randomseed(tick())

while 1 do

	local children = model:GetChildren()

	for i = 1, table.getn(children) do

		local part = children[i]

		if part.className == &quot;Part&quot; then

			part.BrickColor = BrickColor.Random()

			part.TopSurface = math.random(0,4)
			part.BottomSurface = math.random(0,4)
			part.LeftSurface = math.random(0,4)
			part.RightSurface = math.random(0,4)
			part.FrontSurface = math.random(0,4)
			part.BackSurface = math.random(0,4)

		end

	end

	wait(0.5)

end</string>
