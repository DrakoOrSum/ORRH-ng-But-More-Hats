						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function generateRandomNumber()
	return math.random(0,9)
end

function generateRandomName()

	local newName = &quot;&quot;

	for i = 1,8 do
		newName = newName .. generateRandomNumber()
	end

	return newName
end

local object = script.Parent

while true do

	object.Name = generateRandomName()

	wait(0.1)

end</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
			<Item class="Script" referent="RBX124">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">local model = script.Parent

local surfaces = {
	0, -- Smooth
	1, -- Glue
	2, -- Weld
	3, -- Studs
	4, -- Inlet
	5, -- Universal
	6, -- Hinge
	7, -- Motor
	8, -- SteppingMotor
}

function randomSurface()
	return surfaces[math.random(1, #surfaces)]
end

function randomColor()
	return BrickColor.Random()
end

while true do

	local children = model:GetChildren()

	for i = 1, #children do
		local part = children[i]

		if part.className == &quot;Part&quot; or part.Name == &quot;Head&quot; or part.Name == &quot;head&quot; then

			part.BrickColor = randomColor()

			part.TopSurface = randomSurface()
			part.BottomSurface = randomSurface()
			part.LeftSurface = randomSurface()
			part.RightSurface = randomSurface()
			part.FrontSurface = randomSurface()
			part.BackSurface = randomSurface()

		end
	end

	wait(0.5)

end</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
