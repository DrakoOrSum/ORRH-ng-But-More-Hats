							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Head Script</string>
							<ProtectedString name="Source">local part = script.Parent

local surfaces = {
	0,
	1,
	2,
	3,
	4,
	5,
	6,
	7,
	8
}

function randomSurface()
	return surfaces[math.random(1,#surfaces)]
end

while true do

	part.BrickColor = BrickColor.Random()

	part.TopSurface = randomSurface()
	part.BottomSurface = randomSurface()
	part.LeftSurface = randomSurface()
	part.RightSurface = randomSurface()
	part.FrontSurface = randomSurface()
	part.BackSurface = randomSurface()

	wait(0.1)

end</ProtectedString>
