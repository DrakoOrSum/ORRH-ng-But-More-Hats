							<string name="Name">SpinScript</string>
							<ProtectedString name="Source">while true do
	wait()

	script.Parent.CFrame =
		script.Parent.CFrame *
		CFrame.Angles(
			math.rad(20),
			math.rad(20),
			math.rad(20)
		)
end</ProtectedString>
