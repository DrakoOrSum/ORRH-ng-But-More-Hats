					<string name="Name">LocalScript</string>
					<ProtectedString name="Source">sp=script.Parent

theface = &quot;http://www.roblox.com/asset/?id=10000000046&quot;
health = 80
textureclosed = &quot;http://www.roblox.com/asset/?id=10000000045&quot;
textureopen = &quot;http://www.roblox.com/asset/?id=10000000045&quot;

local function smoke()
&#9;local player = sp.Parent
&#9;if not player:FindFirstChild(&quot;Head&quot;) then
&#9;return
&#9;end
&#9;local particle = Instance.new(&quot;Smoke&quot;, game.Workspace)
&#9;particle.Enabled = true
&#9;particle.Parent = player.Head
&#9;particle.RiseVelocity = 0.50
&#9;particle.Opacity = 0.3
&#9;wait(2)
&#9;particle.Enabled = false
&#9;wait(4.5)
&#9;particle:Destroy()
end

storedface=&quot;&quot;
local debris=game:GetService(&quot;Debris&quot;)
check=true

sp.Equipped:connect(function(mouse)
&#9;equipped=true
&#9;if mouse~=nil then 
&#9;&#9;mouse.Icon=&quot;rbxasset://textures\\GunCursor.png&quot;
&#9;&#9;mouse.Button1Down:connect(function()
&#9;&#9;&#9;local chr=sp.Parent
&#9;&#9;&#9;if chr and check then
&#9;&#9;&#9;&#9;local t=chr:FindFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;&#9;local h=chr:FindFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;&#9;local anim=sp:FindFirstChild(&quot;Eat&quot;)
&#9;&#9;&#9;&#9;local s=sp.Handle:FindFirstChild(&quot;Sound&quot;)
&#9;&#9;&#9;&#9;if anim and t and h and h.Health&gt;0 and equipped and check then
