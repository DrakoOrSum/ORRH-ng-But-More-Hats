							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Roomba Script</string>
							<ProtectedString name="Source">-- It&apos;s gotten to the point where I&apos;ve forgotten about how this script functions.
-- It&apos;s pretty jank, since I scripted this in an actual server.
-- I don&apos;t know if that&apos;s an excuse.
-- Please be warned.

local model = script.Parent.Parent
local roomba = script.Parent
local TrashCollection = roomba.TrashCollection
local yAxis = roomba.Position.Y

local dialogue = {
	&quot;no littering!!&quot;, &quot;no loitering!!&quot;, &quot;clean up after yourselves...&quot;, &quot;pick it up or die!!!&quot;, &quot;my magic will destroy your trash!!!&quot;, &quot;i hate trash&quot;
}

local toast = { &quot;TOAST!!!!&quot;, &quot;omg toast&quot;, &quot;GRHAHRHRHAHR TOAST&gt;&gt;&gt;&quot;, &quot;Toast is special. It is not trash.&quot;, &quot;I need to eat toast to be a health and big boy!&quot;}

local ate = {
	&quot;yum :)&quot;, &quot;destroyed!&quot;, &quot;your trashing days are RUINED.&quot;, &quot;trashed the trash!&quot;, &quot;a cleaner world...&quot;
}

_G.Roomba = script.Parent

local radius = 75
local timer = 5
local homeland = 2
local chasing = false
local returning = false 

local function xAndz(pos)
	return Vector3.new(pos.x, yAxis, pos.z)
end 

local function removepos(cf)
	return (cf:inverse() * CFrame.new(cf.x, cf.y, cf.z)):inverse()
end 

function chase(obj, condition, isCF)
	if not obj then return end 
	if (isCF and obj or obj.Position).y -1.5 &gt; roomba.Position.y then return end 
	while (chasing and not returning) do wait() end 
	if not isCF then returning = false end
	chasing = true

	if not isCF then model.Name = (obj.Name == &quot;ClonedToast&quot;) and toast[math.random(1, #toast)] or dialogue[math.random(1, #dialogue)] end 
	
	local passed = true
	while ((isCF and obj or obj.Parent) and condition()) and roomba.Parent and (xAndz(roomba.Position) - xAndz((isCF and obj or obj.Position))).magnitude &gt; homeland do
		passed = pcall(function() -- prevent error
			local face = CFrame.new(xAndz(roomba.Position), xAndz(isCF and obj or obj.Position))
			roomba.CFrame = CFrame.new(roomba.Position + (roomba.CFrame.lookVector/script.Parent.Speed.Value)) * removepos(face) 
			script.Parent.Vacuum:Play()
		end)

		wait()
		if not passed or (isCF and obj or obj.Position).y -1.5 &gt; roomba.Position.y then break end 
	end 

	print(isCF, isCF and obj or obj.Parent, condition(), roomba.Parent, (xAndz(roomba.Position) - xAndz((isCF and obj or obj.Position))).magnitude &gt; homeland)
	chasing = false
	if not passed then return end 
	if (isCF and obj or obj.Position).y -1.5 &gt; roomba.Position.y then return end
	if (roomba.Position - (isCF and obj or obj.Position)).magnitude &gt; radius then return end
	if (xAndz(roomba.Position) - xAndz((isCF and obj or obj.Position))).magnitude &gt; homeland then return end 
	return true 
end 

function comebackroomba()
	if chasing then return end 
	if (roomba.Origin.Value.p - roomba.Position).magnitude &lt; homeland then return end 
	model.Name = &quot;going home...&quot; --print(&quot;roomba wants to go home&quot;)
	returning = true
	chase(roomba.Origin.Value.p, function() return returning end, true)
	if not returning then return end 
	returning = false
	roomba.CFrame = roomba.Origin.Value
	model.Name = &quot;home :-)&quot;
	delay(3, function()
		if model.Name ~= &quot;home :-)&quot; then return end 
		model.Name = &quot;&quot;
	end)
end 

function eat(obj)
	TrashCollection.Value = TrashCollection.Value + 1
	model.Name = obj.Name == &quot;ClonedToast&quot; and toast[math.random(1, #toast)] or ate[math.random(1, #ate)]
	script.Parent.Eat:Play()
	obj:Remove()
	--delay(5, comebackroomba)
	--comebackroomba()
end 

function detect()
	local trigger = true
	for _, obj in pairs(workspace:GetChildren()) do
		local handle = (obj.Name == &quot;ClonedToast&quot;) and obj or obj:FindFirstChild(&quot;Handle&quot;)
		if handle and (handle.Position - roomba.Position).magnitude &lt;= radius then 
			trigger = false
			--print(&quot;roomba found something&quot;)
			--delay(0, function()
			if chase(handle, function() return obj.Parent == workspace end) then 
				eat(handle)
			end
			--end)
		end 
	end

	delay(timer, function()
		comebackroomba()
	end)
end 

if (Vector3.new(roomba.Origin.Value) - roomba.Position).magnitude &gt; 3 then 
	roomba.CFrame = roomba.Origin.Value
end

while roomba:FindFirstChild(&quot;ClickDetector&quot;) do roomba.ClickDetector:Remove() end 
local cd = Instance.new(&quot;ClickDetector&quot;)
cd.archivable = false 
cd.Parent = roomba

while roomba.Parent:FindFirstChild(&quot;Roomba&quot;) do roomba.Parent.Roomba:Remove() end 
local hm = Instance.new(&quot;Humanoid&quot;)
hm.Name = &quot;Roomba&quot;
hm.Health, hm.MaxHealth = 0,0
hm.archivable = false 
hm.Parent = roomba.Parent

cd.MouseClick:connect(comebackroomba)
model.Name = &quot;&quot;
script.Parent.Mesh.Scale = Vector3.new(1,1,1)

--script.Parent.Touched:connect(function(obj) if game.Players:GetPlayerFromCharacter(obj.Parent) then obj:BreakJoints() end end)

script.Parent.Speed.Value = 4
while wait(5) do
	detect()
end </ProtectedString>
