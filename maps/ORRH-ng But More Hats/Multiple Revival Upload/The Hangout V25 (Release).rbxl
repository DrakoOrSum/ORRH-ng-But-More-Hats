				<Item class="Script" referent="RBX2831">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">MainScript</string>
						<ProtectedString name="Source">local pos = script.Parent.Corner.Position
local lookmag = 1
local posmag = 5

local victims = {}
local pranceTimer = 0.5
local prancesTilDeath = 8*2 -- [seconds]*2
local devil = nil

local torture = script.Parent.Torture
local deboune = 10

local function getplayer()
	for _, p in pairs(game.Players:GetPlayers()) do
		if p.Character and p.Character:FindFirstChild(&quot;Head&quot;) then 
			local head = p.Character.Head
			local lookMagnitude = (head.CFrame.lookVector - CFrame.new(head.Position, pos).lookVector).magnitude
			local posMagnitude = (head.Position - pos).magnitude
			if lookMagnitude &lt; lookmag and posMagnitude &lt; posmag then 
				return p
			end 
		end
	end
	--(workspace[&apos;tobu.fi&apos;].Head.CFrame.lookVector - CFrame.new(workspace[&apos;tobu.fi&apos;].Head.Position, workspace.Handle.Position).lookVector).magnitude
end 

local function CheckForVictim(player)
	if devil then return end 
	if not player then return end 
	victims[player.Name]=victims[player.Name] or {Player=player, Count=0}
	print(&quot;Come&quot;)
	for name, v in pairs(victims) do 
		if v.Player == player then 
			print(player, v.Count)
			victims[name].Count = victims[name].Count + 1
			if v.Count &gt;= prancesTilDeath then 
				devil = v.Player
			end 
		elseif not v.Leaving then 
			victims[name].Leaving=true
		elseif v.Leaving then 
			victims[name].Cured=true
		end 

		if devil or victims[name].Cured then 
			victims[name] = nil
		end 
	end 

	if not devil then return end 
	return true 
end 

while wait(pranceTimer) do 
	local player = getplayer()
	local hasdevil = CheckForVictim(player)
	if hasdevil then 
		local new = torture:Clone()
		new.Parent = player.PlayerGui
		repeat wait() until new.Parent == nil or player.Parent == nil or game.Players:FindFirstChild(player.Name) == nil or player.Character == nil 
		devil = nil 
		if new.Parent then new:Remove() end 
		wait(debounce)
	end 
end </ProtectedString>
						<bool name="archivable">true</bool>
