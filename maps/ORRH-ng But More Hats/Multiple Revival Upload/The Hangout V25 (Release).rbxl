			<Item class="LocalScript" referent="RBX6070">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">PlaySound</string>
					<ProtectedString name="Source">local Fencing = nil
while not Fencing do
	Fencing = workspace:FindFirstChild(&quot;Fencing&quot;)
	wait(1/30)
end 

local SoundArea = nil
while not SoundArea do 
	SoundArea = Fencing:FindFirstChild(&quot;SoundAreaForSF&quot;) 
	wait(1/30)
end 

local camera = workspace.CurrentCamera
local debris = game:GetService(&quot;Debris&quot;)

SoundArea.ChildAdded:connect(function(obj)
	if not obj.className == &quot;StringValue&quot; then return end 

	local new = Instance.new(&quot;Sound&quot;)
	new.SoundId = &quot;rbxasset://sounds/&quot; .. obj.Name .. &quot;.wav&quot;
	new.Volume = tonumber(obj.Value) or 1

	local np = Instance.new(&quot;Part&quot;)
	np.Name = &quot;SoundPlay: &quot; .. obj.Name
	np.Size = Vector3.new(1,1,1)
	np.Anchored = true 
	np.CanCollide = false
	np.Transparency = 1

	repeat wait() until obj:FindFirstChild(&quot;PlayCFrame&quot;) -- because server is slower than play solo
	np.CFrame = obj.PlayCFrame.Value

	new.Parent = np
	np.Parent = camera
	new:Play()

	debris:AddItem(np, 4)
end) </ProtectedString>
