						<string name="Name">GearBox Script</string>
						<ProtectedString name="Source">while not game.Lighting:FindFirstChild(&quot;Gears&quot;) do wait() end 
local gears = game.Lighting.Gears
local tick, victory = script.Parent.Tick, script.Parent.Victory

local selecting = false
local cycles = 20

local function CreatePart()
	local part = Instance.new(&quot;Part&quot;)
	part.Size = Vector3.new(4,4,1)
	part.CFrame = script.Parent.CFrame * CFrame.new(0,4,0)
	part.Anchored = true 
	part.Locked = true 
	part.Transparency = 1
	part.CanCollide = false 
	local dc = Instance.new(&quot;Decal&quot;, part)
	part.Parent = script.Parent
	return part
end 

for _,v in pairs(gears:GetChildren()) do
	local d= Instance.new(&quot;Decal&quot;)
	d.archivable = false
	d.Texture = v.TextureId
	d.Name = v.Name
	d.Parent = script.Parent
end 

script.Parent.Touched:connect(function(obj)
	local player = game.Players:GetPlayerFromCharacter(obj.Parent)
	if not player then return end 
	if obj.Parent.Humanoid.Health &lt;= 0 then return end 
	if not player:FindFirstChild(&quot;StarterGear&quot;) then Instance.new(&quot;StarterGear&quot;, player) end 
	if (#player.StarterGear:GetChildren() &gt; 0) then return end 
	if selecting then return end 

	selecting = true 
	script.Parent.GearsGiven.Value = script.Parent.GearsGiven.Value + 1

	local new = player.StarterGear--Instance.new(&quot;StarterGear&quot;, player)
	local display = CreatePart()
	local random = nil
	local last = nil
	local i = 1
	while true do 
		random = gears:GetChildren()[math.random(1, #gears:GetChildren())]
		if random ~= last then 
			last = random
			display.Decal.Texture = script.Parent[random.Name].Texture
			tick:Play()
			wait(i/(cycles*2))
			i = i + 1
			if i == cycles then break end 
		end
	end 

	victory:Play()
	local sparkles = Instance.new(&quot;Sparkles&quot;, display)
	random:Clone().Parent = new
	wait()
	random:Clone().Parent = player.Backpack

	wait(4)
	display:Remove()
	selecting = false
end)

game.Players.PlayerAdded:connect(function(player)
	player.CharacterAdded:connect(function(character)
		character.Humanoid.Died:wait()
		if player:FindFirstChild(&quot;StarterGear&quot;) then player.StarterGear:Remove() end
	end)
end)</ProtectedString>
