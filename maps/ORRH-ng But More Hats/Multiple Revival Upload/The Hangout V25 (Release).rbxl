		<Item class="Script" referent="RBX5138">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Commands</string>
				<ProtectedString name="Source">local function chat(plr, text)
	local text = string.lower(text)
	if text == &quot;reset&quot; or text == &quot;/reset&quot; or text == &quot;;ec&quot; then plr.Character:BreakJoints() return end
	if text == &quot;/removetools&quot; then 
		for _,v in pairs(plr.Backpack:GetChildren()) do v:Remove() end 
		return
	end
	if text == &quot;/tele&quot; or text == &quot;tele&quot; then 
		plr.Character:MoveTo(workspace.Spawns:GetChildren()[math.random(1, 3)].Position)
		return
	end 
	--[[if text == &quot;/specialmesh&quot; then 
		local msh = Instance.new(&quot;SpecialMesh&quot;)
		local msg = Instance.new(&quot;Message&quot;)
		local h = Instance.new(&quot;Hint&quot;)
		h.Text = &quot;Torso, Wedge, Prism, Pyramid, ParallelRamp, RightAngleRamp, Brick, Sphere, Cylinder&quot;
		h.Parent = plr
		msg.Text = &quot;What type?&quot;
		msg.Parent = plr
		local response = plr.Chatted:wait()
		h:Remove()
		msh.MeshType = response
		msg.Text = &quot;X val?&quot;
		local x = tonumber(plr.Chatted:wait())
		msg.Text = &quot;y val?&quot;
		local y = tonumber(plr.Chatted:wait())
		msg.Text = &quot;z val?&quot;
		local z = tonumber(plr.Chatted:wait())
		msh.Scale = Vector3.new(x,y,z)
		msg.Text = &quot;form: block(1), plate(2), or sym(3)?&quot;
		local p = Instance.new(&quot;Part&quot;)
		msh.Parent = p
		local f = tonumber(plr.Chatted:wait())
		p.formFactor = (f==1) and &quot;Block&quot; or (f==2 and &quot;Plate&quot; or &quot;Symmetric&quot;)
		p.Anchored = true
		p.Position = plr.Character.Head.Position
		p.Parent = workspace
		msg.Text = &quot;given!&quot;
		game:GetService(&quot;Debris&quot;):AddItem(msg, 3)
	end ]]
end 

game.Players.PlayerAdded:connect(function(plr) plr.Chatted:connect(function(text) chat(plr, text) end) end)

for _,p in pairs(game.Players:GetPlayers()) do
	print(&quot;APPLY&quot;)
	p.Chatted:connect(function(text) chat(p, text) end)
end </ProtectedString>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
	</Item>
