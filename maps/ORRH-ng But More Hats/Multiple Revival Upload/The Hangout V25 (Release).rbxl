				</Item>
				<Item class="HopperBin" referent="RBX6056">
					<Properties>
						<bool name="Active">false</bool>
						<token name="BinType">0</token>
						<string name="Name">VResizer</string>
						<Content name="TextureId"><null></null></Content>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="Script" referent="RBX6057">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">OLD</string>
							<ProtectedString name="Source">local input = {
b=Vector3.new(-1,0,0),
g=Vector3.new(1,0,0),
n=Vector3.new(0,-1.2,0),
h=Vector3.new(0,1.2,0),
m=Vector3.new(0,0,-1),
j=Vector3.new(0,0,1)
}

local phantom = nil
local original = nil
local flip=2

local function pass(desire)
	if desire.x&lt;1 or desire.y&lt;1.2 or desire.z&lt;1 then return end 
	return true
end 

local function createPhantom(t)
	if (phantom) then phantom:Remove() end 
	phantom=t:Clone()
	original=t
	phantom.CanCollide = false
	phantom.Anchored = true
	phantom.Transparency = 0.5
	Instance.new(&quot;ForceField&quot;).Parent = phantom
	phantom.Parent = script.Parent.Parent.Parent.Character
	return phantom
end 

script.Parent.Selected:connect(function(m)
	m.KeyDown:connect(function(k)
		if k == &quot;f&quot; then flip=flip*-1 return end 

		if not input[k] then return end 
		local target = m.Target
		if (not target) or (target.Locked) then return end 
		if (not phantom) or (target ~= original) then createPhantom(target) end

		local state = phantom.CFrame
		local desire = phantom.Size + input[k]
		if not pass(desire) then return end 
		phantom.Size = desire
		phantom.CFrame = state * CFrame.new(input[k]/flip)
	end)

	m.Button1Down:connect(function()
		if not (original and phantom) then return end 
		if not (original.Parent and phantom.Parent) then 
			original=nil
			phantom=nil
			return
		end 

		local size, cf = phantom.Size, phantom.CFrame
		phantom:Remove()
		phantom=nil
		original.Size, original.CFrame = size, cf
		original=nil
	end)
end)

script.Parent.Deselected:connect(function()
	if original then original=nil end 
	if phantom then
		phantom:Remove()
		phantom=nil
	end 
end)</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX6058">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">VResizer Script</string>
							<ProtectedString name="Source">local input = {
default=Vector3.new(0,0,0),
--b=Vector3.new(-1,0,0),
g=Vector3.new(1,0,0),
--n=Vector3.new(0,-1.2,0),
h=Vector3.new(0,1.2,0),
--m=Vector3.new(0,0,-1),
j=Vector3.new(0,0,1)
}

local tilt = {
t={p=Vector3.new(1,0,0), on=false},
y={p=Vector3.new(0,1,0), on=false},
u={p=Vector3.new(0,0,1), on=false}
}

--September 5th, 2024
-- TODO:
-- Plate(replace y axis with 0.4) + Symmetrical Support(remove 1.2 for y axis)
-- Move Cooldown fix

local player = script.Parent.Parent.Parent
local phantom = nil
local original = nil
local flip=1
local sign=1
local flag = {}
local box = Instance.new(&quot;Message&quot;)
local instructions = Instance.new(&quot;Hint&quot;)
instructions.Text = &quot;VResizer: GHJ resizes XYZ | TYU tilts XYZ | F switch resize dir | K switch resize add/sub&quot;

local function pass(desire)
	if desire.x&lt;1 or desire.y&lt;1.2 or desire.z&lt;1 then return end 
	return true
end 

local function createPhantom(t)
	if (phantom) then phantom:Remove() end 
	phantom=t:Clone()
	original=t
	phantom.CanCollide = false
	phantom.Anchored = true
	phantom.Transparency = 0.5

	Instance.new(&quot;ForceField&quot;).Parent = phantom
	local tag = Instance.new(&quot;IntValue&quot;)
	tag.Name = &quot;Phantom&quot;
	tag.Parent = phantom

	phantom.Parent = original --workspace.CurrentCamera --script.Parent.Parent.Parent.Character
	return phantom
end 

local function boxtext()
	box.Text = string.format(&quot;%s | %s direction&quot;, sign==-1 and &quot;subtracting&quot; or &quot;adding&quot;, flip==-1 and &quot;neg&quot; or &quot;pos&quot;)
end 

local function tilting(k)
	phantom.CFrame = phantom.CFrame * CFrame.new(tilt[k].p*phantom.Size*(tilt[k].on and -1 or 1)*flip)
	tilt[k].on=not tilt[k].on
end 

local function resize(k, target)
	if not k then return end 
	if (target==nil or target.Locked) then return end 
	if target:FindFirstChild(&quot;Phantom&quot;) and target ~= phantom then return end
	if not phantom then createPhantom(target) end

	local state = phantom.CFrame
	local direction = input[k]*sign
	local desire = phantom.Size + direction
	if not pass(desire) then return end 
	phantom.Size = desire
	phantom.CFrame = state * CFrame.new(direction/(2*flip))
	boxtext()
end 

script.Parent.Selected:connect(function(m)
	instructions.Parent = player
	box.Parent = player
	box.Text = &quot;Highlight a brick!&quot;

	m.KeyDown:connect(function(k)
		if k == &quot;f&quot; then flip=flip*-1 boxtext() return end 
		if k == &quot;k&quot; then sign=sign*-1 boxtext() return end 
		if phantom and tilt[k] then tilting(k) return end 

		if not input[k] then return end 
		local target = m.Target
		resize(k, target)
	end)

	m.Button1Down:connect(function()
		if not (original and phantom) then return end 
		if (not m.Target) or (original.Parent == nil or phantom.Parent ==nil) then 
			original=nil
			if phantom.Parent then phantom:Remove() end
			phantom=nil
			return
		end 
		if not (m.Target == original or m.Target == phantom) then return end  

		local size, cf = phantom.Size, phantom.CFrame
		phantom:Remove()
		phantom=nil
		original.Size = size 
		original.CFrame = cf
		original=nil
	end)

	-- This happens too fast, regardless of the cooldown!
	m.Move:connect(function()
		if phantom or original then return end 
		if (not m.Target) or (m.Target.Locked) then return end 
		flag={p=m.Hit.p, t=m.Target}
		wait(2)
		if flag.p ~= m.Hit.p or flag.t ~= m.Target then return end print(&quot;flag passed&quot;)
		flag={}
		resize(&quot;default&quot;, m.Target)
	end)
end)

script.Parent.Deselected:connect(function()
	box.Text = &quot;&quot;
	box.Parent = nil
	instructions.Parent = nil

	if original then original=nil end 
	if phantom then
		phantom:Remove()
		phantom=nil
	end 
end)</ProtectedString>
