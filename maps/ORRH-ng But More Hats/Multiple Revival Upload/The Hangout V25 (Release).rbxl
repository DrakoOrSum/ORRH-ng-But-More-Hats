							<X>3.10000086</X>
							<Y>3.10000086</Y>
							<Z>3.10000086</Z>
						</Vector3>
						<Content name="TextureId"><url>http://www.roblox.com/asset/?id=16432575</url></Content>
						<Vector3 name="VertexColor">
							<X>1</X>
