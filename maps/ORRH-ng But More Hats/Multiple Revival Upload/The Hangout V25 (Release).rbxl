							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">custom</string>
							<ProtectedString name="Source">-- custom

local string = &quot;CFraming...&quot;
function Display(x) -- nil = clear, true = string
	local location = script.Parent.Parent -- player instance into character instance
	local model = nil
	for _,v in pairs(location:GetChildren()) do
		if v:IsA(&quot;Model&quot;) then
			model = v
			break
		end
	end 

	if not model then return end
	model.Name = x and string or (model.Name == string and &quot;&quot; or model.Name)
end 

-- end of custom

script.Parent.Equipped:connect(function() 
	Display(true)
end)

script.Parent.Unequipped:connect(function()
	Display()
end)
</ProtectedString>
