								<ProtectedString name="Source">if script.Parent.Parent.className ==&quot;Tool&quot; then script:Remove() return end 
while script.Parent:FindFirstChild(&quot;ClickDetector&quot;) do script.Parent.ClickDetector:Remove() end 

local cd = Instance.new(&quot;ClickDetector&quot;)
cd.archivable = false 
cd.Parent = script.Parent

local pos = script.Parent.Position
local lookmag = 1
local posmag = 5

local function getplayer()
	for _, p in pairs(game.Players:GetPlayers()) do
		if p.Character and p.Character:FindFirstChild(&quot;Head&quot;) then 
			local head = p.Character.Head
			local lookMagnitude = (head.CFrame.lookVector - CFrame.new(head.Position, pos).lookVector).magnitude
			local posMagnitude = (head.Position - pos).magnitude
			if lookMagnitude &lt; lookmag and posMagnitude &lt; posmag then 
				return p
			end 
		end
	end
	--(workspace[&apos;tobu.fi&apos;].Head.CFrame.lookVector - CFrame.new(workspace[&apos;tobu.fi&apos;].Head.Position, workspace.Handle.Position).lookVector).magnitude
end 

local touched = false
local db = 20
--local cheeses = {}

script.Parent.Transparency = 0

cd.MouseClick:connect(function()
	local plr = getplayer()
	if not plr then return end
	if plr.Character == nil or plr.Character:FindFirstChild(&quot;Humanoid&quot;) == nil or plr.Character.Humanoid.Health &lt;= 0 then return end 
	if touched then return end 
	touched = true 

	script.Parent.Transparency = 1
	local chr = plr.Character
	local msg = Instance.new(&quot;Message&quot;, plr)
	msg.Text = &quot;YOU HAVE THE CHEESE TOUCH!!!!&quot;
	game:GetService(&quot;Debris&quot;):AddItem(msg, 10)

	local mdl = Instance.new(&quot;Model&quot;)
	local hm = Instance.new(&quot;Humanoid&quot;)
	hm.Health = 0
	hm.MaxHealth = 0
	hm.Parent = mdl

	local fk = chr.Head:Clone()
	local wd = Instance.new(&quot;Weld&quot;)
	wd.Part0 = chr.Head
	wd.Part1 = fk

	wd.Parent = fk
	fk.Parent = mdl 

	mdl.Name = &quot;!!! CHEESE TOUCH MONSTER DO NOT TOUCH !!!&quot;
	mdl.Parent = chr
	chr.Head.Transparency = 1

	for _, v in pairs(chr:GetChildren()) do 
		local new = script.Parent.CheeseMesh:Clone()
		--table.insert(cheeses, new)
		new.Parent = v
	end 
	
	local snd = script.Parent.Alarm:Clone()
	snd.Parent = chr.Torso
	for i = 1, 10 do 
		if chr.Parent == nil or chr.Humanoid.Health &lt;= 0 then break end
		chr.Humanoid:TakeDamage(11)
		snd:Play()
		wait(1)
	end 

	if chr.Parent then chr:BreakJoints() end 

	wait(db)
	touched = false 
	script.Parent.Transparency = 0
	--cheeses = {}
end) </ProtectedString>
