				<Item class="Script" referent="RBX3691">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Dust Script</string>
						<ProtectedString name="Source">local parts = {}
for _,v in pairs(script.Parent:GetChildren()) do
	if v.className == &quot;Part&quot; then table.insert(parts, v) v.Transparency = 1 end
end 

local mdl = script.Parent

if mdl:FindFirstChild(&quot;Humanoid&quot;) then mdl.Humanoid:Remove() end 
local hm = Instance.new(&quot;Humanoid&quot;)
hm.Health, hm.MaxHealth = 0,0
hm.Parent = mdl
hm.archivable = false 

for _, p in pairs(parts) do p.Transparency = 1 p.CanCollide = false p.Locked = true end 
while true do
	mdl.Name = &quot;Dust me!&quot;
	for _, p in pairs(parts) do p.Transparency = 0.5 end
	local cd = Instance.new(&quot;ClickDetector&quot;)
	cd.archivable = false
	cd.Parent = mdl.Head
	cd.MouseClick:wait()
	cd:Remove()
	mdl.Name = &quot;Thank you...&quot;
	script.Parent.Dusted.Value = script.Parent.Dusted.Value + 1
	for i = 51, 100 do 
		for _, p in pairs(parts) do p.Transparency = i/100 end 
		wait()
	end 
	wait(math.random(60,240))
end</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
