									<bool name="Disabled">true</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">BoomboxGUIScript</string>
									<ProtectedString name="Source">local songs = {
	1015394,
	1034065,
	1077604,
	1280414,
	1280463,
	1280470,
	1280473,
	1372257,
	1372259,
	1372261,
	1372262,
	2027611,
	2303479,
	4761522,
	5982975,
	5985787,
	5986151,
	8223170,
	9650822,
	1142092,
	1142093,
	2769726,
	2769739
}

local Names = {
	[&quot;1015394&quot;] = &quot;Soft Knees - Winds Of Fjords&quot;,
	[&quot;1034065&quot;] = &quot;Martin O&apos;Donnell - Halo Theme (Mjolnir Mix)&quot;,
	[&quot;1077604&quot;] = &quot;8 Bit Weapon - M.U.L.E. (Bitblaster Mix)&quot;,
	[&quot;1280414&quot;] = &quot;Super Smash Bros. Melee - Final Destination&quot;,
	[&quot;1280463&quot;] = &quot;Chrono Trigger - Main Theme&quot;,
	[&quot;1280470&quot;] = &quot;Super Mario 64 - Bob-Omb Battlefield&quot;,
	[&quot;1280473&quot;] = &quot;Final Fantasy VII - The People Fight&quot;,
	[&quot;1372257&quot;] = &quot;Ragnarok Online - Monastery in Disguise&quot;,
	[&quot;1372259&quot;] = &quot;Super Smash Bros. Melee - Fire Emblem&quot;,
	[&quot;1372261&quot;] = &quot;Battle Theme From Pokemon&quot;,
	[&quot;1372262&quot;] = &quot;Super Smash Bros. Melee - Venom&quot;,
	[&quot;2027611&quot;] = &quot;Rick Astley - Never Gonna Give You Up&quot;,
	[&quot;2303479&quot;] = &quot;Caramella Girls - Caramelldansen&quot;,
	[&quot;4761522&quot;] = &quot;Pasi Sivula - Demonhunter (Age of the Legends)&quot;,
	[&quot;5982975&quot;] = &quot;V&#225;monos Baillar - La Gueta La Runa&quot;,
	[&quot;5985787&quot;] = &quot;Chrono Symphonic - Schala and the Queen&quot;,
	[&quot;5986151&quot;] = &quot;No, Really - Rust&quot;,
	[&quot;8223170&quot;] = &quot;Chain Reaction - Forte Escape&quot;,
	[&quot;9650822&quot;] = &quot;S4 League - Come On (Tunnel)&quot;,
	[&quot;11420922&quot;] = &quot;Shadow of the Colossus - Demise of the Ritual&quot;,
	[&quot;11420933&quot;] = &quot;Shadow of the Colossus - The Opened Way&quot;,
	[&quot;27697267&quot;] = &quot;Scott Joplin - The Entertainer&quot;,
	[&quot;27697392&quot;] = &quot;Alice Deejay - Better Off Alone (Glejs Remix)&quot;
}

local boombox = script.Parent.Boombox.Value--workspace:FindFirstChild(&quot;Boombox&quot;)
local songframe = script.Parent.SongFrame:Clone()
local tabs = {script.Parent.SongFrame}
local currentpage = 0
local limit = math.floor((#songs/8))

for i = 1, 10 do
	local tab = tabs[1]
	if i ~= 1 then
		tab = songframe:Clone()
		table.insert(tabs, tab)
		tab.Position = songframe.Position + UDim2.new(0, 0, 0, 25*(i-1))
		tab.Parent = script.Parent
	end
		
	-- communicate
	tab.Song.MouseButton1Click:connect(function()
		boombox.ID.Value = tab.ID.Value
		boombox.Playing.Value = true
		refresh(currentpage)
	end) 
end 

-- #ToolButtons * (currentPage-1)
function refresh(page)
	script.Parent.Page.Text = &quot;NEXT PAGE (&quot; .. page+1 .. &quot;/&quot; .. limit .. &quot;)&quot;
	local difference = (#tabs * page)
	for i, tab in pairs(tabs) do
		local song = songs[difference+i]
		tab.Song.Text = Names[tostring(song)] or &quot;N/A&quot;
		tab.ID.Value = song or 0
		tab.State.Text = (song) and ((boombox.ID.Value == song) and &quot;&lt;-- NOW PLAYING&quot; or &quot;&quot;) or &quot;&quot;
	end 
end 

script.Parent.STOP.MouseButton1Click:connect(function() boombox.ID.Value = 0 boombox.Playing.Value = false refresh(currentpage) end)
script.Parent.Page.MouseButton1Click:connect(function() currentpage = currentpage + 1 if currentpage &gt;= limit then currentpage = 0 end refresh(currentpage) end)
script.Parent.EXIT.MouseButton1Click:connect(function() script.Parent.Parent:Remove() end)

refresh(currentpage)</ProtectedString>
