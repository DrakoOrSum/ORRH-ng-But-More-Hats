						<Item class="Script" referent="RBX468">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">while script.Parent:FindFirstChild(&quot;ClickDetector&quot;) do script.Parent.ClickDetector:Remove() end 
local cd = Instance.new(&quot;ClickDetector&quot;)
cd.archivable = false 
cd.Parent = script.Parent
cd.MouseClick:connect(function()
	script.Parent.Parent.Head.BrickColor = BrickColor.new(&quot;Bright blue&quot;)
	script.Parent.Splat:Play()
end)</ProtectedString>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
						<Item class="Sound" referent="RBX469">
							<Properties>
								<bool name="Looped">false</bool>
								<string name="Name">Splat</string>
								<float name="Pitch">1</float>
								<int name="PlayCount">57</int>
								<bool name="PlayOnRemove">false</bool>
								<Content name="SoundId"><url>rbxasset://sounds/splat.wav</url></Content>
								<float name="Volume">0.25</float>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
					</Item>
					<Item class="Script" referent="RBX470">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">ToiletScript</string>
							<ProtectedString name="Source">local occupied = false
local GUI = script.ToiletGui
local given = nil

script.Parent.Seat.ChildAdded:connect(function(obj)
	if obj.Name ~= &quot;SeatWeld&quot; then return end 
	local torso = obj.Part1
	if not torso then return end 
	local player = game.Players:GetPlayerFromCharacter(torso.Parent)
	if not player then return end 
	if occupied then return end 
	script.Parent.Flushed.Value = script.Parent.Flushed.Value + 1
	occupied = true 
	local new = GUI:Clone()
	new.Main.Toilet.Value = script.Parent
	new.Main.ToiletGuiScript.Disabled = false
	new.Parent = player.PlayerGui
	repeat
		wait()
	until new.Parent == nil or player.Parent == nil or obj.Parent == nil 
	if new.Parent then new:Remove() new = nil end 
	occupied = false 
end)</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
