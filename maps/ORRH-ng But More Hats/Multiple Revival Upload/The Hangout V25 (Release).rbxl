						<string name="Name">ToolScript</string>
						<ProtectedString name="Source">-- TODO: For some reason starts on page 2 instead of page 1.

local function WaitForChild(where, what)
	while not where:FindFirstChild(what) do
		wait()
	end 
	return where:FindFirstChild(what)
end 

local Bin = script.Parent
local Backpack = Bin.Parent
local Player = Backpack.Parent

local GUI = WaitForChild(Bin, &quot;GUI&quot;)
local Frame = GUI.Frame
local NextButton = Frame.Next
local PageDisplay = Frame.PageDisplay

local debounce = false
local currentPage = 1
local currentTool = nil
local buttonEvents = {}
local pageEvent = nil
local TOTALPAGES = nil

local allowed = {Zork=true,tobuFI=true,fed=true,heree=true,worker=true, Matt=true}

local Tools = {} 
for _, tool in pairs(Bin:GetChildren()) do
    if tool:IsA(&quot;Tool&quot;) or tool:IsA(&quot;HopperBin&quot;) then 
        if tool:FindFirstChild(&quot;AdminTool&quot;) then 
		if not allowed[Player.Name] then tool:Remove() end
        end

	if tool.Parent ~= nil then
            table.insert(Tools, tool)
        end 
    end 
end 

local ToolButtons = {}
for _,v in pairs(Frame:GetChildren()) do 
	local number = tonumber(v.Name)
	if number then ToolButtons[number] = v end 
end 

local function InsertTool(toolName)
	while Player:FindFirstChild(&quot;InBetweenModel&quot;) do Player.InBetweenModel:Remove() end 
	local mdl = Instance.new(&quot;Model&quot;)
	mdl.Name = &quot;InBetweenModel&quot;
	mdl.Parent = Player
	if not Bin:FindFirstChild(toolName) then return end 
	if currentTool then currentTool:Remove() end 
	currentTool = Bin[toolName]:Clone()
	currentTool.Parent = mdl
	wait(.1337)
	if mdl.Parent == nil then return end 
	mdl:GetChildren()[1].Parent = Backpack
	mdl:Remove()
end 

local function PageRefresh(page)
	currentPage = (currentPage &gt;= TOTALPAGES) and 1 or currentPage+1
	currentPage = page or currentPage
	PageDisplay.Text = string.format(&quot;PAGE %d/%d&quot;, currentPage, TOTALPAGES)

	local difference = (#ToolButtons * (currentPage-1))
	for i, button in pairs(ToolButtons) do
		local tool = Tools[i+difference]
		button.Text = tool and tool.Name or &quot;N/A&quot;
	end 
end 

local function onSelected()
	GUI.Parent = Player.PlayerGui
end

local function onDeselect()
	--[[if pageEvent then
		pageEvent:disconnect()
		pageEvent = nil
	end

	for i = 1, #buttonEvents do
		if buttonEvents[i] then
			buttonEvents[i]:disconnect()
			buttonEvents[i] = nil
		end 
	end ]]

	GUI.Parent = Bin
end 

-- this is weird but it works so lol
local compute = (#Tools/#ToolButtons)
local output = compute - math.floor(compute)
TOTALPAGES = math.floor(compute+1) --(output &gt;= .5) and (math.floor(compute)+1) or math.floor(compute)
PageRefresh(1)

pageEvent = NextButton.MouseButton1Click:connect(PageRefresh) 
for i, button in pairs(ToolButtons) do
	buttonEvents[i] = button.MouseButton1Down:connect(function()	
		local toolName = button.Text
		InsertTool(toolName)
	end)
end 

Bin.Selected:connect(onSelected)
Bin.Deselected:connect(onDeselect)
</ProtectedString>
