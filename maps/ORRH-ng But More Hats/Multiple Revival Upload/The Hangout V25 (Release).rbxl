local current = UDim2.new(0,-40,0,0)
for i = 1, #str do 
	local v = string.upper(string.sub(str, i, i))
	local new = Instance.new(&quot;ImageLabel&quot;) 
	new.Name = v
	new.Size = UDim2.new(0,40,0,40)
	new.Image = l:FindFirstChild(v) and l[v].Decal.Texture or &quot;&quot;
	new.Position = current + UDim2.new(0, 40,0,0)
	current=new.Position
	new.Parent = f
end </ProtectedString>
