					</Properties>
					<Item class="LocalScript" referent="RBX6033">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Hopperbin Stuff</string>
							<ProtectedString name="Source">local player = game:GetService(&quot;Players&quot;).LocalPlayer
local hopperbin = script.Parent
local isCooldown = false -- Flag to track if cooldown is active

function onButton1Down(mouse)
    if isCooldown then
        return -- Do nothing if cooldown is active
    end
    
    local statueScript = hopperbin.StatueScript
    -- Execute the code contained within the StatueScript
    -- Note: You might need to adjust this depending on the content of StatueScript
	 statueScript.Disabled = false
	isCooldown = true -- Set cooldown flag to true
	wait(8)
	statueScript.Disabled = true
	isCooldown = false -- Reset cooldown flag
end

function onSelected(mouse)
	mouse.Button1Down:connect(onButton1Down)
end

hopperbin.Selected:connect(onSelected)

-- Reset cooldown flag when the HopperBin is selected again
hopperbin.Deselected:connect(function()
    isCooldown = false
end)
</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="LocalScript" referent="RBX6034">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">StatueScript</string>
							<ProtectedString name="Source">--[[
	This only saves the local character. Lol, lmao.
	Original code by tobu.fi. Very very minorly edited by heree to make it only save the local player.
]] 

local Debris = game:GetService(&quot;Debris&quot;)
local Lighting = game:GetService(&quot;Lighting&quot;)
local Players = game:GetService(&quot;Players&quot;)
local CULLING_LIST = {BodyColors = true, Part = true, BasePart = true, Shirt = true, Pants = true, ShirtGraphic = true, CharacterMesh = true}

local LPlayer = game:GetService(&quot;Players&quot;).LocalPlayer
local LCharacter = LPlayer.Character

local SCRIPT_NAME = &quot;Attempted Self-Character Save by &quot; .. LPlayer.Name .. &quot; | &quot;
local COUNTDOWN_STRING = &quot;Saving character in %d...&quot;
local COOLDOWN_STRING = &quot;Loading character in %d...&quot;
local SAVED_STRING = &quot;Saved the character!&quot;
local LOADED_STRING = &quot;Loaded the character!&quot;

local DEFAULT_TICKING_SOUND = &quot;rbxasset://sounds/bass.wav&quot;
local SUCCESS_SOUND = &quot;rbxasset://sounds/victory.wav&quot;

local COUNTDOWN_SECONDS = 3
local COOLDOWN_SECONDS = 3

local COUNTDOWN_ENABLED = true 
local COOLDOWN_ENABLED = false

local ANNOUNCEMENTS_ENABLED = true 
local SOUNDS_ENABLED = false

local SAVE_IN_WORKSPACE = true -- if not workspace, then Lighting
local KILL_PLAYERS_WHEN_SAVED = false

local function PlaySound(asset, volume)
	if not (asset or SOUND_ENABLED) then return end 
	local sound = Instance.new(&quot;Sound&quot;)
	sound.Name = asset
	sound.Volume = volume or .25
	sound.SoundId = asset 
	sound.Parent = LPlayer:FindFirstChild(&quot;Head&quot;) or LPlayer
	sound:Play()
	Debris:AddItem(sound, 1)
end 

local function RemoveSound(object)
	for _, thing in pairs(object:GetChildren()) do
		if thing.className == &quot;Sound&quot; then 
			thing:Stop()
			thing:Remove()
		end 
	end 
end 

local function Announce(text, duration)
	if not ((text and duration) or ANNOUNCEMENTS_ENABLED) then return end 
	local msg = Instance.new(&quot;Message&quot;)
	msg.Text = text 
	msg.Parent = LPlayer.PlayerGui
	Debris:AddItem(msg, duration)
end 

local function IsAPart(obj)
	return obj.className == &quot;Part&quot; or obj.className == &quot;BasePart&quot;
end 

local function GetBody(character)
	if (not character) or (character.Parent == nil) then return end 
	
	local selection = {Name = character.Name}
	for _, v in pairs(character:GetChildren()) do
		if CULLING_LIST[v.className] then 
			selection[v.Name] = v:Clone()
		elseif v:FindFirstChild(&quot;Handle&quot;) then 
			local new = v:FindFirstChild(&quot;Handle&quot;) and v.Handle:Clone()
			new.Name = v.Name
			selection[v.Name] = new
		end
	end 
	
	return selection
end 

local function Reconstruct(save)
	local model = Instance.new(&quot;Model&quot;)
	model.Name = save.Name 
	save.Name = nil 
	
	local humanoid = Instance.new(&quot;Humanoid&quot;)
	humanoid.Health, humanoid.MaxHealth = 0, 0
	humanoid.Parent = model
	
	for name, object in pairs(save) do
		if IsAPart(object) then 
			object.Anchored = true 
			local cframeInstance = Instance.new(&quot;CFrameValue&quot;)
			cframeInstance.Name = &quot;CFrameValue&quot;
			cframeInstance.Value = object.CFrame
			cframeInstance.Parent = object
		end 
		
		RemoveSound(object)
		object.Parent = model 
	end 
	
	return model
end 

local function SavePlayers()
local saveState = {}
	if LCharacter then 
		local body = GetBody(LCharacter)
		table.insert(saveState, Reconstruct(body))
	end 
	
	return saveState
end 

local function Operation(execution, enabledBool, secondsBool, announceString, successString)
	if (not enabledBool) or (secondsBool &lt;= 0) then return execution() end 
	
	for i = secondsBool, 1, -1 do
		PlaySound(DEFAULT_TICKING_SOUND)
		print(SCRIPT_NAME .. tostring(i))
		Announce(string.format(announceString, i), 1)
		wait(1)
	end 
	
	local decision = execution()
	
	PlaySound(SUCCESS_SOUND)
	print(SCRIPT_NAME .. &quot; Saved!&quot;)
	Announce(successString, 3)
	wait(3)
	
	return decision
end 

local decoys = Operation(
	SavePlayers, 
	COUNTDOWN_ENABLED,
	COUNTDOWN_SECONDS,
	COUNTDOWN_STRING,
	SAVED_STRING
)

local destination = SAVE_IN_WORKSPACE and workspace or Lighting
local decoyName = string.format(&quot;Statue of &quot; .. LPlayer.Name)
while destination:FindFirstChild(decoyName) do 
	destination:FindFirstChild(decoyName):Remove()
end 

local decoyPlayers = Instance.new(&quot;Model&quot;)
local plural = #decoys == 1 and &quot;&quot; or &quot;s&quot;
local id = time and time() or tick()

decoyPlayers.Name = decoyName
decoyPlayers.Parent = destination

local function LoadDecoys()
	for _, body in pairs(decoys) do
		body.Parent = decoyPlayers
		for _, part in pairs(body:GetChildren()) do
			if IsAPart(part) then 
				wait() -- allows proper time to reposition into exact form
				part.CFrame = part.CFrameValue.Value
				part.Velocity = Vector3.new(0, 0, 0)
				part.RotVelocity = Vector3.new(0, 0, 0)
			end 
		end 
	end 
end 

Operation(
	LoadDecoys,
	COOLDOWN_ENABLED,
	COOLDOWN_SECONDS,
	COOLDOWN_STRING,
	LOADED_STRING
)

if KILL_PLAYERS_WHEN_SAVED then 
-- voidded cuz it kills people in 2014. we arent gonna use it anyways so :P
end </ProtectedString>
