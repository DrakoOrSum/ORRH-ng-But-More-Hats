				<Item class="Script" referent="RBX4636">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Sword Fight Script</string>
						<ProtectedString name="Source">-- TODO: FIX NOT GETTING IT WHEN RESPAWNING

local storage = {}
local players = game:GetService(&quot;Players&quot;)
local swordy = game.Lighting.Sword:Clone()
local FightArea = script.Parent.Zone

function InZone(t)
	if not (t and t.Parent and t.Parent.Parent) then return end
	local z = FightArea

	local tp=t.Position
	local ap=z.Position
	local as=z.Size
	local ax=(as.x+1)/2
	local ay=(as.z+1)/2
	local ax1=ap.x-ax
	local ax2=ap.x+ax
	local ay1=ap.z-ay
	local ay2=ap.z+ay
	if tp.x&gt;ax1 and tp.x&lt;ax2 and tp.z&gt;ay1 and tp.z&lt;ay2 then
		return true
	else
		return
	end
end

local function Add(player, chr)
	local sword = nil
	repeat wait() until chr.Parent --print(player.Parent, chr.Parent, chr:FindFirstChild(&quot;Torso&quot;), chr:FindFirstChild(&quot;Humanoid&quot;))
	while player.Parent and chr.Parent and chr:FindFirstChild(&quot;Torso&quot;) and chr:FindFirstChild(&quot;Humanoid&quot;) and chr.Humanoid.Health &gt; 0 do 
		if (not storage[player.Name]) and InZone(chr.Torso) then 
			storage[player.Name] = {}

			for _, v in pairs(chr:GetChildren()) do
				if v.className == &quot;Tool&quot; then v.Parent = player.Backpack end
			end 

			for i, v in pairs(player.Backpack:GetChildren()) do 
				table.insert(storage[player.Name], v)
				v.Parent = nil
			end 

			sword = swordy:Clone()
			sword.Parent = player.Backpack 

			local tag = Instance.new(&quot;StringValue&quot;)
			tag.Name = &quot;Fighting&quot;
			tag.Parent = player
		elseif storage[player.Name] and not InZone(chr.Torso) then 
			if sword and sword.Parent then sword:Remove() end 
			for _, v in pairs(storage[player.Name]) do 
				v.Parent = player.Backpack
			end 

			storage[player.Name] = nil
			if chr.Humanoid.Health &gt; 0 then
				while player:FindFirstChild(&quot;Fighting&quot;) do player.Fighting:Remove() end 
			end 			
		elseif sword and sword.Parent and (sword.Parent ~= chr and sword.Parent ~= player.Backpack) then 
			sword.Parent = chr
		end
 
		wait(1/30)
		--print(&quot;loop&quot;, t)
	end 

	if sword then if sword.Parent then sword:Remove() end sword = nil end 
	storage[player.Name] = nil
end 

players.PlayerAdded:connect(function(plr)
	plr.CharacterAdded:connect(function(chr)
		Add(plr, chr)
	end)
end)

for _, plr in pairs(players:GetPlayers()) do 
	plr.CharacterAdded:connect(function(chr)
		Add(plr, chr)
	end)
	
	delay(0, function() if plr.Character then Add(plr, plr.Character) end end)
end 

--[[for _, v in pairs(script.Parent:GetChildren()) do
	if v.className == &quot;Part&quot; then 
		v.Touched:connect(touch)
	end 
end ]]</ProtectedString>
