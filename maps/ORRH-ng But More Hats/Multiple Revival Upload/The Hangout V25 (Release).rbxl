function convertToNumber(letter)
letter, up_scale = string.gsub(letter, &quot;%+&quot;, &quot;&quot;);
letter, down_scale = string.gsub(letter, &quot;%-&quot;, &quot;&quot;);
base=49+up_scale*12-down_scale*12;
letter, sharp = string.gsub(letter, &quot;%#&quot;, &quot;&quot;);
letter, flat = string.gsub(letter, &quot;b&quot;, &quot;&quot;);
if letter==&quot;A&quot; then return base + sharp - flat; end
if letter==&quot;B&quot; then return base + sharp - flat + 2; end
if letter==&quot;C&quot; then return base + sharp - flat + 3; end
if letter==&quot;D&quot; then return base + sharp - flat + 5; end
if letter==&quot;E&quot; then return base + sharp - flat + 7; end
if letter==&quot;F&quot; then return base + sharp - flat + 8; end
if letter==&quot;G&quot; then return base + sharp - flat + 10; end
end


function Play(song, position, channels)

local CurrentVolume=1;

local SoundInstances={};
for i=1,channels do
s=Instance.new(&quot;Sound&quot;, script.Parent); s.SoundId=&quot;rbxasset://sounds/electronicpingshort.wav&quot;; s.Volume=CurrentVolume;
SoundInstances[i]={s, true};
end

local Location=position; --How many beats have passed so far in the song. Most times, you&apos;ll start at 0, but in some cases you may want to start from a later point in the song.
local FinalBeat=1;

for i,v in pairs(song) do
if type(v[1])==&quot;string&quot; then FinalBeat=math.max(v[2]+v[3], FinalBeat); end
end

local BPM=100; --speed of the music. Stands for beats per minute. This is the default speed if none is specified.
local index=1; --start with the first one, naturally. This gets incremented every time a note is played.

for i=1,#song do
if type(song[i][1])==&quot;number&quot; then
if song[i][1]&lt;position then
BPM=song[i][2];
CurrentVolume=song[i][3];
for i,v in pairs(SoundInstances) do
v[1].Volume=song[i][3];
end
index=i+1;
end
else
if song[i][2]&lt;position then
index=i+1;
end
end
end

while Location&lt;FinalBeat do


while song[index]~=nil and ((type(song[index][1])==&quot;number&quot; and song[index][1]&lt;=Location) or (song[index][2]&lt;=Location)) do

local note=song[index];
if (type(song[index][1]))==&quot;string&quot; then
	--Pick which sound object to use.
	local ChosenSoundObject=nil; for i,v in pairs(SoundInstances) do if ChosenSoundObject==nil and v[2] then ChosenSoundObject=v; end end
	if ChosenSoundObject==nil then
		s=Instance.new(&quot;Sound&quot;, script.Parent); s.SoundId=&quot;rbxasset://sounds/electronicpingshort.wav&quot;; s.Volume=CurrentVolume;
		SoundInstances[#SoundInstances+1]={s, false};
		ChosenSoundObject=SoundInstances[#SoundInstances];
	end
	ChosenSoundObject[2]=false;
	
	--s.Volume =  script:FindFirstChild(&quot;Volume&quot;) and script.Volume.Value * CurrentVolume or s.Volume
	ChosenSoundObject[1].Volume = script:FindFirstChild(&quot;Volume&quot;) and script.Volume.Value * CurrentVolume or ChosenSoundObject[1].Volume
	sound=string.gmatch(note[4], &quot;;?sound:([^;]*)&quot;, &quot;&quot;)()
	if sound~=nil and tonumber(sound)~=nil then
		ChosenSoundObject[1].SoundId=Sounds[tonumber(sound)][2];
		BasePitch=Sounds[tonumber(sound)][3];
	elseif sound~=nil then
		for i,v in pairs(Sounds) do
			if v[1]==sound then
				ChosenSoundObject[1].SoundId=v[2];
				BasePitch=v[3];
			end
		end
	else
		ChosenSoundObject[1].SoundId=Sounds[1][2];
		BasePitch=Sounds[1][3];
	end


	ChosenSoundObject[1].Pitch=BasePitch * 1.05946309 ^ (convertToNumber(note[1]) - 49);
	ChosenSoundObject[1]:Play();
	Spawn(function()
		while Location&lt;note[2]+note[3] do wait(); end
		ChosenSoundObject[1]:Stop();
		ChosenSoundObject[2]=true;
	end)
else
	BPM=note[2];
	CurrentVolume=note[3];
	for i,v in pairs(SoundInstances) do
		v[1].Volume=note[3];
	end
end

index=index+1;
end

t=wait();
Location=Location+t*BPM/60;
end

for i,v in pairs(SoundInstances) do
	v[1]:Stop();
	v[1].Parent=nil;
end

end

while true do
Play(tune, 0, 6);
--Pass the song&apos;s table, the position that you&apos;re starting at (usually 0),
--and the number of channels to make by default. If the number of
--channels is too low, nothing really bad will happen. If there&apos;s lag in
--making the sound object, a note might sound out of place, but otherwise,
--the script will just handle creating channels. If you don&apos;t know what you&apos;re
--doing, then make the number of channels about 10, or so. Most songs won&apos;t
--go above that.
wait(); --repeat endlessly! &gt;:D
end
</ProtectedString>
