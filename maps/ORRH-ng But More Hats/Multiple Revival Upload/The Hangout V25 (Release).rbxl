					<Item class="Script" referent="RBX2201">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">HorseClickScript</string>
							<ProtectedString name="Source">local click = script.Parent.Click

local horse = script.Parent

while horse:FindFirstChild(&quot;ClickDetector&quot;) do horse.ClickDetector:Remove() end
local cd = Instance.new(&quot;ClickDetector&quot;)
cd.archivable = false 
cd.Parent = horse

local debounce = false
cd.MouseClick:connect(function()
	if debounce then return end 
	debounce=true
	script.Parent.Clicked.Value = script.Parent.Clicked.Value + 1
	click:Play()
	horse.Mesh.Scale = Vector3.new(1,.95,1)
	wait(.1337)
	horse.Mesh.Scale = Vector3.new(1,1,1)
	wait(.5)
	debounce=false
end)</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
