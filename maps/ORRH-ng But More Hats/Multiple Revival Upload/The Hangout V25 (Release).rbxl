				<Item class="Script" referent="RBX2302">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">BigCheezburgerScript</string>
						<ProtectedString name="Source">local debris = game:GetService(&quot;Debris&quot;)
local sounds = {script.Parent.DrinkSound, script.Parent.OpenSound}
local default = Vector3.new(4,4,4)
script.Parent.Mesh.Scale = default
script.Parent.CFrame = script.Parent.Origin.Value
script.Parent.Transparency = 0
script.Parent.CanCollide = true

local cooldown = 10
local eaten = false
while script.Parent:FindFirstChild(&quot;ClickDetector&quot;) do script.Parent.ClickDetector:Remove() end 
local cd = Instance.new(&quot;ClickDetector&quot;, script.Parent)
cd.archivable = false 
cd.MouseClick:connect(function()
	if eaten then return end 
	local sound = sounds[math.random(1,2)]
	sound.Pitch = 1
	sound:Play()
	script.Parent.CFrame = script.Parent.CFrame * CFrame.Angles(0, math.rad(math.random(-360, 360)), 0)
	script.Parent.Clicked.Value = script.Parent.Clicked.Value + 1
	script.Parent.Mesh.Scale = script.Parent.Mesh.Scale - Vector3.new(0.1, 0.1, 0.1)
	script.Parent.CFrame = script.Parent.CFrame * CFrame.new(0, -.025, 0)
	if script.Parent.Mesh.Scale.x &gt; .1 then return end 
	eaten = true 
	script.Parent.NomNomNom:Play()
	script.Parent.Transparency = 1
	script.Parent.CanCollide = false 
	wait(cooldown)
	script.Parent.Splat:Play()
	script.Parent.Mesh.Scale = default
	script.Parent.CFrame = script.Parent.Origin.Value		
	script.Parent.Transparency = 0
	script.Parent.CanCollide = true
	eaten = false 
end)

local grew = false
script.Parent.Touched:connect(function(obj)
	if obj.Parent == nil then return end
	if obj.Parent.className ~= &quot;Tool&quot; then return end
	if obj.Parent.Name ~= &quot;Cheezburger&quot; then return end --obj.Velocity = obj.Velocity * -10 return end 
	-- Trying to repell them with velocity will just make the tool fliing into oblivion....
	obj.Parent:Remove()
	local sound = sounds[math.random(1,2)]
	sound.Pitch = 0.5
	sound:Play()
	script.Parent.CFrame = script.Parent.CFrame * CFrame.Angles(0, math.rad(math.random(-360, 360)), 0)
	script.Parent.Mesh.Scale = script.Parent.Mesh.Scale + Vector3.new(0.1, 0.1, 0.1)
	script.Parent.CFrame = script.Parent.CFrame * CFrame.new(0, .025, 0)
	
	if script.Parent.Mesh.Scale.X &gt;= 12 then 
		local ex = Instance.new(&quot;Explosion&quot;)
		ex.BlastPressure = 0
		ex.Position = script.Parent.Position
		local smoke = Instance.new(&quot;Smoke&quot;)
		smoke.Parent = script.Parent
		ex.Parent = script.Parent
		
		script.Parent.Collide:Play()
		debris:AddItem(smoke, 6)

		local default = Vector3.new(4,4,4)
		script.Parent.Mesh.Scale = default
		script.Parent.CFrame = script.Parent.Origin.Value
		script.Parent.Transparency = 0
		script.Parent.CanCollide = true
	end 
	--delay(5, function() sound.Pitch = 1 end)
end)</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
