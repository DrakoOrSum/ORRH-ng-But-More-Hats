		<Item class="Script" referent="RBX5291">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">GrabHatProperties</string>
				<ProtectedString name="Source">local g = workspace[&quot;Hat Givers&quot;] local x = script.Parent; 

for _,v in pairs(x:GetChildren()) do 
	if v.className == &quot;Hat&quot; then 
		local hh = Instance.new(&quot;Model&quot;) 
		hh.Name = v.Name
		for _,j in pairs({&quot;Forward&quot;, &quot;Pos&quot;, &quot;Right&quot;, &quot;Up&quot;}) do 
			print(j, tostring(j)) 
			local p = Instance.new(&quot;Vector3Value&quot;) 
			p.Name = &quot;Attachment&quot; .. j 
			p.Value = v[p.Name] 
			p.Parent = hh 
			print(j) 
		end 
		hh.Parent = g print(v)  
	end 
end </ProtectedString>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
