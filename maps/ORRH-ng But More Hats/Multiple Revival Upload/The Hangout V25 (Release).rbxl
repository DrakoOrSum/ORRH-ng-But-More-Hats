								<Item class="Script" referent="RBX516">
									<Properties>
										<bool name="Disabled">true</bool>
										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">ToiletGuiScript</string>
										<ProtectedString name="Source">local main = script.Parent
local dookie = main.dookie
local nothing = main.nothing
local weezer = main.weezer

local slot = {dookie,weezer,nothing}
local color = {&quot;Brown&quot;, &quot;Bright yellow&quot;, &quot;Bright blue&quot;}
local toilet = script.Parent.Toilet.Value

local times = 15
local current = 0
local last = 0

for i = 1, times do
	current = math.random(1, #slot)
	while current == last do current = math.random(1, #slot) wait() end 
	last=current
	for j, s in pairs(slot) do s.Visible = (j==current) and true or false end
	script.Parent.Tick:Play()
	wait(i/times)
end 

toilet.Head.Victory:Play()
toilet.Head.BrickColor = BrickColor.new(color[current])
wait(4)
script.Parent:Remove()</ProtectedString>
										<bool name="archivable">true</bool>
