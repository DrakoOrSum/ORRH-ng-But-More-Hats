				<Item class="Script" referent="RBX4449">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">OnTouch</string>
						<ProtectedString name="Source">local part = script.Parent
local bit = {}

part.Touched:connect(function(obj)
	local player = game.Players:GetPlayerFromCharacter(obj.Parent)
	if not player then return end 
	if bit[player.Name] then return end 
	bit[player.Name] = true 
	part.Hiss:Play()

	local chr = obj.Parent
	for i = 1, 10 do 
		if chr.Parent == nil then break end 
		if chr:FindFirstChild(&quot;Humanoid&quot;)==nil or chr.Humanoid.Health &lt;= 0 then break end 
		chr.Humanoid.Health = chr.Humanoid.Health - (chr.Humanoid.Health/10)
		wait(1)
	end 
	bit[player.Name] = nil
end)</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
