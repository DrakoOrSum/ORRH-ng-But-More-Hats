					<Item class="LocalScript" referent="RBX5953">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">LocalScript</string>
							<ProtectedString name="Source">local Players = game:GetService(&quot;Players&quot;)
wait(1)

local PREFIX = &quot;http://www.roblox.com/asset/?id=&quot;

local hopperBin = script.Parent
local id1 = &quot;&quot;
local id2 = &quot;&quot;
local sizeX = 1
local sizeY = 1
local sizeZ = 1
local currentGui

local function createGui()
    local screenGui = Instance.new(&quot;ScreenGui&quot;, nil)
    screenGui.Parent = Players.LocalPlayer:FindFirstChild(&quot;PlayerGui&quot;, false)

    local textBox1 = Instance.new(&quot;TextBox&quot;, nil)
    textBox1.Name = &quot;IDText1&quot;
    textBox1.Position = UDim2.new(0, 0, 0.25, 0)
    textBox1.Size = UDim2.new(0.1, 0, 0.1, 0) 
    textBox1.Parent = screenGui

    local textBox2 = Instance.new(&quot;TextBox&quot;, nil)
    textBox2.Name = &quot;IDText2&quot;
    textBox2.Position = UDim2.new(0, 0, 0.35, 0)
    textBox2.Size = UDim2.new(0.1, 0, 0.1, 0) 
    textBox2.Parent = screenGui


    local sizeX = Instance.new(&quot;TextBox&quot;, nil)
    sizeX.Name = &quot;SizeX&quot;
    sizeX.Position = UDim2.new(0, 0, 0.45, 0)
    sizeX.Size = UDim2.new(0.1, 0, 0.1, 0) 
    sizeX.Parent = screenGui

    local sizeY = Instance.new(&quot;TextBox&quot;, nil)
    sizeY.Name = &quot;SizeY&quot;
    sizeY.Position = UDim2.new(0, 0, 0.55, 0)
    sizeY.Size = UDim2.new(0.1, 0, 0.1, 0) 
    sizeY.Parent = screenGui

    local sizeZ = Instance.new(&quot;TextBox&quot;, nil)
    sizeZ.Name = &quot;SizeZ&quot;
    sizeZ.Position = UDim2.new(0, 0, 0.65, 0)
    sizeZ.Size = UDim2.new(0.1, 0, 0.1, 0) 
    sizeZ.Parent = screenGui


    local textLabel = Instance.new(&quot;TextLabel&quot;, nil)
    textLabel.Position = UDim2.new(0, 0, 0.15, 0)
    textLabel.Size = UDim2.new(0.1, 0, 0.1, 0)
    textLabel.Text = &quot;Mesh, Texture, Size (X, Y, Z)&quot;
    textLabel.Parent = screenGui

    currentGui = screenGui
end

hopperBin.Deselected:connect(function()
    if currentGui then
        currentGui.Parent = nil
    end
end)
hopperBin.Selected:connect(function(mouse)
    if currentGui then
        currentGui.Parent = Players.LocalPlayer:FindFirstChild(&quot;PlayerGui&quot;, false)
    else
        createGui()
    end

    mouse.Button1Down:connect(function()
        local target = mouse.Target
        local targetSurface = mouse.TargetSurface
        id1 = Players.LocalPlayer.PlayerGui.ScreenGui.IDText1.Text
		  id2 = Players.LocalPlayer.PlayerGui.ScreenGui.IDText2.Text
		  sizeX = Players.LocalPlayer.PlayerGui.ScreenGui.SizeX.Text
		  sizeY = Players.LocalPlayer.PlayerGui.ScreenGui.SizeY.Text
		  sizeZ = Players.LocalPlayer.PlayerGui.ScreenGui.SizeZ.Text
        if target and not target.Locked then
            if id1 == &quot;&quot; and id2 == &quot;&quot; then
                -- The user wants to remove the mesh.
                for i, v in ipairs(target:GetChildren()) do
                    if v:IsA(&quot;SpecialMesh&quot;) then
                        v:Destroy()
                    end
                end
            else
                -- The user wants to add a mesh.
                local mesh = Instance.new(&quot;SpecialMesh&quot;, nil)
					 mesh.MeshType = &quot;FileMesh&quot;
                mesh.MeshId = PREFIX .. id1
                mesh.TextureId = PREFIX .. id2
				    mesh.Scale = Vector3.new(sizeX, sizeY, sizeZ)
                mesh.Parent = target
            end
        end
    end)
end)</ProtectedString>
