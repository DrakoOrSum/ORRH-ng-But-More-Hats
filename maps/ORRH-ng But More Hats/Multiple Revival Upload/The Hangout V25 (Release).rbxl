				<Item class="Script" referent="RBX3061">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">MainSystem</string>
						<ProtectedString name="Source">-- Functional, yet disabled, way of playing the SoundSystem!
-- I thought this would be helpful, but I just decided to give the scripts some volume instead. Because I feel like that would just be... easier....
-- If you want to turn this back on, just enable this script and comment out the final loop inside of &quot;SoundSystem Script&quot;

local Players = game:GetService(&quot;Players&quot;)
local SoundSystem = script.Parent
local Area = SoundSystem.SoundSystemArea
local PlayLocalScript = script.PlaySystem

function InZone(t,z)
	if not t or not z then return end 

	local tp=t.Position
	local ap=z.Position
	local as=z.Size
	local ax=(as.x+1)/2
	local ay=(as.z+1)/2
	local ax1=ap.x-ax
	local ax2=ap.x+ax
	local ay1=ap.z-ay
	local ay2=ap.z+ay
	if tp.x&gt;ax1 and tp.x&lt;ax2 and tp.z&gt;ay1 and tp.z&lt;ay2 then
		return true
	else
		return false
	end
end

-- TODO
-- change all localscripts to scripts
-- but parent those scripts into the currentcamera through a localscript in playergui
-- this script handles that

function InEitherZone(t)
	for _, v in pairs(Area:GetChildren()) do 
		if InZone(t, v) then return true end 
	end 
end

local function Add(plr, chr)
	repeat wait() until chr.Parent and chr:FindFirstChild(&quot;Torso&quot;) and chr:FindFirstChild(&quot;Humanoid&quot;)
	local hm = chr.Humanoid
	local torso = chr.Torso
	local playsystem = nil

	print(&quot;Starting SoundSystem Check for&quot;, plr.Name)
	while chr.Parent and torso.Parent and hm.Parent and hm.Health &gt; 0 do 
		if InEitherZone(torso) and not (playsystem and playsystem.Parent) then 
			print(plr.Name, &quot; Can now hear!&quot;)
			playsystem = PlayLocalScript:Clone()
			playsystem.Origin.Value = SoundSystem
			playsystem.Parent = plr.PlayerGui
		elseif playsystem and not InEitherZone(torso) then
			local finish = Instance.new(&quot;IntValue&quot;)
			finish.Name = &quot;Finish&quot;
			finish.Parent = playsystem
		end 
		wait(1/30)
	end 

	print(&quot;Died!&quot;)
	wait(4)
	if playsystem.Parent then 
		local finish = Instance.new(&quot;IntValue&quot;)
		finish.Name = &quot;Finish&quot;
		finish.Parent = playsystem
		repeat wait() until not playsystem.Parent
		playsystem = nil
	end 
end

Players.PlayerAdded:connect(function(plr)
	plr.CharacterAdded:connect(function(chr) Add(plr, chr) end)
end)

for _, p in pairs(Players:GetPlayers()) do 
	if p.Character and p.Character.Parent then delay(0, function() Add(p, p.Character) end) end 
	p.CharacterAdded:connect(function(chr) Add(p, p.Character) end)
end </ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="LocalScript" referent="RBX3062">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">PlaySystem</string>
							<ProtectedString name="Source">local Player = game:GetService(&quot;Players&quot;).LocalPlayer
local Character = Player.Character
local Torso = Character:FindFirstChild(&quot;Torso&quot;)
local Humanoid = Character:FindFirstChild(&quot;Humanoid&quot;)
if not (Humanoid and Torso) then return end 

local SoundSystem = script.Origin.Value
local Songs = SoundSystem.Songs
local ID = SoundSystem.ID
local IsPlaying = SoundSystem.Playing

local PointSound = SoundSystem.Head:Clone()
PointSound.Anchored = true 
PointSound.Locked = true 
PointSound.Transparency = 1
for _, v in pairs(PointSound:GetChildren()) do v:Remove() end 
PointSound.Parent = workspace.CurrentCamera

local function CanPlay()
	return not script:FindFirstChild(&quot;Finish&quot;)
end 

local Song = nil
print(&quot;Starting&quot;, script.Name, &quot;For&quot;, Player.Name)
while CanPlay() and Torso.Parent and Humanoid.Parent and Humanoid.Health &gt; 0 do 
	wait(1/30)
	if IsPlaying.Value == true and (Song == nil or Song.Name ~= ID.Value) and Songs:FindFirstChild(ID.Value) then 
		Song = Songs[ID.Value]:Clone()
		Song.Parent = PointSound
		Song.Disabled = false 
	elseif IsPlaying.Value == false and Song then 
		for _, v in pairs(PointSound:GetChildren()) do if v.className == &quot;Sound&quot; then v:Stop() end v:Remove() end 
		Song:Remove()
		Song = nil 
	end
end 

print(&quot;Ending&quot;, script.Name, &quot;For&quot;, Player.Name)
if Song then 
	for _, v in pairs(PointSound:GetChildren()) do if v.className == &quot;Sound&quot; then v:Stop() end v:Remove() end 
	Song:Remove()
end 

PointSound:Remove()
script:Remove()</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="ObjectValue" referent="RBX3063">
							<Properties>
								<string name="Name">Origin</string>
								<Ref name="Value">null</Ref>
