				<Item class="Script" referent="RBX2822">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Instructions</string>
						<ProtectedString name="Source">local head = script.Parent.Head

local function clicky(obj)
	while obj:FindFirstChild(&quot;ClickDetector&quot;) do obj.ClickDetector:Remove() end
	local cd = Instance.new(&quot;ClickDetector&quot;)
	cd.archivable = false
	cd.Parent = obj
	return cd
end 

local cd = clicky(head)
local cdd = clicky(script.Parent.Play)
script.Parent.Name = &quot;Boombox&quot;

local db = false
local function Click()
	if db then return end 
	db = true 
	local hm = Instance.new(&quot;Humanoid&quot;)
	hm.archivable = false 
	hm.Health, hm.MaxHealth = 0, 0
	hm.Parent = script.Parent
	script.Parent.Name = &quot;Please touch my button to get DJ access!&quot;
	wait(5)
	hm:Remove()
	script.Parent.Name = &quot;Boombox&quot;
	db = false 
end 

cd.MouseClick:connect(Click)
cdd.MouseClick:connect(Click)

while script.Parent:FindFirstChild(&quot;Humanoid&quot;) do 
	script.Parent.Humanoid:Remove()
end </ProtectedString>
