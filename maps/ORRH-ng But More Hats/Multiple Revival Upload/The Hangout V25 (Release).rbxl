					<Item class="Script" referent="RBX2965">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">TV DVD Logo Script</string>
							<ProtectedString name="Source">-- Boucning DVD screen

local part = Instance.new(&quot;Part&quot;)
part.formFactor = &quot;Plate&quot;
part.Size = Vector3.new(2,.4,1)
part.Parent = script.Parent
part.Anchored = true 
part.Locked = true
part.BrickColor = BrickColor.new(&quot;Institutional white&quot;)
part.archivable = false

while true do
	wait(1)
	part.CFrame = script.Parent.CFrame * CFrame.new(math.random(script.Parent.Size.x/-2, script.Parent.Size.x/2)/2, .1,  math.random(script.Parent.Size.z/-2, script.Parent.Size.z/2)/2)
end </ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
				</Item>
				<Item class="Part" referent="RBX2966">
