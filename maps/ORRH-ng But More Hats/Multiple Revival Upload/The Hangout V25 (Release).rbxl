					<Item class="Script" referent="RBX2020">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">CoilClickScript</string>
							<ProtectedString name="Source">local click = script.Parent.Click

local coil = script.Parent

while coil:FindFirstChild(&quot;ClickDetector&quot;) do coil.ClickDetector:Remove() end
local cd = Instance.new(&quot;ClickDetector&quot;)
cd.archivable = false 
cd.Parent = coil

local debounce = false
cd.MouseClick:connect(function()
	if debounce then return end 
	debounce=true
	script.Parent.Clicked.Value = script.Parent.Clicked.Value + 1
	click:Play()
	coil.Mesh.Scale = Vector3.new(.5,.5,.4)
	for i = 1, 3, .5 do 
		coil.Mesh.Scale = Vector3.new(.5,.5,.45)
		wait(.25)
		coil.Mesh.Scale = Vector3.new(.5,.5,.4)
		wait(.25)
	end 
	click:Stop()
	coil.Mesh.Scale = Vector3.new(.5,.5,.5)
	--wait(.5)
	debounce=false
end)</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
