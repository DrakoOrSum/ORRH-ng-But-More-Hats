									<string name="Name">SoundSystemGUIScript</string>
									<ProtectedString name="Source">local system = script.Parent.SoundSystem.Value--workspace:FindFirstChild(&quot;system&quot;)
local songs = {}
for _, v in pairs(system.Songs:GetChildren()) do 
	table.insert(songs, v.Name)
end 

local songframe = script.Parent.SongFrame:Clone()
local tabs = {script.Parent.SongFrame}

for i = 1, #songs do
	local tab = tabs[1]
	if i ~= 1 then
		tab = songframe:Clone()
		table.insert(tabs, tab)
		tab.Position = songframe.Position + UDim2.new(0, 0, 0, 25*(i-1))
		tab.Parent = script.Parent
	end
		
	-- communicate
	tab.Song.MouseButton1Click:connect(function()
		system.ID.Value = tab.ID.Value
		system.Playing.Value = true
		refresh()
	end) 
end 

-- #ToolButtons * (currentPage-1)
function refresh()
	--script.Parent.Page.Text = &quot;NEXT PAGE (&quot; .. page+1 .. &quot;/&quot; .. limit .. &quot;)&quot;
	--local difference = (#tabs * page)
	for i, tab in pairs(tabs) do
		local song = songs[i]
		tab.Song.Text = song or &quot;N/A&quot;
		tab.ID.Value = song or 0
		tab.State.Text = (song) and ((system.ID.Value == song) and &quot;&lt;-- NOW PLAYING&quot; or &quot;&quot;) or &quot;&quot;
	end 
end 

script.Parent.STOP.MouseButton1Click:connect(function() system.ID.Value = &quot;&quot; system.Playing.Value = false refresh() end)
--script.Parent.Page.MouseButton1Click:connect(function() currentpage = currentpage + 1 if currentpage &gt;= limit then currentpage = 0 end refresh(currentpage) end)
script.Parent.EXIT.MouseButton1Click:connect(function() script.Parent.Parent:Remove() end)

refresh()</ProtectedString>
