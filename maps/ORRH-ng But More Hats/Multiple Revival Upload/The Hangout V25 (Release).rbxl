					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">SwordScript</string>
					<ProtectedString name="Source">-------- OMG HAX

r = game:service(&quot;RunService&quot;)


local damage = 5


local slash_damage = 10
local lunge_damage = 20

sword = script.Parent.Handle
Tool = script.Parent

local Fencing = nil
while not Fencing do
	Fencing = workspace:FindFirstChild(&quot;Fencing&quot;)
	wait(1/30)
end 

local SoundArea = nil
while not SoundArea do 
	SoundArea = Fencing:FindFirstChild(&quot;SoundAreaForSF&quot;) 
	wait(1/30)
end 

local FightArea = nil
while not FightArea do 
	FightArea = Fencing:FindFirstChild(&quot;FightArea&quot;)
	wait(1/30)
end 

local function PlaySound(txt, vol)
	local submission = Instance.new(&quot;StringValue&quot;)
	submission.Name = txt
	submission.Value = tostring(vol)
	local pos = Instance.new(&quot;CFrameValue&quot;)
	pos.Name = &quot;PlayCFrame&quot;
	pos.Value = sword.CFrame 
	pos.Parent = submission
	submission.Parent = SoundArea
	game:GetService(&quot;Debris&quot;):AddItem(submission, 3)
end 

function InZone(a)
	local z = FightArea.Zone
	local t = a or script.Parent.Parent:FindFirstChild(&quot;Torso&quot;) -- character
	if not t then return end 

	local tp=t.Position
	local ap=z.Position
	local as=z.Size
	local ax=(as.x+1)/2
	local ay=(as.z+1)/2
	local ax1=ap.x-ax
	local ax2=ap.x+ax
	local ay1=ap.z-ay
	local ay2=ap.z+ay
	if tp.x&gt;ax1 and tp.x&lt;ax2 and tp.z&gt;ay1 and tp.z&lt;ay2 then
		return true
	else
		return false
	end
end

--[[
