				<Item class="Script" referent="RBX3137">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local bass = script.Parent.Bass

while script.Parent:FindFirstChild(&quot;ClickDetector&quot;) do script.Parent.ClickDetector:Remove() end 
local cd = Instance.new(&quot;ClickDetector&quot;, script.Parent)
cd.archivable = false 
cd.MouseClick:connect(function()
	script.Parent.Plunked.Value = script.Parent.Plunked.Value +1
	bass.Pitch = math.random(75,150)/100
	bass:Play()
end)
</ProtectedString>
