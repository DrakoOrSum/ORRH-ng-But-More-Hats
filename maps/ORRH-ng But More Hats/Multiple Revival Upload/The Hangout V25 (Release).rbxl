					<Item class="Script" referent="RBX2450">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Table Corner Script</string>
							<ProtectedString name="Source">local tripped = {}
script.Parent.Touched:connect(function(obj)
	local player = game.Players:GetPlayerFromCharacter(obj.Parent)
	if not player then return end 
	if tripped[player.Name] then return end 
	tripped[player.Name]=true
	obj.Parent.Humanoid.WalkSpeed = 16/2
	obj.Parent.Torso.Velocity = (obj.Parent.Head.CFrame.lookVector + Vector3.new(0, -.2, 0)) * 20
	obj.Parent.Humanoid.PlatformStand = true 
	script.Parent.Ouch:Play()
	local ff = Instance.new(&quot;ForceField&quot;)
	ff.Parent = obj
	game:GetService(&quot;Debris&quot;):AddItem(ff, 4)
	wait(4)
	obj.Parent.Humanoid.PlatformStand = false 
	obj.Parent.Humanoid.WalkSpeed = 16
	wait(2)
	tripped[player.Name] = false
end)</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
				</Item>
