						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">SoundSystem Script</string>
						<ProtectedString name="Source">local playing = script.Parent.Playing
local ID = script.Parent.ID
local GUI = script.SoundSystemGUI
local ToGive = GUI:Clone()
local player = nil

local head = script.Parent.Head
local turnable = script.Parent.Turnable
local Songs = script.Parent.Songs
local song = nil

ID.Value = &quot;&quot;
playing.Value = false

local function StopSong()
	if song then song:Remove() song = nil end
	for _,v in pairs(head:GetChildren()) do if v.className == &quot;Sound&quot; then v:Stop() wait() v:Remove() end end
end 

script.Parent.Head.Touched:connect(function(obj)
	local plr = game.Players:GetPlayerFromCharacter(obj.Parent)
	if not plr then return end 
	if player then local msg = Instance.new(&quot;Message&quot;, plr) msg.Text = player.Name .. &quot; has the SoundSystem privilage!&quot; game:GetService(&quot;Debris&quot;):AddItem(msg, 5) return end 
	player = plr
	ToGive.Main.SoundSystem.Value = script.Parent
	ToGive.Parent = player.PlayerGui
	ToGive.Main.SoundSystemGUIScript.Disabled = false
	repeat wait() until player == nil or player.Parent == nil or ToGive.Parent == nil 
	ToGive = GUI:Clone()
	player = nil
end)

delay(0, function()
	while true do
		for _, s in pairs(script.Parent:GetChildren()) do if s.Name == &quot;Speaker&quot; then s.Mesh.Scale = Vector3.new(1.25,1.25,1.25) end end 
		while playing.Value == false do wait() end 
		while playing.Value == true do 
			for _, s in pairs(script.Parent:GetChildren()) do if s.Name == &quot;Speaker&quot; then s.Mesh.Scale = Vector3.new(1.50,1.50,1.50) end end 
			wait(.25)
			for _, s in pairs(script.Parent:GetChildren()) do if s.Name == &quot;Speaker&quot; then s.Mesh.Scale = Vector3.new(1.25,1.25,1.25) end end 
			wait(.25)
		end 
	end 
end)

delay(0, function()
	while true do
		StopSong()
		while playing.Value == false do wait() end 
		while playing.Value == true do 
			turnable.CFrame = turnable.CFrame * CFrame.Angles(0, math.rad(1), 0)
			wait()
		end 
	end 
end)

while true do
	local current = ID.Value
	while ID.Value == current do wait() end 
	while playing.Value == false do wait() end 
	while not Songs:FindFirstChild(ID.Value) do wait() end --?
	StopSong()
	song = Songs:FindFirstChild(ID.Value):Clone()
	song.Parent = head
	song.archivable = false 
	song.Disabled = false 
end
</ProtectedString>
