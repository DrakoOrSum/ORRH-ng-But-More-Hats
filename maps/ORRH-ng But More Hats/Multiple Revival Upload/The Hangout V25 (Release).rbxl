				<Item class="Script" referent="RBX1199">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">OldWeldSeat</string>
						<ProtectedString name="Source">local seats = {}

function GetDescendants(instance)
	local descendants = {}
	for i, v in pairs(instance:GetChildren()) do
		table.insert(descendants, v)
		for j, w in pairs(GetDescendants(v)) do
			table.insert(descendants, w)
		end
	end
	return descendants
end    

for _, v in pairs(GetDescendants(script.Parent)) do 
	if v.className == &quot;Seat&quot; and v.Parent:FindFirstChild(&quot;Back&quot;) then 
		table.insert(seats, v)
	end 
end 

local function Main(seat)
	local seat = seat
	local back = seat.Parent.Back

	local w = Instance.new(&quot;Weld&quot;)
	w.Part0 = seat
	w.Part1 = back
	w.C0 = seat.CFrame:inverse() * back.CFrame
	w.Parent = seat

	seat.Anchored = false
end 

for _, seat in pairs(seats) do 
	Main(seat)
end </ProtectedString>
						<bool name="archivable">true</bool>
