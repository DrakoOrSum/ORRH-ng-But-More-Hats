				<Item class="Script" referent="RBX1218">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">WeldSeat</string>
						<ProtectedString name="Source">local seats = {}

function GetDescendants(instance)
	local descendants = {}
	for i, v in pairs(instance:GetChildren()) do
		table.insert(descendants, v)
		for j, w in pairs(GetDescendants(v)) do
			table.insert(descendants, w)
		end
	end
	return descendants
end    

for _, v in pairs(GetDescendants(script.Parent)) do 
	if v.className == &quot;Seat&quot; and v.Parent:FindFirstChild(&quot;Back&quot;) then 
		table.insert(seats, v)
	end 
end 

local function Main(seat)
	local seat = seat
	local back = seat.Parent.Back

	local w = Instance.new(&quot;Weld&quot;)
	w.Part0 = seat
	w.Part1 = back
	w.C0 = seat.CFrame:inverse() * back.CFrame
	w.Parent = seat

	seat.Anchored = false
end 

for _, seat in pairs(seats) do 
	Main(seat)
	seat.ChildAdded:connect(function(obj)
		if obj.Name ~= &quot;SeatWeld&quot; then return end 
		local torso = obj.Part1
		if not torso then return end 
		local player = game.Players:GetPlayerFromCharacter(torso.Parent)
		if not player then return end 

		local character = player.Character
		-- repeat wait() until obj.Parent == nil or player.Parent == nil or character.Parent == nil or (not character:FindFirstChild(&quot;Humanoid&quot;)) or character.Humanoid.Health &lt;= 0
		while obj.Parent and player.Parent and character.Parent and character:FindFirstChild(&quot;Humanoid&quot;) and character.Humanoid.Health &gt; 0 do 
			wait()
		end 
	
		seat.Velocity = Vector3.new(0,0,0)
		seat.RotVelocity = Vector3.new(0,0,0)
		if not (player.Parent and character.Parent) then return end 
		print(&quot;ResetVelocity&quot;)
		for _, v in pairs(character:GetChildren()) do if v.className == &quot;Part&quot; then 
			v.Velocity = Vector3.new(0,0,0) v.RotVelocity = Vector3.new(0,0,0) 
		end  end 
	end)
end </ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
