				<Item class="Script" referent="RBX2339">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Toaster Script</string>
						<ProtectedString name="Source">local model = script.Parent
local toast = model.toast
local toaster = model.toaster
local slot = model.slot
local shoot = toaster.Shoot

toast.Anchored = true 
toast.Transparency = 1
toast.CanCollide = false 
toast.CFrame = toaster.CFrame * CFrame.Angles(math.rad(90),0, math.rad(90))
toast.Locked = true

local newtoast = nil
local out = false 
local db = false

while toaster:FindFirstChild(&quot;ClickDetector&quot;) do toaster.ClickDetector:Remove() end 
while toaster:FindFirstChild(&quot;ClonedToast&quot;) do toaster.ClonedToast:Remove() end

local cd = Instance.new(&quot;ClickDetector&quot;)
cd.archivable = false 
cd.Parent = toaster
cd.MouseClick:connect(function()
	if db then return end 
	db = true 

	if out then 
		newtoast:Remove()
		newtoast = nil
		out = false
	else
		out = true 
		newtoast = toast:Clone()
		newtoast.Name = &quot;ClonedToast&quot;
		newtoast.Locked = false
		newtoast.CFrame = newtoast.CFrame * CFrame.new(0,0,-1) * CFrame.Angles(0, math.rad(math.random(0,360)), 0)
		newtoast.Anchored = false 
		newtoast.CanCollide = true 
		newtoast.Parent = workspace
		newtoast.Velocity = Vector3.new(0, 30, 0)
		newtoast.RotVelocity = Vector3.new(0, math.random(), 0)
		shoot:Play()
		--game:GetService(&quot;Debris&quot;):AddItem(newtoast, 30)
	end 
	wait(.1337)
	db = false 
end)</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
