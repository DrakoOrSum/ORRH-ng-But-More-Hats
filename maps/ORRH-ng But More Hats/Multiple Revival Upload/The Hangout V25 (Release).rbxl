					<Item class="Script" referent="RBX4712">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Sandwich Heal</string>
							<ProtectedString name="Source">local healed = false
local db = 20

script.Parent.Transparency = 0
script.Parent.CanCollide = true
script.Parent.Touched:connect(function(obj)
	local plr = game.Players:GetPlayerFromCharacter(obj.Parent)
	if not plr then return end 
	if obj.Parent:FindFirstChild(&quot;Humanoid&quot;) == nil then return end 
	if obj.Parent.Humanoid.Health &lt;= 0 then return end 
	if obj.Parent.Humanoid.Health &gt;= obj.Parent.Humanoid.MaxHealth then return end 
	if healed then return end 

	healed = true 
	script.Parent.Transparency = 1
	script.Parent.CanCollide = false
	obj.Parent.Humanoid.Health = obj.Parent.Humanoid.MaxHealth
	script.Parent.NomNomNom:Play()
	wait(db)
	healed = false 
	script.Parent.Transparency = 0
	script.Parent.CanCollide = true
end)</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
