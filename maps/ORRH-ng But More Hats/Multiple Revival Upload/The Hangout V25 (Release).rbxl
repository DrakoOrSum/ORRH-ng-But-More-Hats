						<ProtectedString name="Source">function GetDescendants(object)
	local descendants = {}
	local function Scan(parent)
		for _,v in pairs(parent:GetChildren()) do
			table.insert(descendants, v)
			Scan(v)
		end
	end
	Scan(object)
	return descendants
end

local function SetModelCFrame(primpart, model, desiredcf)
	local origprimpartcf = primpart.CFrame
	for i, part in pairs(GetDescendants(model)) do
		if part.className == &quot;Part&quot; then 
			local offset = origprimpartcf:inverse() * part.CFrame
			part.CFrame = desiredcf * offset
		end
	end
	primpart.CFrame = desiredcf
end 

function check(body, t)
	local tp=t.Position
	local cf = body.CFrame * CFrame.new(0, 0, body.Size.z)
	local ap= cf.p
	local as= Vector3.new(10, 10, 10)
	local ax=(as.x+1)/2
	local ay=(as.z+1)/2
	local ax1=ap.x-ax
	local ax2=ap.x+ax
	local ay1=ap.z-ay
	local ay2=ap.z+ay
	if tp.x&gt;ax1 and tp.x&lt;ax2 and tp.z&gt;ay1 and tp.z&lt;ay2 then
		--print(&quot;TRIGGER!&quot;)
		return true
	else
		return false
	end
end

local cars = game.Lighting.Cars
local hole1 = script.Parent.Hole1
local hole2 = script.Parent.Hole2

local ran = {}
local roombaran=false
local function CheckHitAndRun(car)
	if _G.Roomba then
		if not roombaran and check(car.Body, _G.Roomba) then 
			roombaran = true 
			_G.Roomba[&quot;Roomba Script&quot;].Disabled = true 
			_G.Roomba.Mesh.Scale = Vector3.new(1, .25, 1)
			car.Body.Hit1.Volume=.5
			car.Body.Hit1:Play()
			_G.Roomba.Squish:Play()
			_G.Roomba.Parent.Name = string.format(&quot;ow %s&quot;, math.random(1,2) == 1 and &quot;X_X&quot; or &quot;:C&quot;)
			delay(4, function()
				_G.Roomba[&quot;Roomba Script&quot;].Disabled = false 
				wait(1)
				roombaran = false 
			end)
		end 
	end 

	for _,p in pairs(game.Players:GetPlayers()) do
		if not ran[p.Name] and p.Character and p.Character:FindFirstChild(&quot;Torso&quot;) and p.Character.Humanoid.Health &gt; 0 then
			local torso = p.Character.Torso
			if check(car.Body, torso) then
				ran[p.Name]=true
				car.Body.Hit1.Volume=.5
				car.Body.Hit2.Volume=.5
				car.Body.Hit1:Play()
				car.Body.Hit2:Play()
				torso.Parent.Humanoid.PlatformStand = true
				torso.Velocity = (car.Body.CFrame.lookVector * -50) + Vector3.new(0, 100, 0)
				torso.RotVelocity = Vector3.new(0, 0, 50)
				--for _,v in pairs(torso.Parent:GetChildren()) do if v.className == &quot;Part&quot; then v.Velocity = car.Body.CFrame.lookVector * math.random(-100, -75) end end
				--torso.Velocity = car.Body.CFrame.lookVector * -100
				--wait() torso:BreakJoints()
				delay(1, function() torso.Touched:wait() torso:BreakJoints() end)
				delay(3, function() ran[p.Name]=nil end)
				--return
			end 
		end 
	end
end 

local lastSpawn = nil
local function LSspawn()
	wait(2)
	lastSpawn = true
	wait(2)
	lastSpawn = nil
end 

local pickups = {
	&quot;i leik cars&quot;,
	&quot;car&quot;,
	&quot;huzzah!&quot;
}
for _,v in pairs(pickups) do pickups[v]=true end

local function PlayerChecker(player)
	player.Chatted:connect(function(str)
		if not pickups[string.lower(str)] then return end	
		LSspawn()
	end)
	player.CharacterAdded:connect(LSspawn)
end

local function roll()
	if lastSpawn then 	
		lastSpawn=nil
		return math.random(1,5) ~= 1 -- 1/5 chance for this to happen
	else return true end 
end 

local min = 33
local max = 69

local minspeed = 2
local maxspeed = 5

game.Players.PlayerAdded:connect(PlayerChecker)
for _, p in pairs(game.Players:GetPlayers()) do PlayerChecker(p) end

while true do
	local chance = tick() + math.random(min, max)
	while tick() &lt; chance and roll() do wait() end 
	local car = cars:GetChildren()[math.random(1, #cars:GetChildren())]:Clone()
	local hole = math.random(1,2) == 1 and hole1 or hole2
	local speed = math.random(minspeed, maxspeed)
	car.archivable = false
	local color = BrickColor.random()
	for _, p in pairs(car:GetChildren()) do if p.Name ~= &quot;Part&quot; and p.Name ~= &quot;Wheel&quot; then p.BrickColor = color end end
	for _,s in pairs(script:GetChildren()) do local ss = s:Clone() ss.Parent = car.Body end
	car.Body.Drive.Looped=true
	car.Parent = script.Parent
	car.Body.Drive.Pitch = speed/(maxspeed/2)
	car.Body.Drive:Play()
	car.Body.Drive.Volume=1
	for i = 1, 225, speed do
		SetModelCFrame(car.Body, car, hole.CFrame * CFrame.new(0, (hole.Size.y/-2)+(car.Body.Size.y*.75), -25+i))
		wait()
		CheckHitAndRun(car)
	end 
	car.Body.Drive:Stop()
	wait()
	car:Remove()
end </ProtectedString>
