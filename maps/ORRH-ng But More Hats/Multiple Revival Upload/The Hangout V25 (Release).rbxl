						<Item class="Script" referent="RBX1703">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">LampScript</string>
								<ProtectedString name="Source">local click = script.Parent.Click

local lamp = script.Parent

while lamp:FindFirstChild(&quot;ClickDetector&quot;) do lamp.ClickDetector:Remove() end
local cd = Instance.new(&quot;ClickDetector&quot;)
cd.archivable = false 
cd.Parent = lamp

local mode = lamp.BrickColor == BrickColor.new(&quot;Cool yellow&quot;)

local debounce = false
cd.MouseClick:connect(function()
	if debounce then return end 
	debounce=true
	mode = not mode
	script.Parent.Clicked.Value = script.Parent.Clicked.Value + 1
	click.Pitch = mode and 0.9 or 0.8
	click:Play()
	lamp.BrickColor = BrickColor.new(mode and &quot;Cool yellow&quot; or &quot;Dark stone grey&quot;)
	wait(.5)
	debounce=false
end)</ProtectedString>
								<bool name="archivable">true</bool>
