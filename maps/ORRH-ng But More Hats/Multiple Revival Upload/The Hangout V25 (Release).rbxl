				<Item class="Script" referent="RBX1399">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Click</string>
						<ProtectedString name="Source">local posters = workspace.Hangout[&quot;Creator Posters&quot;]
for _,a in pairs(script.Parent:GetChildren()) do
	for _, v in pairs(a:GetChildren()) do 
		if v.className == &quot;Part&quot; then 
			local talking = false
			while v:FindFirstChild(&quot;ClickDetector&quot;) do v.ClickDetector:Remove() end 
			local cd = Instance.new(&quot;ClickDetector&quot;)
			cd.archivable = false 
			cd.Parent = v
			a.Name = &quot;&quot;
			cd.MouseClick:connect(function()
				if talking then return end 
				talking = true 
				a.Name = a.StringName.Value
				posters[a.StringName.Value].CFrame = posters[a.StringName.Value].CFrame * CFrame.Angles(0, math.rad(math.random(-1,1)), 0)
				wait(4)
				a.Name = &quot;&quot;
				talking = false
			end)
		end 
	end 
end 
</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
