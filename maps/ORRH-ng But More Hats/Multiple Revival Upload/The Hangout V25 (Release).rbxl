				<Item class="Script" referent="RBX2802">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Boombox Script</string>
						<ProtectedString name="Source">while script.Parent.Head:FindFirstChild(&quot;Sound&quot;) do script.Parent.Head.Sound:Stop() script.Parent.Head.Sound:Remove() end 
local sound = Instance.new(&quot;Sound&quot;)
sound.archivable = false 
sound.Looped = true
sound.Parent = script.Parent.Head

local playing = script.Parent.Playing
local ID = script.Parent.ID
local GUI = script.BoomboxGUI
local ToGive = GUI:Clone()
local player = nil
--[[
ID.Changed:connect(function()
	sound:Stop()
	wait()
	if playing.Value == false then return end 
	sound.SoundId = &quot;http://www.roblox.com/asset/?id=&quot; .. ID.Value
	sound:Play()
end) 

playing.Changed:connect(function()
	if playing.Value == true then 
		sound:Play()
	else sound:Stop() end 
end)]]

script.Parent.Play.Touched:connect(function(obj)
	local plr = game.Players:GetPlayerFromCharacter(obj.Parent)
	if not plr then return end 
	if player then local msg = Instance.new(&quot;Message&quot;, plr) msg.Text = player.Name .. &quot; has the boombox privilage!&quot; game:GetService(&quot;Debris&quot;):AddItem(msg, 5) return end 
	player = plr
	ToGive.Main.Boombox.Value = script.Parent
	ToGive.Parent = player.PlayerGui
	ToGive.Main.BoomboxGUIScript.Disabled = false
	repeat wait() until player.Parent == nil or ToGive.Parent == nil 
	ToGive = GUI:Clone()
	player = nil
end)

delay(0, function()
	playing.Value = false
	while true do
		ID.Value = 0
		for _, s in pairs(script.Parent:GetChildren()) do if s.Name == &quot;Speaker&quot; then s.Mesh.Scale = Vector3.new(1,1,1) end end 
		while playing.Value == false do wait() end 
		sound:Play()
		while playing.Value == true do 
			for _, s in pairs(script.Parent:GetChildren()) do if s.Name == &quot;Speaker&quot; then s.Mesh.Scale = Vector3.new(1.25,1.25,1.25) end end 
			wait(.25)
			for _, s in pairs(script.Parent:GetChildren()) do if s.Name == &quot;Speaker&quot; then s.Mesh.Scale = Vector3.new(1,1,1) end end 
			wait(.25)
		end 
		sound:Stop()
	end 
end)

delay(0, function()
	ID.Value = 0
	while true do
		local current = ID.Value
		while ID.Value == current do wait() end 
		while playing.Value == false do wait() end 
		sound:Stop()
		wait()
		local soundid = &quot;http://www.roblox.com/asset/?id=&quot; .. ID.Value
		sound.SoundId = soundid
		sound:Play()
		-- attempt to allow cache to load
			-- may be bypassed/weird if player switches songs too fast
		wait(.1337)
		sound:Stop()
		wait()
		sound:Play()
	end 
end)</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
