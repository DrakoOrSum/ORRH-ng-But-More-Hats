					<Item class="Script" referent="RBX1548">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Hat Giver Script</string>
							<ProtectedString name="Source">local Hats = {}
for _,v in pairs(script.Parent:GetChildren()) do
	if v:FindFirstChild(&quot;Handle&quot;) then 
		local attachments = {}
		for _, j in pairs(v:GetChildren()) do
			if j.className == &quot;Vector3Value&quot; then
				attachments[j.Name] = j.Value
			end 
		end 
		Hats[v.Name] = {Attachments = attachments, Handle = v.Handle}
	end 
end 

local lookmag = 1
local posmag = 4

local PlayerHatStorage = {}
local Borrowed = {}
local reset = script.Parent.Reset

local points = script.Parent[&quot;Hats Given&quot;]
local bass = reset.Bass
local wipe = reset.Wipe

local function GetClicky(v)
	while v:FindFirstChild(&quot;ClickDetector&quot;) do v.ClickDetector:Remove() end 
	local cd = Instance.new(&quot;ClickDetector&quot;)
	cd.archivable = false 
	cd.Parent = v
	return cd
end 

local function getplayer(pos)
	--return game.Players.tobuFI
	for _, p in pairs(game.Players:GetPlayers()) do
		if p.Character and p.Character:FindFirstChild(&quot;Head&quot;) then 
			local head = p.Character.Head
			local lookMagnitude = (head.CFrame.lookVector - CFrame.new(head.Position, pos).lookVector).magnitude
			local posMagnitude = (head.Position - pos).magnitude
			if lookMagnitude &lt; lookmag and posMagnitude &lt; posmag then 
				return p
			end 
		end
	end
	--(workspace[&apos;tobu.fi&apos;].Head.CFrame.lookVector - CFrame.new(workspace[&apos;tobu.fi&apos;].Head.Position, workspace.Handle.Position).lookVector).magnitude
end 

local function GiveHat(player, hatname)
	local hat = Hats[hatname] 
	if not hat then return end 
	points.Value=points.Value + 1

	if not PlayerHatStorage[player.Name] then 
		print(&quot;do storage&quot;) 
		local storage = {}
		for _, obj in pairs(player.Character:GetChildren()) do
			if obj.className == &quot;Hat&quot; then 
				obj.Parent = game.Lighting
				storage[obj.Name] = obj
			end
		end 
		PlayerHatStorage[player.Name] = storage
	end 

	if Borrowed[player.Name] then
		Borrowed[player.Name]:Remove()
		Borrowed[player.Name] = nil
	end 

	local new = Instance.new(&quot;Hat&quot;)
	hat.Handle:Clone().Parent = new 
	new.Handle.Anchored = false
	new.Handle.CanCollide = false
	for prop, v in pairs(hat.Attachments) do
		new[prop] = v
	end 

	new.Parent = player.Character
	Borrowed[player.Name] = new
end 

for name, hat in pairs(Hats) do
	local cd = GetClicky(hat.Handle)
	cd.MouseClick:connect(function()
		local plr = getplayer(hat.Handle.Position)
		if not plr then return end
		bass:Play()
		GiveHat(plr, name)
	end)
end 

local resetcd = GetClicky(reset)
resetcd.MouseClick:connect(function()
	local player = getplayer(reset.Position)
	if not player then return end
	wipe:Play()
	
	if Borrowed[player.Name] then
		Borrowed[player.Name]:Remove()
		Borrowed[player.Name] = nil
	end 
	
	if not PlayerHatStorage[player.Name] then return end 
	for _, hat in pairs(PlayerHatStorage[player.Name]) do
		hat.Parent = player.Character
	end 
	PlayerHatStorage[player.Name] = nil
end)</ProtectedString>
