							<string name="Name">Script</string>
							<ProtectedString name="Source">local function WaitForChild(where, what)
	while not where:FindFirstChild(what) do wait() end
	return where:FindFirstChild(what)
end 

local tool = script.Parent
local Target = WaitForChild(tool, &quot;Target&quot;)
local sizeLimit = Vector3.new(4, 4, 4)
local tagName = &quot;IsNameTag&quot;

local GUI = WaitForChild(tool, &quot;NameToolGUI&quot;)
local TextBox = WaitForChild(GUI, &quot;TextBox&quot;)

local function isNotBig(obj)
	return true -- TODO
end 

tool.Activated:connect(function(mouse)
	print(&quot;BREP&quot;)
	local obj = Target.Value
	if (obj == nil) or (obj.Parent == nil) then print(&quot;NO&quot;) return end 
	if obj.className ~= &quot;BasePart&quot; and obj.Name == &quot;Terrain&quot; then print(&quot;TERRAIN&quot;) return end 
	if game.Players:GetPlayerFromCharacter(obj.Parent) then print(&quot;CHARACTER&quot;) return end 
	if obj.Locked == true then print(&quot;LOCKED&quot;) return end 

	local tag = obj:FindFirstChild(tagName)
	local model = obj.Parent
	if model == workspace and tag then tag:Remove() print(&quot;WAT&quot;) return end -- why is there a tag in workspace
	if tag and model.className == &quot;Model&quot; then 
		-- is already a thing
		-- if textbox == &quot;&quot; or &quot; &quot;, remove
		if TextBox.Text == &quot;&quot; or TextBox.Text == &quot; &quot; then 
			print(&quot;KILL&quot;)
			game.Debris:AddItem(model, 2)
			model.Head.Parent = workspace
			return
		end 
	else print(&quot;CREATE&quot;)
		if TextBox.Text == &quot;&quot; or TextBox.Text == &quot; &quot; then return end 
		model = Instance.new(&quot;Model&quot;)
		model.Parent = workspace

		local human = Instance.new(&quot;Humanoid&quot;)
		human.MaxHealth, human.Health = 0, 0
		human.Parent = model

		tag = Instance.new(&quot;IntValue&quot;)
		tag.Name = tagName
		tag.Parent = obj

		obj.Name = &quot;Head&quot;
		obj.Parent = model
	end 

	print(&quot;APPLY&quot;)
	model.Name = TextBox.Text
end) </ProtectedString>
