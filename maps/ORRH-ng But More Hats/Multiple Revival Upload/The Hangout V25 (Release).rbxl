				<Item class="Script" referent="RBX2640">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">TNT Picnic Script</string>
						<ProtectedString name="Source">while script.Parent:FindFirstChild(&quot;Humanoid&quot;) do script.Parent.Humanoid:Remove() end
local hm = Instance.new(&quot;Humanoid&quot;)
hm.archivable = false
hm.Health, hm.MaxHealth = 0, 0
hm.Parent = script.Parent

local talking = false
local dialogue = &quot;Unfortunately, these are duds...&quot;
for _,v in pairs(script.Parent:GetChildren()) do
	if v.className == &quot;Part&quot; then 
		while v:FindFirstChild(&quot;ClickDetector&quot;) do v.ClickDetector:Remove() end 
		local cd = Instance.new(&quot;ClickDetector&quot;)
		cd.archivable = false 
		cd.Parent = v
		cd.MouseClick:connect(function()
			if talking then return end 
			talking = true 
			script.Parent.Name = dialogue
			wait(4)
			script.Parent.Name = &quot;&quot;
			talking = false
		end)
	end
end </ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
