							<ProtectedString name="Source">-- This brings me pain. You need this for servers. Because apparently, I angered the gods.
-- Trust me, kid. Don&apos;t go too deep in the rabbit hole.

repeat wait() until script.Parent:FindFirstChild(&quot;Target&quot;)
local bool = script.Parent.Target

repeat wait() until script.Parent:FindFirstChild(&quot;NameToolGUI&quot;)
local GUI = script.Parent.NameToolGUI

event = nil
event2 = nil

script.Parent.Equipped:connect(function(mouse)
	GUI.Parent = game.Players.LocalPlayer.PlayerGui
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	event = mouse.Button1Down:connect(function()
		--if bool.Value ~= Vector3.new(0, 0, 0) then return end 
		mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;
		wait(1)
		mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
		--local cf = mouse.Hit
		--local v = cf.lookVector
		
		delay(2, function()
			mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
		end)
		--wait(2.01)
		
		--mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
		--bool.Value = Vector3.new(0, 0, 0)
	end)
	event2 = mouse.Move:connect(function()
		bool.Value = mouse.Target
	end)
end)

script.Parent.Unequipped:connect(function()
	GUI.Parent = script.Parent
	if event then event:disconnect() end
	if event2 then event2:disconnect() end
	event = nil
	event2 = nil
end)</ProtectedString>
