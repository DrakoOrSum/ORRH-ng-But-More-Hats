				<Item class="Script" referent="RBX3704">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">SlidingDoorScript</string>
						<ProtectedString name="Source">for _,v in pairs(script.Parent.Doors:GetChildren()) do v.CFrame = v.Origin.Value end
-- CFrame.new(-1,0,0)

-- opened; .5; close; .25
local sound = script.Parent.SoundOrigin.Ping

local Doors = script.Parent.Doors
local Triggers = script.Parent.Triggers
local Open = false 
local Touched = tick()
local Timer = 2
local incr = .5

for _, trigger in pairs(Triggers:GetChildren()) do
	trigger.Touched:connect(function()
		Touched = tick() + Timer
		if Open then return end
		Open = true 

		sound.Pitch = 0.5
		sound:Play()

		local door = Doors.Door -- random
		while door.CFrame.x &lt; door.Result.Value.x do
			for _, door in pairs(Doors:GetChildren()) do door.CFrame = door.CFrame * CFrame.new(-incr, 0, 0) end
			wait()
		end

		wait(Timer)
		while Touched &gt; tick() do
			wait()
		end

		Open=false
		sound.Pitch = 0.25
		sound:Play()

		while door.CFrame.x &gt; door.Origin.Value.x do 
			if Open then return end 
			for _, door in pairs(Doors:GetChildren()) do door.CFrame = door.CFrame * CFrame.new(incr, 0, 0) end
			wait()
		end
		--for _,v in pairs(script.Parent.Doors:GetChildren()) do v.CFrame = v.Origin.Value end
		
	end)
end </ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
