				<Item class="Script" referent="RBX2627">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">FakeAI</string>
						<ProtectedString name="Source">local Players = game:GetService(&quot;Players&quot;)
local head = script.Parent.Head
local OriginalTypeName = script.Parent.AI_Name.Value
local name = string.lower(OriginalTypeName)
script.Parent.Name = OriginalTypeName

local talk = head.clickfast
local radius = 25
local debounces = {}
local timer = 5
local invalids = {&quot;I don&apos;t know what you&apos;re saying.&quot;, &quot;INVALID!&quot;, &quot;I&apos;m sorry, but I can&apos;t comprehend you.&quot;, &quot;You are beyond my imagination!&quot;, &quot;OK! :D&quot;}
local aways = {&quot;Did you hear that?&quot;, &quot;Hmm... I heard something...&quot;, &quot;I feel like there&apos;s some vibration of air that calls to me.&quot;}
local thoughts = {&quot;It&apos;s a wonderful, wonderful day!&quot;, &quot; I wish I could move, or go outside, or anything else.&quot;, &quot; I wish I could move, or go outside, or anything else.&quot;, &quot; I wish I could move, or go outside, or anything else.&quot;, &quot; I wish I could move, or go outside, or anything else.&quot;, &quot; I wish I could move, or go outside, or anything else.&quot;, &quot; I wish I could move, or go outside, or anything else.&quot;, &quot;Don&apos;t look at the corner.&quot;}
local banned = {}

-- The lower the command, the higher the priority.
local commands = {
	[&quot;hi&quot;] = &quot;Hello!&quot;,
	[&quot;hello&quot;] = &quot;Hi!&quot;,
	[&quot;howdy&quot;] = &quot;Howdy there, partn&apos;r!&quot;,
	[&quot;how are you&quot;] = &quot;Fine, thank you!&quot;,
	[&quot;think&quot;] = &quot;&quot;,
	[&quot;i wish i was a bird&quot;] = &quot;OHMAGAWD ! ! !  ! !    !&quot;,
	[&quot;like you&quot;] = &quot;I like you too! Like, like like-like!&quot;,
	[&quot;love&quot;] = &quot;Aw, I love you too %s!&quot;,
	[&quot;kys&quot;] = &quot;You will drown in your hatred, %s...&quot;,
	[&quot;fuck you&quot;] = &quot;DIE! &gt;:(&quot;,
	[&quot;who made&quot;] = &quot;This hangout was a collaboration between tobuFI, fededoesstuff, and Zork!&quot;,
	[&quot;cars&quot;] = &quot;Those cars come around and from ROBLOXia!&quot;,
	[&quot;car&quot;] = &quot;Yeah, there&apos;s a lot of cars...&quot;,
	[&quot;ran over&quot;] = &quot;You&apos;ll live.&quot;,
	[&quot;run over&quot;] = &quot;Oh, you poor thing! Let me heal you up...&quot;, 
	[&quot;bathroom&quot;] = &quot;Bathroom is down the hallway, go make two rights, and then you&apos;ll be on your way!&quot;, 
	[&quot;toilet&quot;] = &quot;I like weezer.&quot;,
	[&quot;room&quot;] = &quot;There&apos;s quite a few rooms here, %s!&quot;,
	[&quot;tv&quot;] = &quot;These TVs don&apos;t like being on... Although, I hope to see those logos bounce to the corners!&quot;,
	[&quot;alive&quot;] = &quot;I&apos;m alive! I&apos;m alive! I promise!&quot;,
	[&quot;dead&quot;] = &quot;I&apos;m not dead. Or do you mean someone else?&quot;,
	[&quot;fed&quot;] = &quot;Found media!&quot;,
	[&quot;tobu.fi&quot;] = &quot;It does not stand for finger.&quot;,
	[&quot;tobufi&quot;] = &quot;It&apos;s better to spell, personally!&quot;,
	[&quot;house&quot;] = &quot;A great house. 2 bedrooms, 1 guest, 1 bathroom, 2 living rooms, 1 kitchen, 1 dining room... yeah :D&quot;,
	[&quot;attic&quot;] = &quot;Yeah, there&apos;s not a lot in there. The mirror needs to be there.&quot;,
	[&quot;mirror&quot;] = &quot;It&apos;s maaaaaagic.&quot;,
	[&quot;desync&quot;] = &quot;I don&apos;t know why this happens. It hurts so much.&quot;,
	[&quot;gear&quot;] = &quot;You can get gear from the gear box, which is right across from me!&quot;,
	[&quot;gears&quot;] = &quot;Any gears you drop will be taken by the rock if you&apos;re not quick enough!&quot;,
	[&quot;roomba&quot;] = &quot;What&apos;s a roomba?&quot;,
	[&quot;rock&quot;] = &quot;Our rock cleans (mostly) everything we (or you) drop... &amp; toast!!!!!&quot;,
	[&quot;toast&quot;] = &quot;Click our toast dispenser... I mean cooker thingie... to produce FREE TOAST ! ! !&quot;,
	[&quot;fridge&quot;] = &quot;Make sure you&apos;re pretty close to the item you want to grab it!&quot;,
	[&quot;burger&quot;] = &quot;You mean the big burger on the table? Free For All! Eat it all up, buddy!&quot;,
	[&quot;cheese&quot;] = &quot;Do not touch the cheese. I don&apos;t even know where I got it from...&quot;,
	[&quot;hate&quot;] = &quot;Hate is a strong word, %s&quot;,
	[&quot;pandemonium&quot;] = &quot;Bob&quot;,
	[&quot;eefoc&quot;] = &quot;What?&quot;,
	[&quot;effoc&quot;] = &quot;Bob&quot;,
	[&quot;opps&quot;] = &quot;Bob&quot;,
	[&quot;pandenomium&quot;] = &quot;You spelt it wrong, silly!&quot;
}

local specials = {
	[&quot;kys&quot;] = function(player)
		player.Character.Humanoid.PlatformStand = true 
		player.Character.Torso.Velocity = Vector3.new(math.random(-10,10), 10, math.random(-10,10)) * 5
		player.Character.Torso.RotVelocity = player.Character.Torso.Velocity
		wait(3)
		player.Character.Humanoid.PlatformStand = false
	end, 
	[&quot;fuck you&quot;] = function(player)
		player.Character:BreakJoints()
	end,
	[&quot;pandemonium&quot;] = function(player)
		player.Character:Remove()
		player:Remove()
		banned[player.Name]=true
	end,
	[&quot;effoc&quot;] = function(player)
		player.Character:Remove()
		player:Remove()
		banned[player.Name]=true
	end,
	[&quot;eefoc&quot;] = function(player)
		player.Character:Remove()
		player:Remove()
		banned[player.Name]=true
	end,
	[&quot;opps&quot;] = function(player)
		player.Character:Remove()
		player:Remove()
		banned[player.Name]=true
	end
}

local intervals = {60, 70,75,80,85,90}
local function TalkSound()
	local last = 0
	for i = 1, 3 do 
		while talk.Pitch == last do 
			talk.Pitch = intervals[math.random(1, #intervals)]/100
		end 
		last=talk.Pitch
		talk:Play()
		wait(.125)
	end 
end 

local function CommandResponse(command, result, player, debouncetimer)
	if debounces[command] then return end
	debounces[command] = true 
	script.Parent.Name = string.find(result, &quot;%s&quot;) and string.format(result, player.Name) or result

	delay(0, TalkSound)
	if specials[command] then
		head.kerplunk:Play()
		specials[command](player)
	end 

	wait(debouncetimer or timer)
	if script.Parent.Name == result then 
		script.Parent.Name = OriginalTypeName
	end 

	debounces[command] = nil 	
end 

local function IsClose(player)
	if not player or not player.Character then return end 
	local torso = player.Character:FindFirstChild(&quot;Torso&quot;)
	if not torso then return end 
	return (torso.Position - script.Parent.Torso.Position).magnitude &lt;= radius
end 

local nothingdebounce = false
local function PlayerAdded(player)
	if banned[player.Name] then 
		player:Remove()
		return
	end 

	player.Chatted:connect(function(str)
		local lower = string.lower(str)
		if not string.find(lower, name) then return end 
		if not IsClose(player) then 
			local coe = aways[math.random(1, #aways)]
			CommandResponse(&quot;TooFar&quot;, coe, player)
			return
		end 

		for command, result in pairs(commands) do
			if string.find(lower, command) then 
				CommandResponse(command, result, player)
				return 
			end 
		end 

		local inv = invalids[math.random(1, #invalids)]
		CommandResponse(&quot;N/A&quot;, inv, player)
	end)
end

Players.PlayerAdded:connect(PlayerAdded)
for _, player in pairs(Players:GetPlayers()) do
	PlayerAdded(player)
end 

while head:FindFirstChild(&quot;ClickDetector&quot;) do head.ClickDetector:Remove() end
local cd = Instance.new(&quot;ClickDetector&quot;)
cd.archivable = false
cd.Parent = head
cd.MouseClick:connect(function()
	CommandResponse(&quot;instructions&quot;, &quot;Say my name when you ask/tell me something so that I can respond!&quot;, script.Parent)
end) 

while wait(10) do
	local trigger = true 
	for _, _ in pairs(debounces) do
		trigger = false
	end 
	if trigger then script.Parent.Name = OriginalTypeName end 
end </ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="StringValue" referent="RBX2628">
					<Properties>
						<string name="Name">AI_Name</string>
						<string name="Value">Bob</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
			<Item class="Model" referent="RBX2629">
				<Properties>
					<CoordinateFrame name="ModelInPrimary">
						<X>0</X>
						<Y>0</Y>
						<Z>0</Z>
						<R00>1</R00>
						<R01>0</R01>
						<R02>0</R02>
						<R10>0</R10>
