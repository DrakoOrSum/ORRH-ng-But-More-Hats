					<Item class="Script" referent="RBX1940">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">DuckClickScript</string>
							<ProtectedString name="Source">local click = script.Parent.Click

local duck = script.Parent

while duck:FindFirstChild(&quot;ClickDetector&quot;) do duck.ClickDetector:Remove() end
local cd = Instance.new(&quot;ClickDetector&quot;)
cd.archivable = false 
cd.Parent = duck

local debounce = false
cd.MouseClick:connect(function()
	if debounce then return end 
	debounce=true
	script.Parent.Clicked.Value = script.Parent.Clicked.Value + 1
	click:Play()
	duck.Mesh.Scale = Vector3.new(1,.95,1)
	wait(.3)
	click:Stop()
	duck.Mesh.Scale = Vector3.new(1,1,1)
	--wait(.5)
	debounce=false
end)</ProtectedString>
