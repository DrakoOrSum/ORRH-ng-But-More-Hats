					<Item class="Script" referent="RBX799">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">PoseScript</string>
							<ProtectedString name="Source">local TIX = &quot;http://www.roblox.com/asset/?id=19354292&quot;
local function InsertDecals(obj)
	local up, down = Instance.new(&quot;Decal&quot;, obj), Instance.new(&quot;Decal&quot;, obj)
	up.archivable, down.archivable = false, false
	up.Texture, down.Texture = TIX, TIX
	up.Face = &quot;Top&quot;
	down.Face = &quot;Bottom&quot;
end 

local seats = {}
for _, v in pairs(script.Parent:GetChildren()) do 
	local pose = v:FindFirstChild(&quot;Pose&quot;) or v:FindFirstChild(&quot;&quot;)
	local chair = v:FindFirstChild(&quot;Seat&quot;)
	local content = v:FindFirstChild(&quot;Content&quot;)
	if v ~= script and pose and chair then 
		table.insert(seats, v)
		pose.Name = &quot;Pose&quot;
		for _,v in pairs(pose:GetChildren()) do
			if v.className ~= &quot;Part&quot; then v:Remove() 
			else
				v.Anchored = true 
				v.Transparency = 1
				v.CanCollide = false
				for _,j in pairs(v:GetChildren()) do j:Remove() end 
			end 
		end 

		if content then
			for _, j in pairs(content:GetChildren()) do
				j.CanCollide = false
				j.Anchored = true 
				j.Transparency = 1
			end 
		end 
	end 
end 

local function worldCFrameRotationToC1(motor6DJoint, worldCFrame)
	local part0 = motor6DJoint.Part0
	local c0Store = motor6DJoint.C0
			
	return worldCFrame:inverse() * part0.CFrame * c0Store 
end

local function Main(seat)
	local storage = {}
	local pose = seat:FindFirstChild(&quot;Pose&quot;) or seat:FindFirstChild(&quot;&quot;)
	local sitting = false 

	seat.Seat.ChildAdded:connect(function(obj)
		if obj.Name ~= &quot;SeatWeld&quot; then return end 
		local torso = obj.Part1
		if not torso then return end 
		local player = game.Players:GetPlayerFromCharacter(torso.Parent)
		if not player then return end 
		if sitting then return end 

		sitting = true
		local character = player.Character
		local extra = {}
		local hats ={}

		local headweld = Instance.new(&quot;Weld&quot;)
		headweld.Part0 = pose.Head
		headweld.Part1 = pose.Torso
		headweld.C0 = pose.Head.CFrame * pose.Torso.CFrame:inverse()
		headweld.Parent = pose.Head 
		pose.Head.Anchored = false

		for _,v in pairs(character:GetChildren()) do
			if v.className ~= &quot;Part&quot; and v.className ~= &quot;Hat&quot; and v.className ~= &quot;Script&quot; and v.className ~= &quot;LocalScript&quot; then 
				local cl = v:Clone()
				table.insert(extra, cl)
				cl.Parent = pose
			elseif v.className == &quot;Part&quot; then 
				v.Transparency = 1
				v.Anchored = true 
			elseif v.className == &quot;Hat&quot; then
				v.Parent = pose
				table.insert(hats, v)
			end 
		end 

		local mesh = character.Head.Mesh:Clone()
		mesh.Parent = pose.Head
		table.insert(extra, mesh)

		local face = character.Head.face:Clone()
		face.Parent = pose.Head
		table.insert(extra, face)
		character.Head.face.Face = &quot;Bottom&quot;

		pose.Humanoid.Health = 0
		pose.Humanoid.MaxHealth = 0
		pose.Name = &quot;&quot;
		
		for _, p in pairs(pose:GetChildren()) do 
			if p.className == &quot;Part&quot; then 
				p.Transparency = 0
				p.CanCollide = false
			end
		end

		local content = seat:FindFirstChild(&quot;Content&quot;)
		if content then
			for _,v in pairs(content:GetChildren()) do
				v.Transparency = 0
				if v.Name == &quot;TIX&quot; then 
					InsertDecals(v)
				end 
			end 
		end 

		repeat wait() until obj.Parent == nil or player.Parent == nil or character.Parent == nil or (not character:FindFirstChild(&quot;Humanoid&quot;)) or character.Humanoid.Health &lt;= 0

		for _, p in pairs(pose:GetChildren()) do 
			if p.className == &quot;Part&quot; then 
				p.Transparency = 1 
				p.CanCollide = false 
			end
		end

		for _,v in pairs(extra) do v:Remove() end 
		if hats then 
			for _,v in pairs(hats) do 
				v.Parent = character 
			end
		end 

		for _,v in pairs(character:GetChildren()) do 
			if v.className == &quot;Part&quot; then 
				v.Transparency = 0
				v.Anchored = false
			end
		end

		if content then
			for _,v in pairs(content:GetChildren()) do
				v.Transparency = 1
				v.CanCollide = false 
				if v.Name == &quot;TIX&quot; then 
					for _, j in pairs(v:GetChildren()) do j:Remove() end
				end 
			end 
		end 

		pose.Name = &quot;Pose&quot;
		pose.Head.Anchored = true
		headweld:Remove()
		character.Head.face.Face = &quot;Front&quot;
		sitting = false
	end)
end 

for _, seat in pairs(seats) do 
	Main(seat)
end 
