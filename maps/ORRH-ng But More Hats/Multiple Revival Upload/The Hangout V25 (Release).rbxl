					<Item class="Script" referent="RBX4634">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">FightRespawn</string>
							<ProtectedString name="Source">local Players = game:GetService(&quot;Players&quot;)
local spawns = {}
for _,v in pairs(script.Parent:GetChildren()) do if v.className == &quot;Part&quot; then table.insert(spawns, v) end end 

local function added(plr, chr)
	local tag = plr:FindFirstChild(&quot;Fighting&quot;)
	if not tag then return end 

	while plr:FindFirstChild(&quot;Fighting&quot;) do plr.Fighting:Remove() end 
	local spawn = spawns[math.random(1, #spawns)]
	
	while (chr.Torso.Position - spawn.Position).magnitude &gt; 10 do wait()
		print(&quot;MOVE&quot;)
		chr:MoveTo(spawn.Position) --chr.Torso.CFrame = spawn.CFrame * CFrame.new(0, 5, 0)
	end 

	wait(1.337)
	if chr:FindFirstChild(&quot;ForceField&quot;) then chr.ForceField:Remove() end 
end 

Players.PlayerAdded:connect(function(plr)
	plr.CharacterAdded:connect(function(chr)
		added(plr, chr)
	end) 
end)

for _, p in pairs(Players:GetPlayers()) do 
	p.CharacterAdded:connect(function(chr) added(p, chr) end)
end </ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
				</Item>
