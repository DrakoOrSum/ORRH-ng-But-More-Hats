					<Item class="Script" referent="RBX441">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">GiveCameraScript</string>
							<ProtectedString name="Source">local Cameras = workspace.Hangout.Cameras
local ResetCameraScript = script.ResetCameraScript
local CameraTool = script.Camera

script.Parent.Seat.ChildAdded:connect(function(obj)
	if obj.Name ~= &quot;SeatWeld&quot; then return end 
	local torso = obj.Part1
	if not torso then return end 
	local player = game.Players:GetPlayerFromCharacter(torso.Parent)
	if not player then return end 
	local character = torso.Parent
	local tool = CameraTool:Clone()
	tool.Parent = player.Backpack
	repeat wait() until obj.Parent == nil or player.Parent == nil or character.Parent == nil or (not character:FindFirstChild(&quot;Humanoid&quot;)) or character.Humanoid.Health &lt;= 0

	if tool.Parent then
		tool:Remove()
	end

	for _,v in pairs(Cameras:GetChildren()) do
		for _,j in pairs(v:GetChildren()) do
			if j.className == &quot;Part&quot; then j:Remove() end
		end 
	end 

	if not player then return end 
	ResetCameraScript:Clone().Parent = player.PlayerGui--.Backpack
end)
</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="HopperBin" referent="RBX442">
							<Properties>
								<bool name="Active">false</bool>
								<token name="BinType">0</token>
								<string name="Name">Camera</string>
								<Content name="TextureId"><null></null></Content>
								<bool name="archivable">true</bool>
							</Properties>
							<Item class="LocalScript" referent="RBX443">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">LocalCameraScript</string>
									<ProtectedString name="Source">local player = game.Players.LocalPlayer
local cameras = workspace.Hangout.Cameras
local currentcamera = workspace.CurrentCamera
local bin = script.Parent

local piece = nil
local msg = Instance.new(&quot;Message&quot;)
local hint = Instance.new(&quot;Hint&quot;)
hint.Text = &quot;A/D to turn; Q/E to switch cameras&quot;

local spots = {}
local focus = 1
for _, camera in pairs(cameras:GetChildren()) do
	table.insert(spots, camera)
end 

function Update(up)
	focus=focus+(up or 1)
	--print(&quot;spots&quot;, #spots)
	if focus &lt;= 0 then focus = #spots
	elseif focus &gt; #spots then focus=1 end 
	local camera = spots[focus]
	msg.Text = string.format(&quot;Camera %d/%d&quot;, focus, #spots)

	if piece then 
		piece:Remove()
	end 

	piece = Instance.new(&quot;Part&quot;)
	piece.Size = Vector3.new(1,1,1)
	piece.Anchored = true 
	piece.CanCollide = false 
	piece.Locked = true 
	piece.archivable = false
	piece.Transparency = 1 
	piece.Parent = camera
	keydown(&quot;&quot;, 0)

	--print(&quot;Updated Camera&quot;, focus)
	currentcamera.CameraSubject = piece--camera
	currentcamera.CameraType = &quot;Attach&quot;
end 

function keydown(k, n)
	if k == &quot;q&quot; then 
		Update(-1)
		return
	elseif k==&quot;e&quot; then 
		Update()
		return
	end 

	local camera = spots[focus]
	local trig = n or nil
	if string.lower(k) == &quot;d&quot; then trig=10
	elseif string.lower(k)  == &quot;a&quot; then trig=-10 end 
	if not trig then return end 
	camera.CFrame = camera.CFrame * CFrame.Angles(0, math.rad(trig), 0)
	if piece then 
		local look = camera.CFrame.lookVector * 4
		piece.CFrame = camera.CFrame + look - Vector3.new(0, 2, 0)
	end
end 

bin.Selected:connect(function(m)
	Update(0)
	m.Button1Down:connect(function()
		Update()
	end)

	m.KeyDown:connect(keydown)
	msg.Parent = player
	hint.Parent = player
end) 

bin.Deselected:connect(function()
	if piece then piece:Remove() piece=nil end 
	currentcamera.CameraSubject = player.Character.Humanoid
	currentcamera.CameraType = &quot;Custom&quot;
	msg.Parent = nil
	hint.Parent = nil 
end) 

coroutine.resume(coroutine.create(function()
	while bin.Parent and bin.Parent.Parent and bin.Parent.Parent.Parent do wait() end 
	currentcamera.CameraSubject = player.Character.Humanoid
	currentcamera.CameraType = &quot;Custom&quot;
	if msg.Parent then msg:Remove() end
	msg = nil
end))</ProtectedString>
									<bool name="archivable">true</bool>
								</Properties>
							</Item>
						</Item>
						<Item class="LocalScript" referent="RBX444">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">ResetCameraScript</string>
								<ProtectedString name="Source">local player = game.Players.LocalPlayer
local currentcamera = workspace.CurrentCamera
currentcamera.CameraSubject = player.Character.Humanoid
currentcamera.CameraType = &quot;Custom&quot;

while player:FindFirstChild(&quot;Message&quot;) do 
	player.Message:Remove()
end 

while player:FindFirstChild(&quot;Hint&quot;) do 
	player.Hint:Remove()
end 

script:Remove()</ProtectedString>
