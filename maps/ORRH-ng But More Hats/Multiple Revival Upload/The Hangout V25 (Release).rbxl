				<Item class="LocalScript" referent="RBX2832">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Torture</string>
						<ProtectedString name="Source">local player = game.Players.LocalPlayer
local character = player.Character
if not character:FindFirstChild(&quot;Torso&quot;) then 
	script:Remove()
	return 
end 

character.Parent = workspace.CurrentCamera
local dark = script:FindFirstChild(&quot;Dark&quot;)
if dark then dark.Parent = script.Parent end 

local motors = {}
local archive = {}
for _, motor in pairs(character.Torso:GetChildren()) do 
	if motor.className == &quot;Motor6D&quot; then 
		table.insert(motors, motor)
		archive[motor.Name] = motor.C0
	end 
end 

local function Mangle()
	for _, motor in pairs(motors) do 
		local cf = CFrame.new(math.random(), math.random(), math.random())
		local angle = CFrame.Angles(math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180))) -- change to EularAngles if does not exist
		motor.C0 = cf * angle
	end 
end 

local burstrounds = 10
local library = {&quot;clickfast&quot;, &quot;bass&quot;, &quot;kerplunk&quot;, &quot;swordslash&quot;}
local function SoundBurst()
	local id = library[math.random(1, #library)]
	for i = 1, burstrounds do 
		local s = Instance.new(&quot;Sound&quot;)
		game.Debris:AddItem(s, 10)
		s.Pitch = math.random(10,30)/100
		s.SoundId = string.format(&quot;rbxasset://sounds/%s.wav&quot;, id)
		s.Parent = script 
		s:Play() 
		wait()
	end 
end 

local barrier = game.Lighting.Barrier:Clone()
barrier.Parent = workspace.CurrentCamera

-- Temporary; may add barriers
for i = 1, 120 do 
	wait(.25)
	local chance = math.random(1,3) 
	Mangle()
	SoundBurst()
	if chance ~= 1 then SoundBurst() end
	if chance == 2 then wait() Mangle() end 
	if character.Humanoid.Health &lt;= 0 then break end 
end 

-- transition back visually 
character.Parent = workspace
if workspace.CurrentCamera:FindFirstChild(&quot;Fog&quot;) ~= nil then
	workspace.CurrentCamera.Fog:Remove()
end

for _, motor in pairs(motors) do 
	motor.C0 = archive[motor.Name]
end 

if dark then dark:Remove() end 
barrier:Remove()
script:Remove()
</ProtectedString>
