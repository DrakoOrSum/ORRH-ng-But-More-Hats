					<Item class="Script" referent="RBX3243">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Fridge Door Script</string>
							<ProtectedString name="Source">local closed = script.Parent.Closed
local opened = script.Parent.Opened

-- hide closed door below
local function action(d,cf)
	for _,v in pairs(d:GetChildren()) do
		v.Transparency = (v.Transparency == 1) and 0 or 1
		v.CanCollide = not v.CanCollide
		if cf then v.CFrame = v.CFrame * cf end
	end 
end 

local state = script.Parent.State

for i,v in pairs({closed, opened}) do
	for _, p in pairs(v:GetChildren()) do 
		while p:FindFirstChild(&quot;ClickDetector&quot;) do p.ClickDetector:Remove() end 
		local cd = Instance.new(&quot;ClickDetector&quot;)
		cd.archivable = false 
		cd.Parent = p
		cd.MouseClick:connect(function()
			if state.Value == true and v == opened then 
				-- close
				action(closed, CFrame.new(0,20,0))
				action(opened)
				state.Value = false
			elseif state.Value == false and v == closed then 
				-- open
				action(closed, CFrame.new(0, -20, 0))
				action(opened)
				state.Value = true
			end 
		end)
	end 
end </ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
