					<Item class="Script" referent="RBX2437">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Faucet Script</string>
							<ProtectedString name="Source">local cold, hot = script.Parent.Cold, script.Parent.Hot

local water = script.Parent.Water

for _,v in pairs({cold, hot}) do
	local running = false
	local cd = Instance.new(&quot;ClickDetector&quot;)
	cd.archivable = false 
	cd.Parent = v
	cd.MouseClick:connect(function()
		v.Drip.Transparency = (running == true) and 1 or 0.5
		running = not running
	end)
	v.Drip.Transparency = 1
	v.Drip.CanCollide = false
end 

-- TODO
-- add sounds?
-- up/down the water part
-- make water flow out if both are on</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
