							<R20>-1</R20>
							<R21>0</R21>
							<R22>0</R22>
						</CoordinateFrame>
						<string name="Name">Surface Tool</string>
						<Content name="TextureId"><url>https://www.roblox.com/asset/?id=16178704</url></Content>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="Part" referent="RBX5871">
						<Properties>
							<bool name="Anchored">false</bool>
							<float name="BackParamA">-0.5</float>
							<float name="BackParamB">0.5</float>
							<token name="BackSurface">0</token>
