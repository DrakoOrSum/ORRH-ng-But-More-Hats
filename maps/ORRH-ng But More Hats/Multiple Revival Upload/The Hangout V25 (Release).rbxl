		<Item class="Script" referent="RBX6071">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">TextLabel</string>
				<ProtectedString name="Source">--local str = &quot;command list^n!hide (building/cart/all)^w- gets rid of tools^w- from backpack^n!show (building/cart/all)^w- gives tools back^w- to your backpack^n!rotate (2.0-360.0)^w- changes increment^w- of rail rotation^n!shift (0.125-5.0)^w- changes increment^w- of rail shifting^n!style^w- toggles between^w- two moving styles^w- (free VS. strict)&quot;
local str = &quot;zoo wee mama&quot; --&quot;Fail&quot;--&quot;todo list^n- scary corner tp^w- day/night cycle with functional lights^w- images on wall^w- talk to bob^w- security cameras^w- mini rollercoaster around the map^w- mirror in attic^w- fix swingset spawning&quot;
--local str = &quot;if you were a noob^wthen i would be dead^wbecause you are not a^wnoob&quot;
local let = game.Lighting.Letters

local words = {{}}
local spaces = {}
local origin = workspace.CurrentCamera.CoordinateFrame * CFrame.new(workspace.CurrentCamera.Focus.lookVector*10) 
origin = CFrame.new(origin.p, workspace.CurrentCamera.CoordinateFrame.p) * CFrame.Angles(math.rad(-90),0, 0)
local current = origin
local tab = false
for i = 1, #str do 
	local x = string.sub(str, i, i)
	if x==&quot;^&quot; then 
		tab = true 
	elseif tab and (x==&quot;n&quot; or x==&quot;w&quot;) then 
		current = origin * CFrame.new(0, 0, (x==&quot;n&quot;) and -2 or -1.2)
		origin = current
		words[#words+1] = {}
	elseif x==&quot;-&quot; then 
		local dash = let.I:Clone()
		dash.Name = &quot;DASH&quot;
		local new = current*CFrame.new(dash.Size.x*-1, 0, 0)
		current = new
		dash.CFrame = new
		table.insert(words[#words], dash)
	elseif x == &quot;/&quot; then
		local slash = let.I:Clone()
		slash.Name = &quot;SLASH&quot;
		slash.Size = slash.Size + Vector3.new(0, 0, 1)
		local new = current*CFrame.new(slash.Size.x*-1, 0, 0)
		current = new
		slash.CFrame = new
		table.insert(words[#words], slash)
	else
		tab = false 
		if x ~= &quot; &quot; then 
			local n = let:FindFirstChild(string.upper(x))
			if n then 
				local a = n:Clone()
				local new = current*CFrame.new(n.Size.x*-1, 0, 0)
				current = new
				a.CFrame = new
				table.insert(words[#words], a) --a.Parent = words[#words]
			end
		else 
			local space = let.SPACE:Clone()
			local new = current*CFrame.new(space.Size.x*-1, 0, 0)
			current = new
			space.CFrame = new
			table.insert(spaces, space)
			words[#words+1] = {}--Instance.new(&quot;Model&quot;)
		end 
	end 

end 

local model = Instance.new(&quot;Model&quot;)
model.Name = &quot;Test&quot;
model.Parent = script

local magn = (origin.p - words[#words][#words[#words]].Position).Magnitude

for _, word in pairs(words) do
	local wordModel = Instance.new(&quot;Model&quot;)
	wordModel.Name = &quot;&quot;
	for _, letter in pairs(word) do
		local n = nil
		if letter.Name == &quot;DASH&quot; then
			n=90
		elseif letter.Name == &quot;SLASH&quot; then
			n=-22.5
		end

		letter.CFrame=letter.CFrame*CFrame.new(magn/2,0,0) * CFrame.Angles(0,n and math.rad(n) or 0, 0)
		letter.Parent = wordModel
		wordModel.Name = wordModel.Name .. letter.Name
	end 
	wordModel.Parent = model
end </ProtectedString>
