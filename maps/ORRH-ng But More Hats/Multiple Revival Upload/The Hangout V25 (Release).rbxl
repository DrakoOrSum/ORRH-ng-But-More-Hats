					<Item class="Script" referent="RBX410">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">AtticMirrorScript</string>
							<ProtectedString name="Source">-- TODO
-- Apply new hat/tool positions depending on dropping
	-- Also just make tools show up in general
-- Fix the issue of the player jumping downwards (because of how you rotated; maybe rotate during AccuratePlacement rather than afterwards since it&apos;s technically facing the wrong direction)

function check(z, t)
	local tp=t.Position
	local ap= z.Position
	local as= z.Size
	local ax=(as.x+1)/2
	local ay=(as.y+1)/2
	local az=(as.z+1)/2
	local ax1=ap.x-ax
	local ax2=ap.x+ax
	local ay1=ap.y-ay
	local ay2=ap.y+ay
	local az1=ap.z-az
	local az2=ap.z+az
	if tp.x&gt;ax1 and tp.x&lt;ax2 and tp.y&gt;ay1 and tp.y&lt;ay2 and tp.z&gt;az1 and tp.z&lt;az2 then
		--print(&quot;TRIGGER!&quot;, t.Parent)
		return true
	else
		return false
	end
end

local Players = game:GetService(&quot;Players&quot;)
local trigger = script.Parent.MirrorTrigger
local mirror = script.Parent.Mirror
local avatar = script.Parent[&quot;Mirror Copy&quot;]
local reflections = {}

-- monitor anything added to character or removed, still monitor if child has been removed but has been deleted (liek a hat or tool) as long as they&apos;re in the trigger
local want= {BodyColors=true, Shirt=true, Pants=true, Hat=nil, CharacterMesh=true}
local attachments = {Forward=true, Pos=true, Right=true, Up=true}
local function CreateCopy(character)
	local copy = avatar:Clone()
	copy.Name = &quot;&quot;
	if character.Head:FindFirstChild(&quot;face&quot;) then character.Head.face:Clone().Parent = copy.Head end
	if character.Head:FindFirstChild(&quot;Mesh&quot;) then character.Head.Mesh:Clone().Parent = copy.Head end
	if character.Torso:FindFirstChild(&quot;roblox&quot;) then character.Torso.roblox:Clone().Parent = copy.Torso end 

	for _, obj in pairs(character:GetChildren()) do 
		if obj.className == &quot;Hat&quot; and obj:FindFirstChild(&quot;Handle&quot;) then 
			local hat = Instance.new(&quot;Hat&quot;)
			hat.Name = obj.Name
			for name, _ in pairs(attachments) do
				hat[&quot;Attachment&quot;..name]=obj[&quot;Attachment&quot;..name]
			end 
			obj.Handle:Clone().Parent = hat 
			hat.Parent = copy
		elseif want[obj.className] then 
			local tin = obj:Clone()
			tin.Parent = copy
		end 
	end 

	local headweld = Instance.new(&quot;Weld&quot;)
	headweld.Part0 = copy.Head
	headweld.Part1 = copy.Torso
	headweld.C0 = copy.Head.CFrame * copy.Torso.CFrame:inverse()
	headweld.Parent = copy.Head 
	copy.Head.Anchored = false
	
	return copy
end 

local function AccuratePlacement(cf)
	local origprimpartcf = mirror.CFrame
	local desiredcf = origprimpartcf * CFrame.Angles(math.rad(0), math.rad(0), math.rad(180)) * CFrame.new(0, .4, 0)-- FLIPPED!
	local offset = origprimpartcf:inverse() * cf
	return desiredcf * offset
end 

local function AdjustRotation(reflection)
	local origprimpartcf = reflection.Torso.CFrame
	local desiredcf = origprimpartcf * CFrame.Angles(0, 0, math.rad(180)) * CFrame.new(0,-.8,0) -- FLIPPED!
	for _, obj in pairs(reflection:GetChildren()) do
		if obj.className == &quot;Part&quot; then 
			local offset = origprimpartcf:inverse() * obj.CFrame
			obj.CFrame = desiredcf * offset	
		end 
	end 
end 

local function Update(reflection, character)
	for _, obj in pairs(reflection:GetChildren()) do
		local visible = character:FindFirstChild(obj.Name)
		if not visible then 
			if obj.className == &quot;Part&quot; then
				obj.Transparency = 1
			else obj:Remove() end 
		else
			if obj.className == &quot;Part&quot; then 
				obj.CFrame = AccuratePlacement(character[obj.Name].CFrame)
			elseif obj.className == &quot;Tool&quot; then 
				obj.Handle.CFrame = AccuratePlacement(character[obj.Name].Handle.CFrame)
			end 
		end
	end 

	--AdjustRotation(reflection)
	for _, obj in pairs(character:GetChildren()) do
		if (not reflection:FindFirstChild(obj.Name)) and obj:FindFirstChild(&quot;Handle&quot;) then 
			-- add new tool or hat to reflection, but make sure its noted as an &quot;extra&quot;
			local new = obj:Clone()
			if obj.className == &quot;Tool&quot; then 
				new.Handle.Anchored = true 
				for _, thing in pairs({new, new.Handle}) do 
					for _, v in pairs(thing:GetChildren()) do 
						if v.className ~= &quot;SpecialMesh&quot; and v.className ~= &quot;Part&quot; then v:Remove() end
					end 
				end 
			end
			new.Parent = reflection
		elseif obj.className == &quot;Part&quot; then
			reflection[obj.Name].Transparency = check(trigger, obj) and 0 or 1
		elseif obj:FindFirstChild(&quot;Handle&quot;) and reflection[obj.Name]:FindFirstChild(&quot;Handle&quot;) then 
			reflection[obj.Name].Handle.Transparency = check(trigger, obj.Handle) and 0 or 1
		end
	end 

	if not reflection.Parent then
		print(&quot;Turned on&quot;, character, &quot;Reflection&quot;)
		reflection.Parent = script.Parent
		reflection.archivable = false 
	end 
end 

local function GetPlayers()
	local users = {}
	for _, player in pairs(Players:GetPlayers()) do
		if player.Character and player.Character:FindFirstChild(&quot;Torso&quot;) and check(trigger, player.Character.Torso) then
			users[player.Name]=player.Character
		end 
	end 
	return users
end 

while script.Parent:FindFirstChild(&quot;&quot;) do script.Parent[&quot;&quot;]:Remove() end 
for _,v in pairs(avatar:GetChildren()) do
	for _, j in pairs(v:GetChildren()) do j:Remove() end
	if v.className == &quot;Part&quot; then 
		v.Transparency = 1 
		v.CanCollide = false
		v.Anchored = true 
	end 
end 

while wait(1/30) do 
	pcall(function() -- THE ULTIMATE JANK: WRAP EVERYTHING IN A PCALL AND CALL IT A DAY!
		local users = GetPlayers()
		for _, player in pairs(Players:GetPlayers()) do
			if reflections[player.Name] and not (users[player.Name] and player.Character and player.Character.Humanoid.Health &gt; 0) then 
				reflections[player.Name]:Remove()
				reflections[player.Name] = nil 
				-- if too intensive, parent to nil to be used later 
				print(&quot;Turned off&quot;, player.Name,&quot;Reflection&quot;)
			end 
		end 

		for name, user in pairs(users) do
			reflections[name] = reflections[name] or CreateCopy(user)
			Update(reflections[name], user)
		end 
	end)
end </ProtectedString>
