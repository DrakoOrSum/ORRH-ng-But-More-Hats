				<Item class="Script" referent="RBX2572">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local flow = script.Parent.Flow
local down, up = script.Parent.Down, script.Parent.Up
local state = (up.Transparency == 1) and down or up
for _,v in pairs({down, up}) do 
	while v:FindFirstChild(&quot;ClickDetector&quot;) do v.ClickDetector:Remove() end 
	local cd = Instance.new(&quot;ClickDetector&quot;, script.Parent)
	cd.archivable = false 
	cd.Parent = v
	cd.MouseClick:connect(function()
		if state then -- wants to go up
			state = false
			for _,f in pairs(flow:GetChildren()) do f.Transparency = 1 f.CanCollide = false end 
			up.Transparency = 0
			up.CanCollide = true
			down.Transparency = 1
			down.CanCollide = false
		else
			state=true
			for _,f in pairs(flow:GetChildren()) do f.Transparency = 0 f.CanCollide = false end 
			up.Transparency = 1
			up.CanCollide = false
			down.Transparency = 0
			down.CanCollide = true
		end 
	end)
end </ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
