							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Fog</string>
							<ProtectedString name="Source">--this was made by razorboot and modified a bit by rocket lol
-- made for the frozen over event; script slightly modified further by tobu.fi for 2010M hangout game (9/29/24)
-- local player = workspace.Player; for i = 1, 60 do wait(.1) for _,v in pairs(player.Torso:GetChildren()) do if v.className == &quot;Motor6D&quot; then print(v) v.C0 = CFrame.new(math.random(), math.random(), math.random()) * CFrame.Angles(math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180))) end end end

--wait for player
repeat wait() until game.Players.LocalPlayer
repeat wait() until game.Players.LocalPlayer.Character
repeat wait() until workspace.CurrentCamera

--reset fog
if workspace.CurrentCamera:FindFirstChild(&quot;Fog&quot;) ~= nil then
	workspace.CurrentCamera.Fog:Remove()
end

--waitforchild function
local function WaitForChild(where, what)
	repeat wait() until where:FindFirstChild(what)
	return where:FindFirstChild(what)
end
--------------------------------------------------------------------------
--# Services

local Players = game:GetService(&quot;Players&quot;)



--# Player

local Camera = workspace.CurrentCamera
local Player = Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local Humanoid = WaitForChild(Character, &quot;Humanoid&quot;)
local Head = WaitForChild(Character, &quot;Head&quot;)
local Torso = WaitForChild(Character, &quot;Torso&quot;)



--# Variables

local Distance = 0 -- The starting size of each Fog Part
local Diffusion = 20 -- Distance between each part, Higher means more distance, Lower means less distance
local DiffusionGoggles = 200
local DetailIncrement = 0.51 -- Lower for more detail, Higher for less detail. 0 - 10

local FogModel = Instance.new(&quot;Model&quot;, Camera)
FogModel.Name = &quot;Fog&quot;



--# Loops

local lay = Instance.new(&quot;Part&quot;)
lay.BrickColor = BrickColor.new(&quot;Black&quot;)
lay.Name = &quot;Lay&quot;
lay.Anchored = true 
lay.CanCollide = false
lay.Transparency = 0.2
lay.Size = Vector3.new(30,30,1)
lay.Parent = FogModel

--// Create the Fog Parts
for i = 0, 10, DetailIncrement do
	
	-- Part Setup
	local FogPart = Instance.new(&quot;Part&quot;, FogModel)
	FogPart.CanCollide = false
	FogPart.Anchored = true
	FogPart.formFactor = &quot;Symmetric&quot;
	FogPart.Size = Vector3.new(1, 1, 1)
	FogPart.Transparency = (10 * 0.1) - (i * 0.1)
	FogPart.BrickColor = BrickColor.new(&quot;Black&quot;)
	FogPart.Locked = true
	
	-- Mesh Setup
	local Mesh = Instance.new(&quot;SpecialMesh&quot;, FogPart)
	Mesh.MeshId = &quot;http://www.roblox.com/asset/?id=1185246&quot;
	local ScaleValue = (-i-Distance) * Diffusion
	Mesh.Scale = Vector3.new(ScaleValue, ScaleValue, ScaleValue)
	Mesh.TextureId = &quot;http://www.roblox.com/asset/?id=5733198436&quot;
	Mesh.VertexColor = Vector3.new(104/255, 105/255, 142/255)
	
	--transparency saver
	local val = Instance.new(&quot;NumberValue&quot;, FogPart)
	val.Value = FogPart.Transparency
	
	---------------------------------------------------------------------
	--same thing but for goggles lol
	--i just woke up and i am tired
	-- Part Setup
	local FogPart2 = Instance.new(&quot;Part&quot;, FogModel)
	FogPart2.CanCollide = false
	FogPart2.Anchored = true
	FogPart2.formFactor = &quot;Symmetric&quot;
	FogPart2.Size = Vector3.new(1, 1, 1)
	FogPart2.Transparency = (10 * 0.1) - (i * 0.1)
	FogPart2.BrickColor = BrickColor.new(&quot;Black&quot;)
	FogPart2.Locked = true
	FogPart2.Name = &quot;Goggles&quot;

	-- Mesh Setup
	local Mesh2 = Instance.new(&quot;SpecialMesh&quot;, FogPart2)
	Mesh2.MeshId = &quot;http://www.roblox.com/asset/?id=1185246&quot;
	local ScaleValue2 = (-i-Distance) * DiffusionGoggles
	Mesh2.Scale = Vector3.new(ScaleValue2, ScaleValue2, ScaleValue2)
	Mesh2.TextureId = &quot;http://www.roblox.com/asset/?id=5733198436&quot;
	Mesh2.VertexColor = Vector3.new(104/255, 105/255, 142/255)

	--transparency saver
	local val2 = Instance.new(&quot;NumberValue&quot;, FogPart2)
	val2.Value = FogPart2.Transparency
	
	--wait()
end


--// Set the CFrame of the Fog Parts
while wait() do
	lay.CFrame = Camera.CoordinateFrame + (Camera.CoordinateFrame.lookVector*3)
	for i, Part in pairs(FogModel:GetChildren()) do if Part ~= lay then 
		Part.CFrame = CFrame.new(Camera.CoordinateFrame.p)
	end end
end 
