									<string name="Name">Script</string>
									<ProtectedString name="Source">script.Parent.Touched:connect(function(obj)
	local plr = game.Players:GetPlayerFromCharacter(obj.Parent)
	if not plr then return end
	if plr.Character:FindFirstChild(&quot;SatPC&quot;) then return end 
	local v = Instance.new(&quot;IntValue&quot;)
	v.Name = &quot;SatPC&quot;
	v.Parent = plr.Character
	game.Debris:AddItem(v, 5)
end)</ProtectedString>
