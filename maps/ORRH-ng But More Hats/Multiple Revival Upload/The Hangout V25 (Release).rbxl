					<Item class="LocalScript" referent="RBX6055">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">LocalScript</string>
							<ProtectedString name="Source">local Players = game:GetService(&quot;Players&quot;)
local Player = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local Tool = script.Parent
local event = nil

local position = 1

function getHuman(dest)
	if not dest.Character then return end 
	--if dest == Player then return end 
	if not dest.Character:FindFirstChild(&quot;Humanoid&quot;) then return end 

	return dest.Character.Humanoid
end 

Tool.Selected:connect(function(mouse)
	event = mouse.KeyDown:connect(function(key)
		key = string.lower(key)
		local change = (key == &quot;q&quot;) and -1 or (key == &quot;e&quot; and 1 or nil)
		if not change then return end 

		position = (position +change) &lt; 1 and #Players:GetPlayers() or ((position +change) &gt; #Players:GetPlayers() and 1 or (position + change))
		--if not position then return end 

		local destination = Players:GetPlayers()[position]
		Camera.CameraSubject = getHuman(destination) or getHuman(Player)
		Camera.CameraType = &quot;Custom&quot;
	end)
end)

Tool.Deselected:connect(function()
	if event then event:disconnect() end
	Camera.CameraSubject = getHuman(Player)
	Camera.CameraType = &quot;Custom&quot;
end)</ProtectedString>
							<bool name="archivable">true</bool>
