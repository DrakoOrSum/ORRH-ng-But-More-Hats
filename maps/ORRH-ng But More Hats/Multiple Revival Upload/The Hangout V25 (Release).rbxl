						<ProtectedString name="Source">wait(0.1)

local player = script.Parent.Parent.Parent
wait(1)

active = false

selectionBox = Instance.new(&quot;SelectionBox&quot;)
selectionBox.Color = BrickColor.Red()
selectionBox.Visible = true

selectionLasso = Instance.new(&quot;SelectionPartLasso&quot;)
selectionLasso.Color = BrickColor.Black()
selectionLasso.Humanoid = player.Character.Humanoid

gui = Instance.new(&quot;ScreenGui&quot;)
text = Instance.new(&quot;TextLabel&quot;)
text.Parent = gui
text.Text = &quot;No brick selected&quot;
text.BackgroundColor3 = Color3.new(1/256*17, 1/256*17, 1/256*17)
text.BorderColor3 = Color3.new(1/256*17, 1/256*17, 1/256*17)
text.TextColor3 = Color3.new(1, 1, 1)
text.Position = UDim2.new(0, 0, 1, -20)
text.Size = UDim2.new(0, 100, 0, 20)
text.BackgroundTransparency = 0.25

function onMouseButton1Down(target)
	if target ~= nil then
		if target.Locked == false then
			if target.Anchored == true then
				target.Anchored = false
				target.Velocity = Vector3.new(0, 0, 0)
				target.RotVelocity = Vector3.new(0, 0, 0)
				selectionBox.Color = BrickColor.Red()
				text.Text = &quot;Brick isn&apos;t anchored&quot;
			else
				target.Anchored = true
				target.Velocity = Vector3.new(0, 0, 0)
				target.RotVelocity = Vector3.new(0, 0, 0)
				selectionBox.Color = BrickColor.Green()
				text.Text = &quot;Brick is anchored&quot;
			end
		end
	end
end

function onMouseMoved(target)
	if target ~= nil then
		if target.Locked == false then
			if target.Anchored == true then
				selectionBox.Adornee = target
				selectionBox.Color = BrickColor.Green()
				selectionLasso.Part = target
				text.Text = &quot;Brick is anchored&quot;
			else
				selectionBox.Adornee = target
				selectionBox.Color = BrickColor.Red()
				selectionLasso.Part = target
				text.Text = &quot;Brick isn&apos;t anchored&quot;
			end
		else
			selectionBox.Adornee = nil
			selectionLasso.Part = nil
			text.Text = &quot;Brick is locked!&quot;
		end
	else
		selectionBox.Adornee = nil
		selectionLasso.Part = nil
		text.Text = &quot;No brick selected&quot;
	end
end

--custom

local string = &quot;Anchoring...&quot;
function Display(x) -- nil = clear, true = string
	local location = script.Parent.Parent.Parent.Character -- player instance into character instance
	local model = nil
	for _,v in pairs(location:GetChildren()) do
		if v:IsA(&quot;Model&quot;) then
			model = v
			break
		end
	end 

	if not model then return end
	model.Name = x and string or (model.Name == string and &quot;&quot; or model.Name)
end 

-- end of custom

local move, down = nil, nil
function onSelected(mouse)
	Display(true) -- custom

	local messageremove = player:GetChildren()
	for i = 1,#messageremove do
		if messageremove[i].className == &quot;Message&quot; then
			messageremove[i]:Remove()
		end
	end
	
	if active == false then
		active = true
		print(&quot;ACTIVE&quot;)
		print(mouse)
		gui.Parent = player.PlayerGui
		selectionBox.Parent = player.PlayerGui
		selectionLasso.Parent = player.PlayerGui
		move = mouse.Move:connect(function() print(&quot;MOVE&quot;) onMouseMoved(mouse.Target) end)
		down = mouse.Button1Down:connect(function() print(&quot;DOWN&quot;) onMouseButton1Down(mouse.Target) end)
	end
end

function onDeselected()
	Display() -- custom

	if active == true then
		active = false
		gui.Parent = nil
		selectionBox.Parent = nil
		selectionLasso.Parent = nil
		if move and down then 
			move:disconnect()
			down:disconnect()	
		end 
	end
end

script.Parent.Selected:connect(onSelected)
script.Parent.Deselected:connect(onDeselected)
</ProtectedString>
