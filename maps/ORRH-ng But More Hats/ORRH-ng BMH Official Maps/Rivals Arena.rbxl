		<Item class="Script" referent="RBX225">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Tools</string>
				<ProtectedString name="Source">script:Destroy() script = nil
while not shared.GlobalCompatibility do wait() end shared.GlobalCompatibility()
while not SNCAI do wait() end

local tools = {}
local toolMembers = {}
local toolMt = { __index = toolMembers }

SNCAI.Tools = tools

local function getTool(char)
&#9;for i, v in ipairs(char:GetChildren()) do
&#9;&#9;if v:IsA&quot;Tool&quot; then
&#9;&#9;&#9;return v
&#9;&#9;end
&#9;end
&#9;return nil
end

function toolMembers:Select(char)
&#9;self.Tool.Parent = char
&#9;if self.Selected then Spawn(self.Selected) end
end

function toolMembers:Deselect()
&#9;self.Tool.Parent = nil
&#9;if self.Deselected then Spawn(self.Deselected) end
end

function toolMembers:Activate(targetPoint)
&#9;if targetPoint then
&#9;&#9;local humanoid = self.Tool.Parent.Humanoid
&#9;&#9;humanoid.TargetPoint = targetPoint
&#9;end
&#9;if self.Activated then Spawn(self.Activated) end
end

function toolMembers:Deactivate()
&#9;if self.Deactivated then Spawn(self.Deactivated) end
end

local function clearTags(obj)
&#9;while obj:FindFirstChild&quot;creator&quot; do
&#9;&#9;obj.creator:Remove()
&#9;end
&#9;while obj:FindFirstChild&quot;BotCreator&quot; do
&#9;&#9;obj.BotCreator:Remove()
&#9;end
end

function tools.CopyTag(from, to)
&#9;clearTags(to)
&#9;local tag = from:FindFirstChild&quot;creator&quot; or from:FindFirstChild&quot;BotCreator&quot;
&#9;local newTag
&#9;if tag then newTag = tag:Clone() newTag.Parent = to end
&#9;return newTag
end

function toolMembers:Tag(obj)
&#9;clearTags(obj)
&#9;local tag = Instance.new&quot;ObjectValue&quot;
&#9;tag.Parent = obj
&#9;local char = self.Tool.Parent
&#9;local player = game.Players:GetPlayerFromCharacter(char)
&#9;if player then
&#9;&#9;tag.Value = player
&#9;&#9;tag.Name = &quot;creator&quot;
&#9;else
&#9;&#9;tag.Value = char
&#9;&#9;tag.Name = &quot;BotCreator&quot;
&#9;end
&#9;return tag
end

local newTool
function tools.new(tool)
&#9;local toolObject = setmetatable({Tool = tool}, toolMt)
&#9;tool.Activated:connect(function() if toolObject.Activated then toolObject.Activated() end end)
&#9;tool.Deactivated:connect(function() if toolObject.Deactivated then toolObject.Deactivated() end end)
&#9;tool.Equipped:connect(function() if toolObject.Equipped then toolObject.Equipped() end end)
&#9;tool.Unequipped:connect(function() if toolObject.Unequipped then toolObject.Unequipped() end end)

&#9;local handle = tool.Handle
&#9;handle.Touched:connect(function(part)
&#9;&#9;if not tool.Parent or tool.Parent:FindFirstChild&quot;Humanoid&quot; then return end
&#9;&#9;local char = part.Parent
&#9;&#9;if not char then return end
&#9;&#9;local humanoid = char:FindFirstChild&quot;Humanoid&quot;
&#9;&#9;if humanoid and humanoid.Health &gt; 0 then
&#9;&#9;&#9;local torso = humanoid.Torso
&#9;&#9;&#9;local player = game.Players:GetPlayerFromCharacter(char)

&#9;&#9;&#9;--first check they can actually hold the tool
&#9;&#9;&#9;local rightShoulder = humanoid.Torso:FindFirstChild&quot;Right Shoulder&quot;
&#9;&#9;&#9;local rightArm = rightShoulder and rightShoulder.Part1
&#9;&#9;&#9;if rightArm then
&#9;&#9;&#9;&#9;if player then
&#9;&#9;&#9;&#9;&#9;local otherTool = getTool(char)
&#9;&#9;&#9;&#9;&#9;if otherTool then otherTool.Parent = player.Backpack end
&#9;&#9;&#9;&#9;&#9;tool.Parent = char
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;local ai = SNCAI.GetAIFromHumanoid(humanoid)
&#9;&#9;&#9;&#9;&#9;print(ai)
&#9;&#9;&#9;&#9;&#9;if not ai then return end
&#9;&#9;&#9;&#9;&#9;local pickup = ai.Pickup
&#9;&#9;&#9;&#9;&#9;if pickup and pickup(toolObject) then
&#9;&#9;&#9;&#9;&#9;&#9;toolObject:Select(char)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)

&#9;newTool = toolObject
&#9;return toolObject
end

function tools.Equip(tool, char)
&#9;tool = tool:Clone()
&#9;newTool = nil
&#9;tool.Parent = char --runs scripts in the tool
&#9;if newTool then
&#9;&#9;newTool:Select(char)
&#9;&#9;return newTool
&#9;else
&#9;&#9;error&quot;Tool is not SNCAI compatible&quot;
&#9;end
end</ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX226">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">SNCAI</string>
