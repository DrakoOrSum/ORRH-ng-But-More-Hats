		<Item class="Script" referent="RBX2">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">BotAI</string>
				<ProtectedString name="Source">script:Destroy() script = nil
while not shared.GlobalCompatibility do wait() end shared.GlobalCompatibility()
local botNumber = 0
function _G.BotAI(bot)
&#9;wait(math.random() * .5) --otherwise all AILoops update at the same time - laggy!
&#9;local botHumanoid = bot.Humanoid
&#9;local botTorso = bot.Torso
&#9;local hasFlag = bot.HasFlag
&#9;local classNum = math.random(1, #classes)
&#9;bot.Class.Value = classNum
&#9;local class = classes[classNum]
&#9;class.Spawned = class.Spawned + 1
&#9;--bot.Name = class.Name .. &quot; Bot&quot;
&#9;botNumber = botNumber + 1
&#9;bot.Name = &quot;Bot &quot;..botNumber
&#9;if botNumber == 1337 or botNumber == 9001 then
&#9;&#9;bot.Head.face.Texture = &quot;rbxassetid://42070872&quot;
&#9;end

&#9;while not botTorso:FindFirstChild&quot;Right Shoulder&quot; do wait() end

&#9;local tool = SNCAI.Tools.Equip(class.Tool, bot)

&#9;hasFlag.Changed:connect(function()
&#9;&#9;if (not hasFlag.Value) and tool.Tool:FindFirstChild&quot;Handle&quot; then
&#9;&#9;&#9;--tool.Parent = bot
&#9;&#9;&#9;tool:Select(bot)
&#9;&#9;end
&#9;end)

&#9;while not (SNCAI and SNCAI.Tools) do wait() end

&#9;local rightGrip = bot[&quot;Right Arm&quot;].RightGrip

&#9;local ai = SNCAI.new(botHumanoid)

&#9;local thisTeam, otherTeam, neutralTeam
&#9;if GameType.IsTeam then
&#9;&#9;thisTeam = bot.Team.Value
&#9;&#9;bot.Torso.BrickColor = thisTeam
&#9;&#9;local black = BrickColor.new&quot;Black&quot;
&#9;&#9;bot[&quot;Right Arm&quot;].BrickColor = black
&#9;&#9;bot[&quot;Left Arm&quot;].BrickColor = black
&#9;&#9;bot[&quot;Right Leg&quot;].BrickColor = black
&#9;&#9;bot[&quot;Left Leg&quot;].BrickColor = black
&#9;&#9;otherTeam = (thisTeam == BrickColor.Blue() and BrickColor.Red() or BrickColor.Blue())
&#9;&#9;thisTeam, otherTeam = SNCAI.GetTeam(thisTeam), SNCAI.GetTeam(otherTeam)

&#9;&#9;if GameType.OneFlag then&#9;
&#9;&#9;&#9;neutralTeam = SNCAI.GetTeam(BrickColor.Yellow())
&#9;&#9;end

&#9;&#9;thisTeam[ai] = true
&#9;end

&#9;local function distance(a,b) return (a.Position - b.Position).magnitude end

&#9;--local attacker = math.random(1,2) == 2
&#9;--if attacker then bot.Name = bot.Name..&quot; attacker&quot; end

&#9;local function getTarget()
&#9;&#9;if thisTeam then 
&#9;&#9;&#9;if GameType.IsFlag then
&#9;&#9;&#9;&#9;if hasFlag.Value then --if this bot has the flag, just charge for the flag stand
&#9;&#9;&#9;&#9;&#9;return FlagStands[thisTeam]
&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;if GameType.OneFlag then
&#9;&#9;&#9;&#9;&#9;local flag = Flags[neutralTeam]
&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;local closestEnemy = ai:GetClosestTeamMember(otherTeam)
&#9;&#9;&#9;&#9;&#9;if not flag.Parent then return closestEnemy, closestEnemy end
&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;if flag.Parent and flag.Parent:FindFirstChild&quot;Humanoid&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;local player = game.Players:GetPlayerFromCharacter(flag.Parent)
&#9;&#9;&#9;&#9;&#9;&#9;local flagHolderTeam = player and player.TeamColor or flag.Parent.Team.Value
&#9;&#9;&#9;&#9;&#9;&#9;flagHolderTeam = SNCAI.GetTeam(flagHolderTeam)
&#9;&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;&#9;if flagHolderTeam == thisTeam then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;return closestEnemy, closestEnemy
&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;return flag.Parent, flag.Parent
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;--[[if closestEnemy and distance(botTorso, closestEnemy.Torso) &lt; 30 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;return closestEnemy, closestEnemy
&#9;&#9;&#9;&#9;&#9;&#9;end]]
&#9;&#9;&#9;&#9;&#9;&#9;return flag.Handle, closestEnemy
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;--[[local closestEnemy = ai:GetClosestTeamMember(otherTeam)

&#9;&#9;&#9;&#9;&#9;local flagHolder
&#9;&#9;&#9;&#9;&#9;if Flags[thisTeam].Parent then
&#9;&#9;&#9;&#9;&#9;&#9;if Flags[thisTeam].Parent:FindFirstChild&quot;Humanoid&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;local torso = Flags[thisTeam].Parent.Torso
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if distance(torso, FlagStands[otherTeam]) &gt; distance(botTorso, FlagStands[otherTeam]) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;flagHolder = Flags[thisTeam].Parent
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;elseif Flags[thisTeam] ~= FlagStands[thisTeam].Parent and SNCAI.GetClosestTeamMemberToPart(Flags[thisTeam].Handle, thisTeam) == bot then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;return Flags[thisTeam].Handle, closestEnemy
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;if closestEnemy and distance(botTorso, closestEnemy.Torso) &lt; 30 and not (flagHolder and distance(botTorso, flagHolder.Torso) &lt; 30) then
&#9;&#9;&#9;&#9;&#9;&#9;return closestEnemy, closestEnemy
&#9;&#9;&#9;&#9;&#9;elseif flagHolder then
&#9;&#9;&#9;&#9;&#9;&#9;return flagHolder, flagHolder
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;if Flags[otherTeam].Parent and not Flags[otherTeam].Parent:FindFirstChild&quot;Humanoid&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;return Flags[otherTeam].Handle, closestEnemy
&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;return closestEnemy, closestEnemy]]

&#9;&#9;&#9;&#9;&#9;--[[local closestEnemy = ai:GetClosestTeamMember(otherTeam)

&#9;&#9;&#9;&#9;&#9;if Flags[thisTeam].Parent then
&#9;&#9;&#9;&#9;&#9;&#9;if Flags[thisTeam].Parent:FindFirstChild&quot;Humanoid&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;local flagHolder = Flags[thisTeam].Parent
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if distance(botTorso, flagHolder.Torso) &lt;= 100 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;return flagHolder, flagHolder
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;elseif Flags[thisTeam] ~= FlagStands[thisTeam].Parent and SNCAI.GetClosestTeamMemberToPart(Flags[thisTeam].Handle, thisTeam) == bot then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;return Flags[thisTeam].Handle, closestEnemy
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;if closestEnemy and distance(botTorso, closestEnemy.Torso) &lt; 30 then
&#9;&#9;&#9;&#9;&#9;&#9;return closestEnemy, closestEnemy
&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;if Flags[otherTeam].Parent and not Flags[otherTeam].Parent:FindFirstChild&quot;Humanoid&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;return Flags[otherTeam].Handle, closestEnemy
&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;return closestEnemy, closestEnemy]]

&#9;&#9;&#9;&#9;&#9;local closestEnemy = ai:GetClosestTeamMember(otherTeam)

&#9;&#9;&#9;&#9;&#9;local flagHolder
&#9;&#9;&#9;&#9;&#9;if Flags[thisTeam].Parent then
&#9;&#9;&#9;&#9;&#9;&#9;if Flags[thisTeam].Parent:FindFirstChild&quot;Humanoid&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;flagHolder = Flags[thisTeam].Parent
&#9;&#9;&#9;&#9;&#9;&#9;elseif Flags[thisTeam] ~= FlagStands[thisTeam].Parent and SNCAI.GetClosestTeamMemberToPart(Flags[thisTeam].Handle, thisTeam) == bot then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;return Flags[thisTeam].Handle, closestEnemy --retrieve this team&apos;s flag if bot is the closest to it
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;if flagHolder and distance(botTorso, flagHolder.Torso) &lt; 50 then --if close enough to the flag holder, attack always
&#9;&#9;&#9;&#9;&#9;&#9;return flagHolder, flagHolder
&#9;&#9;&#9;&#9;&#9;elseif closestEnemy and distance(botTorso, closestEnemy.Torso) &lt; 50 then --if another enemy is close, attack them
&#9;&#9;&#9;&#9;&#9;&#9;return closestEnemy, closestEnemy
&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;local otherFlag, otherFlagHolder
&#9;&#9;&#9;&#9;&#9;if Flags[otherTeam].Parent then
&#9;&#9;&#9;&#9;&#9;&#9;if Flags[otherTeam].Parent:FindFirstChild&quot;Humanoid&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;otherFlagHolder = Flags[otherTeam].Parent
&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;otherFlag = Flags[otherTeam].Handle
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;if flagHolder 
&#9;&#9;&#9;&#9;&#9;and (not otherFlag or distance(botTorso, flagHolder.Torso) &lt; distance(botTorso, otherFlag)) 
&#9;&#9;&#9;&#9;&#9;and (not otherFlagHolder or distance(botTorso, flagHolder.Torso) &lt; distance(botTorso, otherFlagHolder.Torso)) then
&#9;&#9;&#9;&#9;&#9;&#9;return flagHolder, flagHolder --if closer to the flag holder than the enemy flag, attack flag holder
&#9;&#9;&#9;&#9;&#9;elseif otherFlag then --otherwise, get the enemy flag
&#9;&#9;&#9;&#9;&#9;&#9;return otherFlag, closestEnemy
&#9;&#9;&#9;&#9;&#9;elseif otherFlagHolder then --if someone else has the flag:
&#9;&#9;&#9;&#9;&#9;&#9;if distance(botTorso, otherFlagHolder.Torso) &gt; 10 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;return otherFlagHolder, closestEnemy --escort flag holder
&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;return nil, closestEnemy
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;return closestEnemy, closestEnemy
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;elseif GameType.Hill then
&#9;&#9;&#9;&#9;local torsoPos = botTorso.Position - workspace.Hill.Position
&#9;&#9;&#9;&#9;local inHill = math.abs(torsoPos.x) &lt;= 30 and math.abs(torsoPos.z) &lt;= 30
&#9;&#9;&#9;&#9;local closestEnemy = ai:GetClosestTeamMember(otherTeam)
&#9;&#9;&#9;&#9;if inHill then 
&#9;&#9;&#9;&#9;&#9;if closestEnemy then
&#9;&#9;&#9;&#9;&#9;&#9;torsoPos = closestEnemy.Torso.Position - workspace.Hill.Position
&#9;&#9;&#9;&#9;&#9;&#9;inHill = math.abs(torsoPos.x) &lt;= 30 and math.abs(torsoPos.z) &lt;= 30
&#9;&#9;&#9;&#9;&#9;&#9;-- if enemy isn&apos;t in the hill, don&apos;t leave to get to them
&#9;&#9;&#9;&#9;&#9;&#9;return inHill and closestEnemy or nil, closestEnemy
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;return workspace.Hill, closestEnemy
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;local enemy = ai:GetClosestTeamMember(otherTeam)
&#9;&#9;&#9;&#9;return enemy, enemy
&#9;&#9;&#9;end
&#9;&#9;else 
&#9;&#9;&#9;local closest, closestDistance = nil, math.huge
&#9;&#9;&#9;for i, character in ipairs(workspace:GetChildren()) do
&#9;&#9;&#9;&#9;local humanoid, torso = character:FindFirstChild&quot;Humanoid&quot;, character:FindFirstChild&quot;Torso&quot;
&#9;&#9;&#9;&#9;if humanoid and torso and torso ~= botTorso and humanoid.Health &gt; 0 then
&#9;&#9;&#9;&#9;&#9;local distance = (botTorso.Position - torso.Position).magnitude
&#9;&#9;&#9;&#9;&#9;if distance &lt; closestDistance then&#9;
&#9;&#9;&#9;&#9;&#9;&#9;closest, closestDistance = character, distance
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;return closest, closest
&#9;&#9;end
&#9;end

&#9;if class.Ranged then
&#9;&#9;local fireTarget

&#9;&#9;function ai.Step()
&#9;&#9;&#9;fireTarget = nil
&#9;&#9;&#9;local target
&#9;&#9;&#9;target, fireTarget = getTarget()
&#9;&#9;&#9;fireTarget = fireTarget and (fireTarget:FindFirstChild&quot;Torso&quot; or fireTarget)
&#9;&#9;&#9;ai.Target = target and (target:FindFirstChild&quot;Torso&quot; or target)
&#9;&#9;end

&#9;&#9;local function okayToFire(dir)
&#9;&#9;&#9;local pos = botTorso.Position
&#9;&#9;&#9;local hit = bot
&#9;&#9;&#9;while true do
&#9;&#9;&#9;&#9;hit, pos = workspace:FindPartOnRay(Ray.new(pos, dir * 100), hit)
&#9;&#9;&#9;&#9;-- nothing or scenery?
&#9;&#9;&#9;&#9;if (not hit) or hit.Anchored then return false end
&#9;&#9;&#9;&#9;-- character?
&#9;&#9;&#9;&#9;local char = hit
&#9;&#9;&#9;&#9;repeat
&#9;&#9;&#9;&#9;&#9;char = char.Parent
&#9;&#9;&#9;&#9;until char:FindFirstChild&quot;Humanoid&quot; or char == workspace
&#9;&#9;&#9;&#9;if char ~= workspace then
&#9;&#9;&#9;&#9;&#9;-- okay if enemy
&#9;&#9;&#9;&#9;&#9;if not GameType.IsTeam then return true end
&#9;&#9;&#9;&#9;&#9;local player = game.Players:GetPlayerFromCharacter(char)
&#9;&#9;&#9;&#9;&#9;local teamColor = player and player.TeamColor or char.Team.Value
&#9;&#9;&#9;&#9;&#9;return SNCAI.GetTeam(teamColor) ~= thisTeam
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;--else assume bullet, cast again
&#9;&#9;&#9;end
&#9;&#9;end

&#9;&#9;function ai.EndStep(target, length)
&#9;&#9;&#9;--print(target, fireTarget, length)
&#9;&#9;&#9;--[[if ai.Target and ai.Target == fireTarget then
&#9;&#9;&#9;&#9;if length &gt; 2 then
&#9;&#9;&#9;&#9;&#9;fireTarget = nil
&#9;&#9;&#9;&#9;else--if length == 1 then
&#9;&#9;&#9;&#9;&#9;ai:CancelTarget()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;elseif fireTarget then
&#9;&#9;&#9;&#9;local length = #ai:GetPath(fireTarget)
&#9;&#9;&#9;&#9;if length &gt; 2 then 
&#9;&#9;&#9;&#9;&#9;fireTarget = nil 
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end]]
&#9;&#9;&#9;if fireTarget then
&#9;&#9;&#9;&#9;local vector = fireTarget.Position - botTorso.Position
&#9;&#9;&#9;&#9;local dist, dir = vector.magnitude, vector.unit
&#9;&#9;&#9;&#9;if dist &lt; 100 and okayToFire(dir) then
&#9;&#9;&#9;&#9;&#9;if dist &lt; 30 then ai:CancelTarget() end
&#9;&#9;&#9;&#9;&#9;return
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;fireTarget = nil
&#9;&#9;end

&#9;&#9;ai:Start()
&#9;&#9;
&#9;&#9;while botHumanoid.Health &gt; 0 and rightGrip.Parent do
&#9;&#9;&#9;if fireTarget then
&#9;&#9;&#9;&#9;--class.Fire(bot, botTorso, fireTarget, botHumanoid, ai)
&#9;&#9;&#9;&#9;local pos = class.CorrectHeight and bot.Head.Position + class.CorrectHeight(fireTarget.Position - bot.Head.Position) or fireTarget.Position
&#9;&#9;&#9;&#9;local acc = (pos - bot.Head.Position).magnitude / class.Acc
&#9;&#9;&#9;&#9;pos = pos + Vector3.new((math.random() - .5) * acc, (math.random() - .5) * acc, (math.random() - .5) * acc)
&#9;&#9;&#9;&#9;tool:Activate(pos)
&#9;&#9;&#9;&#9;wait(class.Reload)
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;wait(.5)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;else
&#9;&#9;class.SpecificStuff(bot, botTorso, botHumanoid, ai, getTarget, tool)
&#9;end
end</ProtectedString>
			</Properties>
