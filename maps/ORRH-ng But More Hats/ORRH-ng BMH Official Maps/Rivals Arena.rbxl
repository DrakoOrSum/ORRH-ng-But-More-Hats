		<Item class="Script" referent="RBX377">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script2</string>
				<ProtectedString name="Source">local function neighbours(waypoint)
&#9;local f, s, v = waypoint.Neighbours.Value:gmatch&quot;%w+&quot;
&#9;return function()
&#9;&#9;v = f(s, v)
&#9;&#9;if not v then return end
&#9;&#9;return workspace.Waypoints[v]
&#9;end
end

fakes = {}
setmetatable(fakes, {__index = function(t, k)
&#9;local fakeObject = Instance.new&quot;Model&quot;
&#9;local fakePart = Instance.new&quot;Part&quot;
&#9;fakePart.Name = &quot;Torso&quot;
&#9;fakePart.Parent = fakeObject
&#9;local fakeHumanoid = Instance.new&quot;Humanoid&quot;
&#9;fakeHumanoid.Parent = fakeObject
&#9;t[k] = fakeObject
&#9;return fakeObject
end})
_G.fakes = fakes

for i, currentWaypoint in ipairs(workspace.Waypoints:GetChildren()) do
&#9;fakes[currentWaypoint].Torso.Position = currentWaypoint.Value
&#9;for n in neighbours(currentWaypoint) do
&#9;&#9;local lasso = Instance.new&quot;SelectionPartLasso&quot;
&#9;&#9;lasso.Humanoid = fakes[currentWaypoint].Humanoid
&#9;&#9;lasso.Part = fakes[n].Torso
&#9;&#9;lasso.Parent = workspace
&#9;end
end
</ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX378">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<ProtectedString name="Source">local function neighbours(waypoint)
&#9;local f, s, v = waypoint.Neighbours.Value:gmatch&quot;%w+&quot;
&#9;return function()
&#9;&#9;v = f(s, v)
&#9;&#9;if not v then return end
&#9;&#9;return workspace.Waypoints[v]
&#9;end
end

fakes = {}
_G.fakes = fakes

for i, currentWaypoint in ipairs(workspace.Waypoints:GetChildren()) do
&#9;fakeObject = Instance.new&quot;Model&quot;
&#9;fakes[i] = fakeObject
&#9;local fakePart = Instance.new&quot;Part&quot;
&#9;fakePart.Name = &quot;Torso&quot;
&#9;fakePart.CFrame = currentWaypoint.CFrame
&#9;fakePart.Parent = fakeObject
&#9;local fakeHumanoid = Instance.new&quot;Humanoid&quot;
&#9;fakeHumanoid.Parent = fakeObject
&#9;for n in neighbours(currentWaypoint) do
&#9;&#9;local lasso = Instance.new&quot;SelectionPartLasso&quot;
&#9;&#9;lasso.Humanoid = fakeHumanoid
&#9;&#9;lasso.Part = n
&#9;&#9;lasso.Parent = workspace
&#9;end
end
</ProtectedString>
			</Properties>
		</Item>
