			<Item class="Script" referent="RBX343">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">function weldy()
weld = Instance.new(&quot;Weld&quot;)
weld.Parent = script.Parent.Handle
weld.Part0 = weld.Parent
weld.Part1 = script.Parent.Brick1

weld2 = Instance.new(&quot;Weld&quot;)
weld2.Parent = script.Parent.Handle
weld2.Part0 = weld.Parent
weld2.Part1 = script.Parent.Brick2
weld2.C0 = CFrame.new(0,-0.6,-0.2,1,0,0,0,1,0,0,0,1)

weld7 = Instance.new(&quot;Weld&quot;)
weld7.Parent = script.Parent.Handle
weld7.Part0 = weld.Parent
weld7.Part1 = script.Parent.Brick7
weld7.C0 = CFrame.new(0,-3,-0.2,1,0,0,0,1,0,0,0,1)

weld3 = Instance.new(&quot;Weld&quot;)
weld3.Parent = script.Parent.Handle
weld3.Part0 = weld.Parent
weld3.Part1 = script.Parent.Brick3
weld3.C0 = CFrame.new(0,0.6,-0.2,1,0,0,0,1,0,0,0,1)

weld4 = Instance.new(&quot;Weld&quot;)
weld4.Parent = script.Parent.Handle
weld4.Part0 = weld.Parent
weld4.Part1 = script.Parent.Brick4
weld4.C0 = CFrame.new(0,0.3,0.7,1,0,0,0,1,0,0,0,1)

weld5 = Instance.new(&quot;Weld&quot;)
weld5.Parent = script.Parent.Handle
weld5.Part0 = weld.Parent
weld5.Part1 = script.Parent.Brick5
weld5.C0 = CFrame.new(0,-0.5,-0,1,0,0,0,1,0,0,0,1)

weld6 = Instance.new(&quot;Weld&quot;)
weld6.Parent = script.Parent.Handle
weld6.Part0 = weld.Parent
weld6.Part1 = script.Parent.Brick6
weld6.C0 = CFrame.new(0,-1.6,-0.3,1,0,0,0,1,0,0,0,1)
end



script.Parent.Changed:connect(weldy)</ProtectedString>
				</Properties>
			</Item>
