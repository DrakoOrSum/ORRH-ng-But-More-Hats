						<R20>0</R20>
						<R21>0</R21>
						<R22>1</R22>
					</CoordinateFrame>
					<string name="Name">Plane</string>
					<Ref name="PrimaryPart">RBX422</Ref>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="IntValue" referent="RBX426">
					<Properties>
						<string name="Name">PlaneCheck</string>
						<int name="Value">0</int>
