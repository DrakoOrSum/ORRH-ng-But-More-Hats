			<Item class="Script" referent="RBX424">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">system = script.Parent&#13;&#10;model = system.Plane&#13;&#10;backup = model:Clone()&#13;&#10;regen = system.Regen&#13;&#10;&#13;&#10;function checkRegen()&#13;&#10;&#9;if regen.Value == 1 then&#13;&#10;&#9;&#9;model = backup:Clone()&#13;&#10;&#9;&#9;model.Parent = system&#13;&#10;&#9;&#9;model:MakeJoints()&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;regen.Changed:connect(checkRegen)</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Model" referent="RBX425">
				<Properties>
					<token name="Controller">0</token>
					<bool name="ControllerFlagShown">true</bool>
					<CoordinateFrame name="ModelInPrimary">
						<X>0</X>
						<Y>0</Y>
