			<Item class="LocalScript" referent="RBX92">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">AnimateScript</string>
					<ProtectedString name="Source">local function WaitForChild(parent, childName)
&#9;while parent:FindFirstChild(childName) == nil do 
&#9;&#9;wait()
&#9;end 
&#9;return parent[childName]
end 

local Player = Game.Players.LocalPlayer 
local Character
local Torso
local Humanoid 

local Tool = script.Parent 
local Sword = Tool.Handle 

local PurgeAnim
local ConsumeAnim 

local PurgeSound 
local ConsumeSound 

local DebrisService = Game:GetService(&apos;Debris&apos;)

local Gui = Instance.new(&apos;ScreenGui&apos;)

local RbxGui = LoadLibrary(&apos;RbxGui&apos;)

local function CreateHelpText()
&#9;if Gui.Parent then return end 
&#9;Gui = Instance.new(&apos;ScreenGui&apos;)
&#9;Gui.Parent = WaitForChild(Player, &apos;PlayerGui&apos;)

&#9;local sText = Instance.new(&apos;TextLabel&apos;)
&#9;sText.Parent = Gui 
&#9;sText.Text = &quot;You need souls to unleash the soul blast. Click Q to equip your sword with soul fire and frag enemies to collect upto 5 souls and unleash soul blast.&quot;
&#9;sText.FontSize = Enum.FontSize.Size18
&#9;sText.Font = Enum.Font.ArialBold 
&#9;sText.BackgroundTransparency = 1.0 
&#9;sText.Size = UDim2.new(0, 500, 0, 100)
&#9;sText.TextWrapped = true 
&#9;sText.Position = UDim2.new(0.5, -200, 0, -100)
&#9;sText.TextColor3 = Color3.new(1, 0, 0)
&#9;sText.TextStrokeColor3 = Color3.new(1, 1, 1)
&#9;sText.TextStrokeTransparency = 0.5

&#9;sText:TweenPosition(UDim2.new(0.5, -250, 0, 70), 1, 1, 1, true)

&#9;wait(7.5)
&#9;Gui:ClearAllChildren()
&#9;Gui.Parent = nil
end 

local function OnEquipped(mouse)
&#9;Character = Tool.Parent 
&#9;Torso = WaitForChild(Character, &apos;Torso&apos;)
&#9;Humanoid = WaitForChild(Character, &apos;Humanoid&apos;)

&#9;PurgeSound = WaitForChild(Sword, &apos;PurgeSound&apos;)
&#9;ConsumeSound = WaitForChild(Sword, &apos;ConsumeSound&apos;)
&#9;if mouse then 
&#9;&#9;mouse.KeyDown:connect(function (key)
&#9;&#9;&#9;key = key:lower() 
&#9;&#9;&#9;if key == &apos;e&apos; then &#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;local soulConsume = WaitForChild(Tool, &apos;Consume&apos;)
&#9;&#9;&#9;&#9;if soulConsume.Value == false then 
&#9;&#9;&#9;&#9;&#9;ConsumeAnim = Humanoid:LoadAnimation(Tool.ConsumeAnim)
&#9;&#9;&#9;&#9;&#9;--ConsumeAnim:Play() 
&#9;&#9;&#9;&#9;&#9;if ConsumeSound then ConsumeSound:Play() end 
&#9;&#9;&#9;&#9;&#9;soulConsume.Value = true 
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;&#9;return 
&#9;&#9;&#9;elseif key == &apos;x&apos; then 
&#9;&#9;&#9;&#9;local purge = WaitForChild(Tool, &apos;Purge&apos;)
&#9;&#9;&#9;&#9;if purge.Value == false then 
&#9;&#9;&#9;&#9;&#9;local souls = Character:FindFirstChild(&apos;Souls&apos;)
&#9;&#9;&#9;&#9;&#9;if souls and #souls:GetChildren() == 0 then 
&#9;&#9;&#9;&#9;&#9;&#9;Spawn(function() CreateHelpText()  end)
&#9;&#9;&#9;&#9;&#9;&#9;return 
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;PurgeAnim = Humanoid:LoadAnimation(Tool.PurgeAnim)
&#9;&#9;&#9;&#9;&#9;PurgeAnim:Play() 
&#9;&#9;&#9;&#9;&#9;if PurgeSound then PurgeSound:Play() end 
&#9;&#9;&#9;&#9;&#9;purge.Value = true 
&#9;&#9;&#9;&#9;end &#9;
&#9;&#9;&#9;elseif key == &apos;q&apos; then 
&#9;&#9;&#9;&#9;local decimate = WaitForChild(Tool, &apos;Decimate&apos;)
&#9;&#9;&#9;&#9;if decimate.Value == false then 
&#9;&#9;&#9;&#9;&#9;decimate.Value = true 
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;end 
&#9;&#9;end)
&#9;end 
end

local function OnUnequipped()
&#9;if PurgeAnim then PurgeAnim:Stop() end 
&#9;if ConsumeAnim then ConsumeAnim:Stop() end 

&#9;if PurgeSound then PurgeSound:Stop() end 
&#9;if ConsumeSound then ConsumeSound:Stop() end 

&#9;if Gui then Gui.Parent = nil end 
end 

Tool.Equipped:connect(OnEquipped)
Tool.Unequipped:connect(OnUnequipped)</ProtectedString>
