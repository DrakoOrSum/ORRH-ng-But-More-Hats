					<ProtectedString name="Source">--Made by Stickmasterluke
--Surrounds you with serendipity


sp=script.Parent


local sound=Instance.new(&quot;Sound&quot;)
sound.SoundId=&quot;http://www.roblox.com/asset/?id=98332255&quot;
sound.Parent=sp
